<ContentView
	x:Class="DDjourneys.Controls.JourneyCard"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	x:DataType="support:JourneyCardModel">

	<Border SemanticProperties.Description="{Binding AccessibilityText}" StyleClass="Card" support:Motion.Enter="None">
		<VerticalStackLayout Spacing="{DynamicResource SpaceM}">

			<!--  Times  -->
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource SpaceM}">

				<VerticalStackLayout Grid.Column="0" Spacing="2">
					<Label StyleClass="Time" Text="{Binding DepartureTime}" />
					<Label
						IsVisible="{Binding HasDepartureDelay}"
						StyleClass="Delay"
						Text="{Binding DepartureDelay}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					Grid.Column="1"
					Margin="0,4,0,0"
					Spacing="4"
					VerticalOptions="Start">
					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{Binding DurationText}" />
					<BoxView
						CornerRadius="1"
						HeightRequest="2"
						Color="{DynamicResource Outline}" />
					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{Binding TransfersText}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					Grid.Column="2"
					HorizontalOptions="End"
					Spacing="2">
					<Label
						HorizontalTextAlignment="End"
						StyleClass="Time"
						Text="{Binding ArrivalTime}" />
					<Label
						HorizontalTextAlignment="End"
						IsVisible="{Binding HasArrivalDelay}"
						StyleClass="Delay"
						Text="{Binding ArrivalDelay}" />
				</VerticalStackLayout>

			</Grid>

			<!--  Where from / where to  -->
			<Grid
				ColumnDefinitions="*,*"
				ColumnSpacing="{DynamicResource SpaceM}"
				IsVisible="{Binding ShowEndpoints}">
				<controls:StopNameView
					Compact="True"
					Place="{Binding FromPlace}"
					Stop="{Binding FromName}" />
				<controls:StopNameView
					Grid.Column="1"
					Alignment="End"
					Compact="True"
					Place="{Binding ToPlace}"
					Stop="{Binding ToName}" />
			</Grid>

			<!--  Legs  -->
			<FlexLayout BindableLayout.ItemsSource="{Binding Chips}" Wrap="Wrap">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="support:LegChip">
						<Border
							Margin="0,0,6,6"
							BackgroundColor="{Binding Look.Fill}"
							FlexLayout.Shrink="0"
							StrokeDashArray="{Binding Look.Dashes}"
							StrokeShape="{Binding Look.Shape}"
							StrokeThickness="{Binding Look.StrokeThickness}"
							StyleClass="Chip"
							Stroke="{Binding Look.Stroke}">
							<support:PillScroll>
								<Label
									FontFamily="{DynamicResource FontSemibold}"
									FontSize="{StaticResource FontCaption}"
									StyleClass="ChipLabel"
									Text="{Binding Text}"
									TextColor="{Binding Look.Text}" />
							</support:PillScroll>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</FlexLayout>

			<!--  Cannot take place: own row, so a long reason can wrap  -->
			<Label
				IsVisible="{Binding IsCancelled}"
				LineBreakMode="WordWrap"
				StyleClass="Cancelled"
				Text="{Binding BlockText}" />

			<!--  State  -->
			<HorizontalStackLayout IsVisible="{Binding HasStatusRow}" Spacing="{DynamicResource SpaceM}">
				<Label IsVisible="{Binding IsOnTime}" StyleClass="OnTime">
					<Label.Text>
						<localization:Tr Key="Journey.OnTime" />
					</Label.Text>
				</Label>
				<Label
					IsVisible="{Binding HasNotices}"
					StyleClass="Caption"
					Text="{Binding NoticesText}" />
			</HorizontalStackLayout>

		</VerticalStackLayout>
	</Border>

</ContentView>