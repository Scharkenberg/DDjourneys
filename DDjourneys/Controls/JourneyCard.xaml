<ContentView
	x:Class="DDjourneys.Controls.JourneyCard"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	x:DataType="support:JourneyCardModel">

	<Border SemanticProperties.Description="{Binding AccessibilityText}" StyleClass="Card" support:Motion.Enter="None">
		<VerticalStackLayout Spacing="{DynamicResource SpaceM}">

			<!--  Times  -->
			<Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="{DynamicResource SpaceM}">

				<VerticalStackLayout Grid.Column="0" Spacing="2">
					<Label StyleClass="Time" Text="{Binding DepartureTime}" />
					<controls:StopNameView
						x:Name="FromStop"
						Compact="True"
						SingleLine="True"
						IsVisible="{Binding ShowEndpoints}"
						Place="{Binding FromPlace}"
						Stop="{Binding FromName}" />
					<Label
						IsVisible="{Binding HasDepartureDelay}"
						StyleClass="Delay"
						Text="{Binding DepartureDelay}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					Grid.Column="1"
					Margin="0,4,0,0"
					Spacing="4"
					VerticalOptions="Start">
					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{Binding DurationText}" />
					<BoxView
						CornerRadius="1"
						HeightRequest="2"
						Color="{DynamicResource Outline}" />
					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{Binding TransfersText}" />
					<!--  Price: a soft pill (not tappable)  -->
					<Border
						Padding="10,2"
						BackgroundColor="{DynamicResource AccentSoft}"
						HorizontalOptions="Center"
						IsVisible="{Binding HasPrice}"
						StrokeShape="RoundRectangle 100"
						StrokeThickness="0">
						<HorizontalStackLayout Spacing="6">
							<controls:Icon
								Glyph="Ticket"
								Size="14"
								VerticalOptions="Center"
								Color="{DynamicResource Accent}" />
							<Label
								FontFamily="{DynamicResource FontSemibold}"
								FontSize="{StaticResource FontCaption}"
								Text="{Binding PriceText}"
								TextColor="{DynamicResource Accent}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
					</Border>
				</VerticalStackLayout>

				<VerticalStackLayout
					Grid.Column="2"
					HorizontalOptions="End"
					Spacing="2">
					<Label
						HorizontalTextAlignment="End"
						StyleClass="Time"
						Text="{Binding ArrivalTime}" />
					<controls:StopNameView
						x:Name="ToStop"
						Alignment="End"
						SingleLine="True"
						Compact="True"
						IsVisible="{Binding ShowEndpoints}"
						Place="{Binding ToPlace}"
						Stop="{Binding ToName}" />
					<Label
						HorizontalTextAlignment="End"
						IsVisible="{Binding HasArrivalDelay}"
						StyleClass="Delay"
						Text="{Binding ArrivalDelay}" />
				</VerticalStackLayout>

			</Grid>

			<!--  Legs: one line, centered, and swipeable when it is too long for the card; the actions sit beside it  -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SpaceS}">

				<ScrollView
					HorizontalScrollBarVisibility="Never"
					Orientation="Horizontal"
					VerticalOptions="Center">
					<HorizontalStackLayout
						BindableLayout.ItemsSource="{Binding Chips}"
						Spacing="6"
						VerticalOptions="Center">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:LegChip">
								<Border
									BackgroundColor="{Binding Look.Fill}"
									StrokeDashArray="{Binding Look.Dashes}"
									StrokeShape="{Binding Look.Shape}"
									StrokeThickness="{Binding Look.StrokeThickness}"
									StyleClass="Chip"
									Stroke="{Binding Look.Stroke}"
									VerticalOptions="Center">
									<Label
										FontFamily="{DynamicResource FontSemibold}"
										FontSize="{StaticResource FontCaption}"
										LineBreakMode="NoWrap"
										StyleClass="ChipLabel"
										Text="{Binding Text}"
										TextColor="{Binding Look.Text}" />
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
				</ScrollView>

				<!--  Actions, vertically centered with the legs: notices (a badge, not a line), PDF, hand-over, follow, pause, map  -->
				<HorizontalStackLayout
					Grid.Column="1"
					HorizontalOptions="End"
					Spacing="0"
					VerticalOptions="Center">

					<Border
						Padding="6,3"
						Margin="0,0,4,0"
						BackgroundColor="{DynamicResource Raised}"
						IsVisible="{Binding HasNotices}"
						SemanticProperties.Description="{Binding NoticesText}"
						StrokeShape="RoundRectangle 100"
						StrokeThickness="0"
						VerticalOptions="Center"
						support:Motion.Feedback="True">
						<HorizontalStackLayout Spacing="3">
							<controls:Icon
								Glyph="Warning"
								Size="14"
								VerticalOptions="Center"
								Color="{DynamicResource InkMuted}" />
							<Label
								FontFamily="{DynamicResource FontSemibold}"
								FontSize="{StaticResource FontCaption}"
								Text="{Binding NoticeCount}"
								TextColor="{DynamicResource InkMuted}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding Actions.NoticesCommand}" />
						</Border.GestureRecognizers>
					</Border>

					<controls:IconButton
						Command="{Binding Actions.PdfCommand}"
						Glyph="Document"
						IsVisible="{Binding Actions.HasPdf}"
						SemanticProperties.Description="{Binding Actions.PdfDescription}"
						TargetSize="{StaticResource HitIconTight}" />

					<controls:IconButton
						Command="{Binding Actions.HandOffCommand}"
						Glyph="External"
						IsVisible="{Binding Actions.HasHandOff}"
						SemanticProperties.Description="{Binding Actions.HandOffDescription}"
						TargetSize="{StaticResource HitIconTight}" />

					<controls:IconButton
						Command="{Binding Actions.PauseCommand}"
						Glyph="{Binding Actions.PauseGlyph}"
						IsVisible="{Binding Actions.ShowPause}"
						SemanticProperties.Description="{Binding Actions.PauseDescription}"
						TargetSize="{StaticResource HitIconTight}" />

					<controls:IconButton
						Command="{Binding Actions.FollowCommand}"
						Glyph="{Binding Actions.FollowGlyph}"
						IsVisible="{Binding Actions.CanFollow}"
						SemanticProperties.Description="{Binding Actions.FollowDescription}"
						TargetSize="{StaticResource HitIconTight}" />

					<controls:IconButton
						Command="{Binding MapCommand}"
						Glyph="Map"
						IsVisible="{Binding HasMap}"
						SemanticProperties.Description="{localization:Tr Extras.MapShow}"
						TargetSize="{StaticResource HitIconTight}" />
				</HorizontalStackLayout>

			</Grid>

					<!--  Cannot take place: own row, so a long reason can wrap  -->
					<Label
						IsVisible="{Binding IsCancelled}"
						LineBreakMode="WordWrap"
						StyleClass="Cancelled"
						Text="{Binding BlockText}" />

			<!--  State  -->
			<HorizontalStackLayout IsVisible="{Binding HasStatusRow}" Spacing="{DynamicResource SpaceM}">
				<Label IsVisible="{Binding IsOnTime}" StyleClass="OnTime">
					<Label.Text>
						<localization:Tr Key="Journey.OnTime" />
					</Label.Text>
				</Label>
			</HorizontalStackLayout>

				</VerticalStackLayout>

				<controls:IconButton
					Grid.Column="1"
					Command="{Binding MapCommand}"
					Glyph="Map"
					HorizontalOptions="End"
					IsVisible="{Binding HasMap}"
					SemanticProperties.Description="{localization:Tr Extras.MapShow}"
					VerticalOptions="End" />

			</Grid>

		</VerticalStackLayout>
	</Border>

</ContentView>