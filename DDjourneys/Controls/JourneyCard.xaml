<ContentView
	x:Class="DDjourneys.Controls.JourneyCard"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:support="clr-namespace:DDjourneys.Support"
	x:DataType="support:JourneyCardModel">

	<Border SemanticProperties.Description="{Binding AccessibilityText}" StyleClass="Card">
		<VerticalStackLayout Spacing="{StaticResource SpaceM}">

			<!--  Times  -->
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceM}">

				<VerticalStackLayout Grid.Column="0" Spacing="2">
					<Label StyleClass="Time" Text="{Binding DepartureTime}" />
					<Label
						IsVisible="{Binding HasDepartureDelay}"
						StyleClass="Delay"
						Text="{Binding DepartureDelay}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					Grid.Column="1"
					Margin="0,4,0,0"
					Spacing="4"
					VerticalOptions="Start">
					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{Binding DurationText}" />
					<BoxView
						CornerRadius="1"
						HeightRequest="2"
						Color="{DynamicResource Outline}" />
					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{Binding TransfersText}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					Grid.Column="2"
					HorizontalOptions="End"
					Spacing="2">
					<Label
						HorizontalTextAlignment="End"
						StyleClass="Time"
						Text="{Binding ArrivalTime}" />
					<Label
						HorizontalTextAlignment="End"
						IsVisible="{Binding HasArrivalDelay}"
						StyleClass="Delay"
						Text="{Binding ArrivalDelay}" />
				</VerticalStackLayout>

			</Grid>

			<!--  Legs. Pills are fine here: they are not interactive.  -->
			<FlexLayout BindableLayout.ItemsSource="{Binding Chips}" Wrap="Wrap">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="support:LegChip">
						<Border
							Margin="0,0,6,6"
							BackgroundColor="{Binding Color}"
							StyleClass="Chip">
							<Label
								FontFamily="OpenSansSemibold"
								FontSize="13"
								Text="{Binding Text}"
								TextColor="White" />
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</FlexLayout>

			<!--  State  -->
			<HorizontalStackLayout IsVisible="{Binding HasStatusRow}" Spacing="{StaticResource SpaceM}">
				<Label
					IsVisible="{Binding IsCancelled}"
					StyleClass="Cancelled"
					Text="Cancelled" />
				<Label
					IsVisible="{Binding IsOnTime}"
					StyleClass="OnTime"
					Text="On time" />
				<Label
					IsVisible="{Binding HasNotices}"
					StyleClass="Caption"
					Text="{Binding NoticesText}" />
			</HorizontalStackLayout>

		</VerticalStackLayout>
	</Border>

</ContentView>
