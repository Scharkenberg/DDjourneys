<ContentPage
	x:Class="DDjourneys.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="12">

			<Label
				FontAttributes="Bold"
				FontSize="28"
				Text="DDjourneys" />


			<HorizontalStackLayout Spacing="8">

				<Entry
					x:Name="FromEntry"
					HorizontalOptions="FillAndExpand"
					Placeholder="From" />

				<Entry
					x:Name="ToEntry"
					HorizontalOptions="FillAndExpand"
					Placeholder="To" />

			</HorizontalStackLayout>


			<Button Clicked="SearchClicked" Text="Search" />


			<ActivityIndicator
				x:Name="LoadingIndicator"
				IsRunning="False"
				IsVisible="False" />


			<CollectionView x:Name="JourneyList">

				<CollectionView.ItemTemplate>

					<DataTemplate>

						<Border Margin="0,4" Padding="12">

							<VerticalStackLayout>

								<Label FontAttributes="Bold" Text="{Binding Departure}" />

								<Label Text="{Binding Arrival}" />

								<Label Text="{Binding Duration}" />

								<Label Text="{Binding TransferCount, StringFormat='Transfers: {0}'}" />

							</VerticalStackLayout>

						</Border>

					</DataTemplate>

				</CollectionView.ItemTemplate>

			</CollectionView>

		</VerticalStackLayout>

	</ScrollView>

</ContentPage>