<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns:support="clr-namespace:DDjourneys.Support"
	x:Class="DDjourneys.Pages.AppearancePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr Settings.AppearanceTitle}"
	x:DataType="local:AppearanceViewModel">

	<ContentPage.Resources>
		<DataTemplate x:Key="ChoiceRow" x:DataType="local:AppearanceChoice">
			<VerticalStackLayout>
				<Grid support:Motion.Feedback="True"
					support:Dense.Padding="12,8"
					ColumnDefinitions="*,Auto"
					ColumnSpacing="12"
					support:Dense.MinHeight="{StaticResource HitRow}"
					SemanticProperties.Description="{Binding Title}">

					<VerticalStackLayout Spacing="1" VerticalOptions="Center">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
						<Label StyleClass="Caption" Text="{Binding Description}" />
					</VerticalStackLayout>

					<controls:Icon
						Grid.Column="1"
						Glyph="Check"
						IsVisible="{Binding IsSelected}"
						Size="20"
						VerticalOptions="Center"
						Color="{DynamicResource Accent}" />

					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding Select}" CommandParameter="{Binding Id}" />
					</Grid.GestureRecognizers>
				</Grid>

				<BoxView IsVisible="{Binding ShowDivider}" StyleClass="Divider" />
			</VerticalStackLayout>
		</DataTemplate>

		<DataTemplate x:Key="SwatchRow" x:DataType="local:AppearanceChoice">
			<VerticalStackLayout>
				<Grid support:Motion.Feedback="True"
					support:Dense.Padding="12,8"
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="12"
					support:Dense.MinHeight="{StaticResource HitRow}"
					SemanticProperties.Description="{Binding Title}">

					<!--  Swatch: background, raised panel, accent and ink bars (for the mode currently in effect)  -->
					<Border
						Padding="4"
						BackgroundColor="{Binding Bg}"
						HeightRequest="32"
						Stroke="{Binding Outline}"
						StrokeShape="RoundRectangle 4"
						StrokeThickness="1"
						VerticalOptions="Center"
						WidthRequest="48">
						<Grid ColumnDefinitions="*,*" ColumnSpacing="3">
							<BoxView CornerRadius="2" Color="{Binding Raised}" />
							<VerticalStackLayout
								Grid.Column="1"
								Spacing="3"
								VerticalOptions="Center">
								<BoxView
									CornerRadius="2"
									HeightRequest="6"
									Color="{Binding Accent}" />
								<BoxView
									CornerRadius="2"
									HeightRequest="4"
									Color="{Binding Ink}" />
							</VerticalStackLayout>
						</Grid>
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="1"
						VerticalOptions="Center">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
						<Label StyleClass="Caption" Text="{Binding Description}" />
					</VerticalStackLayout>

					<controls:Icon
						Grid.Column="2"
						Glyph="Check"
						IsVisible="{Binding IsSelected}"
						Size="20"
						VerticalOptions="Center"
						Color="{DynamicResource Accent}" />

					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding Select}" CommandParameter="{Binding Id}" />
					</Grid.GestureRecognizers>
				</Grid>

				<BoxView IsVisible="{Binding ShowDivider}" StyleClass="Divider" />
			</VerticalStackLayout>
		</DataTemplate>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceS}">

			<Label StyleClass="Section" Text="{localization:Tr Settings.ModeHeader}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Modes}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

			<Border Padding="0" StyleClass="Card">
				<Grid
					support:Dense.Padding="12,8"
					ColumnDefinitions="*,Auto"
					ColumnSpacing="12"
					support:Dense.MinHeight="{StaticResource HitRow}">

					<VerticalStackLayout Spacing="1" VerticalOptions="Center">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.PureBlack}" />
						<Label StyleClass="Caption" Text="{localization:Tr Settings.PureBlackDescription}" />
					</VerticalStackLayout>

					<Switch
						Grid.Column="1"
						IsToggled="{Binding PureBlack}"
						SemanticProperties.Description="{localization:Tr Settings.PureBlack}"
						VerticalOptions="Center" />
				</Grid>
			</Border>

			<Label
				Margin="{DynamicResource SectionGap}"
				StyleClass="Section"
				Text="{localization:Tr Settings.ColorsHeader}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Colors}" BindableLayout.ItemTemplate="{StaticResource SwatchRow}" />
			</Border>

			<Label
				Margin="{DynamicResource SectionGap}"
				StyleClass="Section"
				Text="{localization:Tr Settings.FontHeader}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Fonts}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

			<Label
				Margin="{DynamicResource SectionGap}"
				StyleClass="Section"
				Text="{localization:Tr Settings.DensityHeader}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Densities}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

						<Label
				Margin="{DynamicResource SectionGap}"
				StyleClass="Section"
				Text="{localization:Tr Settings.TextSizeHeader}" />

			<!--  B11: the app's own text size - the type-scale tokens, scaled live  -->
			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding TextSizes}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

			<Label
				Margin="{DynamicResource SectionGap}"
				StyleClass="Section"
				Text="{localization:Tr Settings.LineColoursHeader}" />

			<!--  B11: the line colours of the transport modes - the standard set, or one that stays distinct for a kind of colour vision  -->
			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding LineColours}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<Grid
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12"
						support:Dense.MinHeight="{StaticResource HitRow}">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.PresetLargeSimple}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.PresetLargeSimpleDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding LargeSimple}"
							SemanticProperties.Description="{localization:Tr Settings.PresetLargeSimple}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12"
						support:Dense.MinHeight="{StaticResource HitRow}">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.SimpleCards}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.SimpleCardsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding SimpleCards}"
							SemanticProperties.Description="{localization:Tr Settings.SimpleCards}"
							VerticalOptions="Center" />
					</Grid>
				</VerticalStackLayout>
			</Border>

<Label
				Margin="{DynamicResource SectionGap}"
				IsVisible="{x:Static support:Material.Available}"
				StyleClass="Section"
				Text="{localization:Tr Settings.MaterialHeader}" />

			<Border
				Padding="0"
				IsVisible="{x:Static support:Material.Available}"
				StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Materials}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

			<Label
				Margin="{DynamicResource SectionGap}"
				IsVisible="{x:Static support:Material.Available}"
				StyleClass="Section"
				Text="{localization:Tr Settings.SurfacesHeader}" />

			<Border
				Padding="0"
				IsVisible="{x:Static support:Material.Available}"
				StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding MaterialSurfaces}" BindableLayout.ItemTemplate="{StaticResource ChoiceRow}" />
			</Border>

			<Label
				IsVisible="{x:Static support:Material.Available}"
				Margin="4,0,0,0"
				StyleClass="Caption"
				Text="{localization:Tr Settings.MaterialNote}" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
