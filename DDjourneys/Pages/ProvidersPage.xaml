<ContentPage
	x:Class="DDjourneys.Pages.ProvidersPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Provider.Title}"
	x:DataType="local:ProvidersViewModel">

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceS}">

			<Label StyleClass="Caption" Text="{localization:Tr Provider.Intro}" />

			<VerticalStackLayout BindableLayout.ItemsSource="{Binding Groups}" Spacing="{DynamicResource SpaceS}">

				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="local:ProviderGroup">

						<VerticalStackLayout Spacing="{DynamicResource SpaceS}">

							<Label
								Margin="0,8,0,0"
								SemanticProperties.HeadingLevel="Level2"
								StyleClass="Section"
								Text="{Binding Region}" />

							<Border Padding="0" StyleClass="Card">
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">

									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="local:ProviderRow">

											<VerticalStackLayout>

												<BoxView IsVisible="{Binding HasDivider}" StyleClass="Divider" />

												<!--  The header toggles the details; choosing is the button inside them  -->
												<Grid
													support:Dense.MinHeight="{StaticResource HitRow}"
													support:Dense.Padding="12,8"
													support:Motion.Feedback="True"
													ColumnDefinitions="*,Auto,Auto"
													ColumnSpacing="10"
													SemanticProperties.Description="{Binding Description}">

													<VerticalStackLayout Spacing="2" VerticalOptions="Center">

														<Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
															<Label
																FontFamily="{DynamicResource FontSemibold}"
																FontSize="{StaticResource FontSubtitle}"
																Text="{Binding Name}"
																VerticalOptions="Center" />

															<!--  Informative, not tappable: pill-shaped  -->
															<Border
																Grid.Column="1"
																IsVisible="{Binding IsExperimental}"
																StyleClass="Chip"
																VerticalOptions="Center">
																<Label
																	StyleClass="Faint"
																	Text="{localization:Tr Provider.Experimental}"
																	VerticalOptions="Center" />
															</Border>
														</Grid>

														<Label StyleClass="Caption" Text="{Binding FullName}" />
													</VerticalStackLayout>

													<controls:Icon
														Grid.Column="1"
														Glyph="Check"
														IsVisible="{Binding IsSelected}"
														Size="20"
														VerticalOptions="Center"
														Color="{DynamicResource Accent}" />

													<controls:Icon
														Grid.Column="2"
														support:Motion.Turn="{Binding ChevronRotation}"
														Glyph="ChevronDown"
														Size="20"
														VerticalOptions="Center"
														Color="{DynamicResource InkMuted}" />

													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding ToggleCommand}" />
													</Grid.GestureRecognizers>
												</Grid>

												<VerticalStackLayout
													support:Dense.Padding="12,0,12,12"
													IsVisible="{Binding IsExpanded}"
													Spacing="8">

													<Label StyleClass="Faint" Text="{Binding Coverage}" />

													<!--  What it supports: informative, not tappable, so pill-shaped chips are fine  -->
													<FlexLayout
														AlignContent="Start"
														AlignItems="Start"
														BindableLayout.ItemsSource="{Binding Capabilities}"
														Wrap="Wrap">

														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="x:String">
																<Border
																	Margin="0,0,6,6"
																	FlexLayout.Shrink="0"
																	StyleClass="Chip">
																	<support:PillScroll>
																		<Label StyleClass="Faint" Text="{Binding .}" />
																	</support:PillScroll>
																</Border>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</FlexLayout>

													<Button
														Command="{Binding SelectCommand}"
														HorizontalOptions="Start"
														IsVisible="{Binding IsNotSelected}"
														StyleClass="Tonal"
														Text="{Binding UseText}" />

													<Label
														FontFamily="{DynamicResource FontSemibold}"
														FontSize="{StaticResource FontCaption}"
														IsVisible="{Binding IsSelected}"
														Text="{Binding InUseText}"
														TextColor="{DynamicResource Accent}" />
												</VerticalStackLayout>
											</VerticalStackLayout>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>

			<Label
				Margin="0,8"
				HorizontalOptions="Center"
				StyleClass="Caption"
				Text="{localization:Tr Provider.Footer}" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
