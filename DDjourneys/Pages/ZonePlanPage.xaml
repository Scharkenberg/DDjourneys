<ContentPage
	x:Class="DDjourneys.Pages.ZonePlanPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr Extras.NetworkMap}">

	<Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

		<!--  Which plan (segmented), then the tools at the trailing edge.  -->
		<Grid
			support:Dense.Padding="12,4"
			ColumnDefinitions="*,Auto"
			ColumnSpacing="8">
			<ScrollView HorizontalOptions="Start" Orientation="Horizontal" VerticalOptions="Center">
				<HorizontalStackLayout Padding="0,0,8,0" Spacing="4">
					<Border
						x:Name="SegRegion"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.ZonePlanRegion}">
						<Label
							x:Name="SegRegionLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.ZonePlanRegion}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="RegionTapped" />
						</Border.GestureRecognizers>
					</Border>
					<Border
						x:Name="SegDresden"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.ZonePlanDresden}">
						<Label
							x:Name="SegDresdenLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.ZonePlanDresden}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="DresdenTapped" />
						</Border.GestureRecognizers>
					</Border>
					<Border
						x:Name="SegNight"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanNight}">
						<Label
							x:Name="SegNightLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanNight}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="NightTapped" />
						</Border.GestureRecognizers>
					</Border>
					<Border
						x:Name="SegBarrierFree"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanBarrierFree}">
						<Label
							x:Name="SegBarrierFreeLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanBarrierFree}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="BarrierFreeTapped" />
						</Border.GestureRecognizers>
					</Border>
					<Border
						x:Name="SegCity"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanCityMap}">
						<Label
							x:Name="SegCityLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanCityMap}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="CityTapped" />
						</Border.GestureRecognizers>
					</Border>
				</HorizontalStackLayout>
			</ScrollView>

			<HorizontalStackLayout
				Grid.Column="1"
				Spacing="2"
				VerticalOptions="Center">
				<controls:IconButton
					x:Name="SearchButton"
					Clicked="SearchClicked"
					Glyph="Search"
					IsEnabled="False"
					SemanticProperties.Description="{localization:Tr Extras.ZonePlanSearch}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="LocateButton"
					Clicked="LocateClicked"
					Glyph="Locate"
					IsEnabled="False"
					SemanticProperties.Description="{localization:Tr Extras.ZonePlanLocate}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="ZoomOutButton"
					Clicked="ZoomOutClicked"
					Glyph="Minus"
					IsEnabled="False"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapZoomOut}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="ZoomInButton"
					Clicked="ZoomInClicked"
					Glyph="Plus"
					IsEnabled="False"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapZoomIn}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="RefreshButton"
					Clicked="RefreshClicked"
					Glyph="Refresh"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapRefresh}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="PdfButton"
					Clicked="OpenPdfClicked"
					Glyph="Document"
					IsVisible="False"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapOpenPdf}"
					TargetSize="{StaticResource HitIcon}" />
			</HorizontalStackLayout>
		</Grid>

		<!--  Find a stop: the field opens under the tools, the matches lie over the plan.  -->
		<Grid
			x:Name="SearchPanel"
			Grid.Row="1"
			support:Dense.Padding="12,0,12,6"
			ColumnDefinitions="*,Auto"
			ColumnSpacing="4"
			IsVisible="False">
			<Entry
				x:Name="SearchEntry"
				ClearButtonVisibility="WhileEditing"
				Completed="SearchCompleted"
				Placeholder="{localization:Tr Extras.ZonePlanSearchHint}"
				ReturnType="Search"
				TextChanged="SearchTextChanged" />

			<controls:IconButton
				Grid.Column="1"
				Clicked="SearchCloseClicked"
				Glyph="Close"
				SemanticProperties.Description="{localization:Tr Common.Cancel}"
				TargetSize="{StaticResource HitIcon}" />
		</Grid>

		<Grid Grid.Row="2" BackgroundColor="{DynamicResource Bg}">
			<controls:PlanView
				x:Name="Plan"
				Opacity="0"
				PlanLost="ReloadPlan"
				Shown="PlanShown"
				StopTapped="PlanStopTapped"
				ZoomChanged="PlanZoomChanged" />

			<ActivityIndicator
				x:Name="Busy"
				HeightRequest="32"
				HorizontalOptions="Center"
				IsRunning="True"
				VerticalOptions="Center"
				WidthRequest="32"
				Color="{DynamicResource Accent}" />

			<VerticalStackLayout
				x:Name="Message"
				Padding="24"
				HorizontalOptions="Center"
				IsVisible="false"
				Spacing="{DynamicResource SpaceM}"
				VerticalOptions="Center">
				<Label
					FontFamily="{DynamicResource FontSemibold}"
					HorizontalTextAlignment="Center"
					x:Name="MessageText" Text="{localization:Tr Extras.ZonePlanFailed}" />

				<Button
					Clicked="RetryClicked"
					HorizontalOptions="Center"
					StyleClass="Tonal"
					Text="{localization:Tr Common.TryAgain}" />
			</VerticalStackLayout>

			<Border
				x:Name="Stale"
				Margin="12"
				Padding="12,6"
				HorizontalOptions="Start"
				InputTransparent="True"
				IsVisible="false"
				StrokeShape="RoundRectangle 12"
				StyleClass="Card"
				VerticalOptions="Start">
				<Label StyleClass="Caption" Text="{localization:Tr Extras.ZonePlanStale}" />
			</Border>

			<!--  The matches of the search: a card over the top of the plan.  -->
			<Border
				x:Name="Matches"
				Margin="12,0,12,0"
				Padding="4"
				IsVisible="False"
				MaximumWidthRequest="480"
				StrokeShape="RoundRectangle 12"
				StyleClass="Card"
				VerticalOptions="Start">
				<ScrollView MaximumHeightRequest="360">
					<VerticalStackLayout x:Name="MatchList" Spacing="0" />
				</ScrollView>
			</Border>

			<!--  A short word now and then (locating, nothing near), at the bottom, gone by itself.  -->
			<Border
				x:Name="Toast"
				Margin="16,0,16,16"
				Padding="14,8"
				HorizontalOptions="Center"
				InputTransparent="True"
				IsVisible="False"
				StrokeShape="RoundRectangle 14"
				StyleClass="Card"
				VerticalOptions="End">
				<Label
					x:Name="ToastLabel"
					HorizontalTextAlignment="Center"
					LineBreakMode="WordWrap" />
			</Border>
		</Grid>

		<Label
			Grid.Row="3"
			Margin="12,6,12,10"
			x:Name="Credit"
			StyleClass="Caption"
			Text="{localization:Tr Extras.ZonePlanCredit}" />
	</Grid>
</ContentPage>
