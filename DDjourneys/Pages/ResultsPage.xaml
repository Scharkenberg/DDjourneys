<ContentPage
	x:Class="DDjourneys.Pages.ResultsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="Journeys"
	x:DataType="local:ResultsViewModel">

	<!--
		No EmptyView: on Windows a Label as direct child of a templated host has crashed before.
		The status panel is an ordinary sibling of the list instead.
	-->
	<Grid
		Padding="{StaticResource PadPage}"
		RowDefinitions="Auto,*"
		RowSpacing="{StaticResource SpaceM}">

		<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
			<VerticalStackLayout Spacing="2" VerticalOptions="Center">
				<Label
					LineBreakMode="TailTruncation"
					StyleClass="Title"
					Text="{Binding RouteText}" />
				<Label StyleClass="Caption" Text="{Binding WhenText}" />
			</VerticalStackLayout>
			<Button
				Grid.Column="1"
				Command="{Binding ReloadCommand}"
				SemanticProperties.Description="Search again"
				StyleClass="IconButton"
				Text="&#x21BB;" />
		</Grid>

		<Grid Grid.Row="1">

			<RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
				<CollectionView ItemsSource="{Binding Items}" SelectionMode="None">

					<CollectionView.ItemsLayout>
						<LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
					</CollectionView.ItemsLayout>

					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="support:JourneyCardModel">
							<controls:JourneyCard Loaded="CardLoaded">
								<controls:JourneyCard.GestureRecognizers>
									<TapGestureRecognizer Tapped="JourneyTapped" />
								</controls:JourneyCard.GestureRecognizers>
							</controls:JourneyCard>
						</DataTemplate>
					</CollectionView.ItemTemplate>

				</CollectionView>
			</RefreshView>

			<VerticalStackLayout
				Margin="0,48,0,0"
				IsVisible="{Binding ShowStatus}"
				Spacing="{StaticResource SpaceM}"
				VerticalOptions="Start">
				<ActivityIndicator
					HeightRequest="28"
					HorizontalOptions="Center"
					IsRunning="{Binding IsLoading}"
					IsVisible="{Binding IsLoading}"
					WidthRequest="28"
					Color="{DynamicResource Accent}" />
				<Label
					HorizontalTextAlignment="Center"
					IsVisible="{Binding HasStatusText}"
					StyleClass="Caption"
					Text="{Binding StatusText}" />
				<Button
					Command="{Binding ReloadCommand}"
					HorizontalOptions="Center"
					IsVisible="{Binding HasError}"
					StyleClass="Tonal"
					Text="Try again" />
			</VerticalStackLayout>

		</Grid>
	</Grid>

</ContentPage>
