<ContentPage
	x:Class="DDjourneys.Pages.ResultsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Results.Title}"
	x:DataType="local:ResultsViewModel">

	<Grid
		Padding="{DynamicResource PadPage}"
		RowDefinitions="Auto,Auto,*"
		RowSpacing="{DynamicResource SpaceM}">

		<!--  Result header  -->
		<controls:SearchHeader
			Grid.Row="0"
			ActionCommand="{Binding ReloadCommand}"
			ActionDescription="{localization:Tr Common.SearchAgain}"
			ActionGlyph="Refresh"
			From="{Binding FromName}"
			FromPlace="{Binding FromPlace}"
			Subtitle="{Binding WhenText}"
			To="{Binding ToName}"
			ToPlace="{Binding ToPlace}" />



		<Grid Grid.Row="2">

			<RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">

				<CollectionView ItemsSource="{Binding Items}" SelectionMode="None">

					<!--  Earlier / later connections (VVO prevnext)  -->
					<CollectionView.Header>
						<Button
							Margin="0,0,0,10"
							Command="{Binding PreviousCommand}"
							HorizontalOptions="Center"
							IsVisible="{Binding CanGoPrevious}"
							StyleClass="Tonal"
							Text="{localization:Tr Results.Previous}" />
					</CollectionView.Header>

					<CollectionView.Footer>
						<Grid Margin="0,10,0,0" RowDefinitions="Auto,Auto">
							<Button
								Command="{Binding NextCommand}"
								HorizontalOptions="Center"
								IsVisible="{Binding CanGoNext}"
								StyleClass="Tonal"
								Text="{localization:Tr Results.Next}" />

							<ActivityIndicator
								HeightRequest="28"
								HorizontalOptions="Center"
								IsRunning="{Binding IsPaging}"
								IsVisible="{Binding IsPaging}"
								WidthRequest="28"
								Color="{DynamicResource Accent}" />
						</Grid>
					</CollectionView.Footer>

					<CollectionView.ItemsLayout>
						<LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
					</CollectionView.ItemsLayout>

					<CollectionView.ItemTemplate>
						<DataTemplate x:DataType="support:JourneyCardModel">

							<controls:JourneyCard Loaded="CardLoaded">

								<controls:JourneyCard.GestureRecognizers>
									<TapGestureRecognizer Tapped="JourneyTapped" />
								</controls:JourneyCard.GestureRecognizers>

							</controls:JourneyCard>

						</DataTemplate>
					</CollectionView.ItemTemplate>

				</CollectionView>

			</RefreshView>


			<VerticalStackLayout
				Margin="0,48,0,0"
				IsVisible="{Binding ShowStatus}"
				Spacing="{DynamicResource SpaceM}"
				VerticalOptions="Start">

				<ActivityIndicator
					HeightRequest="28"
					HorizontalOptions="Center"
					IsRunning="{Binding IsLoading}"
					IsVisible="{Binding IsLoading}"
					WidthRequest="28"
					Color="{DynamicResource Accent}" />

				<controls:Skeleton IsVisible="{Binding IsLoading}" />

				<Label
					HorizontalTextAlignment="Center"
					IsVisible="{Binding HasStatusText}"
					StyleClass="Caption"
					Text="{Binding StatusText}" />

				<Button
					Command="{Binding ReloadCommand}"
					HorizontalOptions="Center"
					IsVisible="{Binding HasError}"
					StyleClass="Tonal"
					Text="{localization:Tr Common.TryAgain}" />

			</VerticalStackLayout>

		</Grid>

	</Grid>

</ContentPage>