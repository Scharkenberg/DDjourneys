<ContentPage
	x:Class="DDjourneys.Pages.JourneyPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Journey.Title}"
	x:DataType="local:JourneyViewModel">

	<ContentPage.ToolbarItems>
		<ToolbarItem
			x:Name="ExpertItem"
			Command="{Binding OpenExpertCommand}"
			Order="Secondary"
			Text="{localization:Tr Expert.Open}" />
	</ContentPage.ToolbarItems>

	<ContentPage.Resources>

		<!--  Stop where a leg starts or ends  -->
		<DataTemplate x:Key="StopTemplate" x:DataType="support:StopRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<VerticalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="1">

					<Label FontFamily="OpenSansSemibold" Text="{Binding Time}" />

					<controls:OccupancyIndicator IsVisible="{Binding HasOccupancy}" Level="{Binding Occupancy}" />

					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Caption"
						Text="{Binding ScheduledTime}"
						TextDecorations="Strikethrough" />

					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Delay"
						Text="{Binding DelayText}">
						<Label.Triggers>
							<DataTrigger
								Binding="{Binding IsEarly}"
								TargetType="Label"
								Value="True">
								<Setter Property="TextColor" Value="{DynamicResource OnTime}" />
							</DataTrigger>
						</Label.Triggers>
					</Label>
				</VerticalStackLayout>

				<Grid Grid.Column="1" RowDefinitions="16,*">

					<BoxView
						Grid.Row="0"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailTop}" />

					<BoxView
						Grid.Row="1"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />

					<Grid
						Grid.RowSpan="2"
						Margin="0,7,0,0"
						HeightRequest="18"
						VerticalOptions="Start"
						WidthRequest="18">

						<BoxView CornerRadius="9" Color="{Binding NodeColor}" />

						<BoxView
							CornerRadius="5"
							HeightRequest="10"
							HorizontalOptions="Center"
							VerticalOptions="Center"
							WidthRequest="10"
							Color="{DynamicResource Surface}" />
					</Grid>
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,10"
					Spacing="4">

					<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

					<Label
						IsVisible="{Binding HasPlatform}"
						StyleClass="Caption"
						Text="{Binding PlatformText}" />
				</VerticalStackLayout>

			</Grid>
		</DataTemplate>


		<!--  Stop between departure and arrival  -->
		<DataTemplate x:Key="IntermediateTemplate" x:DataType="support:IntermediateRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<VerticalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="2">

					<Label StyleClass="Caption" Text="{Binding Time}" />

					<controls:OccupancyIndicator IsVisible="{Binding HasOccupancy}" Level="{Binding Occupancy}" />
				</VerticalStackLayout>

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />

					<BoxView
						Margin="0,8,0,0"
						CornerRadius="5"
						HeightRequest="10"
						HorizontalOptions="Center"
						VerticalOptions="Start"
						WidthRequest="10"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,6"
					Spacing="2">

					<controls:StopNameView
						Compact="True"
						Place="{Binding Place}"
						Stop="{Binding Name}" />

					<HorizontalStackLayout Spacing="8">

						<Label
							IsVisible="{Binding HasDelay}"
							StyleClass="Delay"
							Text="{Binding DelayText}">
							<Label.Triggers>
								<DataTrigger
									Binding="{Binding IsEarly}"
									TargetType="Label"
									Value="True">
									<Setter Property="TextColor" Value="{DynamicResource OnTime}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>

						<Label
							IsVisible="{Binding IsNotServed}"
							StyleClass="Cancelled"
							Text="{localization:Tr Journey.NotServed}" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Ride: line, direction, duration, expand toggle  -->
		<DataTemplate x:Key="LegTemplate" x:DataType="support:LegRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,0,0,8"
					Spacing="3">

					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

						<Border
							BackgroundColor="{Binding Look.Fill}"
							StrokeDashArray="{Binding Look.Dashes}"
							StrokeShape="{Binding Look.Shape}"
							StrokeThickness="{Binding Look.StrokeThickness}"
							StyleClass="Chip"
							Stroke="{Binding Look.Stroke}"
							VerticalOptions="Center">

							<Label
								FontFamily="OpenSansSemibold"
								FontSize="{StaticResource FontCaption}"
								StyleClass="ChipLabel"
								Text="{Binding LineText}"
								TextColor="{Binding Look.Text}" />
						</Border>

						<Label
							Grid.Column="1"
							IsVisible="{Binding HasDirection}"
							LineBreakMode="TailTruncation"
							StyleClass="Caption"
							Text="{Binding Direction}"
							VerticalOptions="Center" />

						<Label
							Grid.Column="2"
							StyleClass="Caption"
							Text="{Binding DurationText}"
							VerticalOptions="Center" />
					</Grid>

					<Label
						IsVisible="{Binding HasFeatures}"
						StyleClass="Caption"
						Text="{Binding FeaturesText}" />

					<HorizontalStackLayout IsVisible="{Binding HasOccupancy}" Spacing="8">

						<controls:OccupancyIndicator Level="{Binding Occupancy}" />

						<Label
							StyleClass="Caption"
							Text="{Binding OccupancyText}"
							VerticalOptions="Center" />
					</HorizontalStackLayout>

					<Label
						IsVisible="{Binding IsCancelled}"
						StyleClass="Cancelled"
						Text="{localization:Tr Journey.Cancelled}" />

					<Label
						FontFamily="OpenSansSemibold"
						FontSize="{StaticResource FontCaption}"
						IsVisible="{Binding IsActive}"
						Text="{localization:Tr Journey.InProgress}"
						TextColor="{DynamicResource Accent}" />

					<HorizontalStackLayout
						IsVisible="{Binding HasIntermediates}"
						MinimumHeightRequest="36"
						SemanticProperties.Description="{localization:Tr Journey.ShowOrHideIntermediateStops}"
						Spacing="6"
						VerticalOptions="Center">

						<Label
							FontFamily="OpenSansSemibold"
							FontSize="{StaticResource FontBody}"
							Text="{Binding StopsText}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center" />

						<controls:Icon
							Glyph="ChevronDown"
							Rotation="{Binding ChevronRotation}"
							Size="18"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />

						<HorizontalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Tapped="StopsToggled" />
						</HorizontalStackLayout.GestureRecognizers>
					</HorizontalStackLayout>

				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Walking  -->
		<DataTemplate x:Key="WalkTemplate" x:DataType="support:WalkRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,10"
					Spacing="2">

					<Label FontFamily="OpenSansSemibold" Text="{Binding Text}" />

					<controls:StopNameView
						Compact="True"
						IsVisible="{Binding HasCaption}"
						Place="{Binding CaptionPlace}"
						Prefix="{Binding CaptionPrefix}"
						Stop="{Binding CaptionName}" />
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Change from one ride to the next.
		     Left: arrival time above the node, departure time below it, symmetric.
		     Middle: rail fills the full row height (top 48 / node 18 / rest).
     Occupancy dots sit outside the times: above the arrival, below the departure.
		     Right: the name sits on the node's line; details follow below.  -->
		<DataTemplate x:Key="InterchangeTemplate" x:DataType="support:InterchangeRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid
					Grid.Column="0"
					RowDefinitions="48,18,*"
					RowSpacing="0">

					<VerticalStackLayout
						Grid.Row="0"
						Padding="0,0,0,2"
						Spacing="1"
						VerticalOptions="End">

						<controls:OccupancyIndicator IsVisible="{Binding HasArrivalOccupancy}" Level="{Binding ArrivalOccupancy}" />

						<Label FontFamily="OpenSansSemibold" Text="{Binding ArrivalTime}" />

						<Label
							IsVisible="{Binding HasArrivalDelay}"
							StyleClass="Delay"
							Text="{Binding ArrivalDelay}">
							<Label.Triggers>
								<DataTrigger
									Binding="{Binding ArrivalIsEarly}"
									TargetType="Label"
									Value="True">
									<Setter Property="TextColor" Value="{DynamicResource OnTime}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>
					</VerticalStackLayout>

					<VerticalStackLayout
						Grid.Row="2"
						Padding="0,2,0,0"
						Spacing="1"
						VerticalOptions="Start">

						<Label FontFamily="OpenSansSemibold" Text="{Binding DepartureTime}" />

						<Label
							IsVisible="{Binding HasDepartureDelay}"
							StyleClass="Delay"
							Text="{Binding DepartureDelay}">
							<Label.Triggers>
								<DataTrigger
									Binding="{Binding DepartureIsEarly}"
									TargetType="Label"
									Value="True">
									<Setter Property="TextColor" Value="{DynamicResource OnTime}" />
								</DataTrigger>
							</Label.Triggers>
						</Label>

						<controls:OccupancyIndicator IsVisible="{Binding HasDepartureOccupancy}" Level="{Binding DepartureOccupancy}" />
					</VerticalStackLayout>
				</Grid>

				<Grid
					Grid.Column="1"
					RowDefinitions="48,18,*"
					RowSpacing="0">

					<BoxView
						Grid.Row="0"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailTop}" />

					<Grid
						Grid.Row="1"
						HeightRequest="18"
						VerticalOptions="Center"
						WidthRequest="18">

						<BoxView CornerRadius="9" Color="{Binding NodeColor}" />

						<BoxView
							CornerRadius="5"
							HeightRequest="10"
							HorizontalOptions="Center"
							VerticalOptions="Center"
							WidthRequest="10"
							Color="{DynamicResource Surface}" />
					</Grid>

					<BoxView
						Grid.Row="2"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,46,0,10"
					Spacing="3">

					<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

					<Label
						IsVisible="{Binding HasConnection}"
						StyleClass="Caption"
						Text="{Binding ConnectionText}" />

					<Label
						IsVisible="{Binding HasWalk}"
						StyleClass="Caption"
						Text="{Binding WalkText}" />

					<Border
						Margin="0,2,0,0"
						HorizontalOptions="Start"
						IsVisible="{Binding HasWait}"
						StyleClass="Chip">

						<Label StyleClass="Caption" Text="{Binding WaitText}" />
					</Border>

					<Label
						IsVisible="{Binding HasRisk}"
						StyleClass="Delay"
						Text="{Binding RiskText}" />

				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Provider message  -->
		<DataTemplate x:Key="NoticeTemplate" x:DataType="support:NoticeRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<controls:NoticeCard
					Grid.Column="2"
					Margin="0,2,0,8"
					Expanded="{Binding Expanded}"
					Technical="{Binding Technical}"
					Text="{Binding Text}" />
			</Grid>
		</DataTemplate>


		<support:TimelineTemplateSelector
			x:Key="RowSelector"
			Interchange="{StaticResource InterchangeTemplate}"
			Intermediate="{StaticResource IntermediateTemplate}"
			Leg="{StaticResource LegTemplate}"
			Notice="{StaticResource NoticeTemplate}"
			Stop="{StaticResource StopTemplate}"
			Walk="{StaticResource WalkTemplate}" />

	</ContentPage.Resources>


	<ScrollView>
		<VerticalStackLayout Padding="{StaticResource PadPage}" Spacing="{StaticResource SpaceM}">

			<VerticalStackLayout x:Name="HeaderBlock" Spacing="{StaticResource SpaceM}">

				<controls:SearchHeader
					ActionCommand="{Binding ShareCommand}"
					ActionDescription="{localization:Tr Common.Share}"
					ActionGlyph="Share"
					From="{Binding FromName}"
					FromPlace="{Binding FromPlace}"
					Subtitle="{Binding DayText}"
					To="{Binding ToName}"
					ToPlace="{Binding ToPlace}" />

				<controls:JourneyCard BindingContext="{Binding Summary}" />

				<VerticalStackLayout IsVisible="{Binding IsTrackingAvailable}" Spacing="8">

					<Button
						Command="{Binding FollowJourneyCommand}"
						IsVisible="{Binding CanFollow}"
						Text="{localization:Tr Journey.FollowJourney}" />

					<Grid
						ColumnDefinitions="*,*"
						ColumnSpacing="8"
						IsVisible="{Binding IsFollowed}">

						<Button
							Command="{Binding PauseCommand}"
							IsVisible="{Binding CanPause}"
							StyleClass="Tonal"
							Text="{localization:Tr Journey.DeactivateTracking}" />

						<Button
							Command="{Binding ResumeCommand}"
							IsVisible="{Binding IsPaused}"
							StyleClass="Tonal"
							Text="{localization:Tr Tracking.Resume}" />

						<Button
							Grid.Column="1"
							Command="{Binding StopFollowingCommand}"
							StyleClass="Tonal"
							Text="{localization:Tr Tracking.StopFollowing}" />
					</Grid>

					<Label StyleClass="Caption" Text="{Binding TrackingStatus}" />

					<Button
						Command="{Binding OpenFollowedCommand}"
						IsVisible="{Binding IsFollowed}"
						StyleClass="Tonal"
						Text="{localization:Tr Tracking.FollowedJourneys}" />
				</VerticalStackLayout>

				<VerticalStackLayout
					BindableLayout.ItemsSource="{Binding Notices}"
					IsVisible="{Binding HasNotices}"
					Spacing="{StaticResource SpaceS}">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="support:NoticeRow">

							<controls:NoticeCard
								Expanded="{Binding Expanded}"
								Technical="{Binding Technical}"
								Text="{Binding Text}" />

						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>

			<Label
				IsVisible="{Binding HasError}"
				StyleClass="Cancelled"
				Text="{Binding LoadError}" />

			<Border Padding="12,12,12,0" StyleClass="Card">

				<VerticalStackLayout BindableLayout.ItemTemplateSelector="{StaticResource RowSelector}" BindableLayout.ItemsSource="{Binding Rows}" />
			</Border>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
