<ContentPage
	x:Class="DDjourneys.Pages.JourneyPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Journey.Title}"
	x:DataType="local:JourneyViewModel">

	<ContentPage.ToolbarItems>
		<ToolbarItem
			x:Name="ExpertItem"
			Command="{Binding OpenExpertCommand}"
			Order="Secondary"
			Text="{localization:Tr Expert.Open}" />
	</ContentPage.ToolbarItems>

	<ContentPage.Resources>

		<!--  Stop where a leg starts or ends  -->
		<DataTemplate x:Key="StopTemplate" x:DataType="support:StopRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<VerticalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="1">

					<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Time}" />

					<controls:OccupancyIndicator IsVisible="{Binding HasOccupancy}" Level="{Binding Occupancy}" />

					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Caption"
						Text="{Binding ScheduledTime}"
						TextDecorations="Strikethrough" />

					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Delay"
						support:Themed.IsOn="{Binding IsEarly}"
						support:Themed.OnText="OnTime"
						support:Themed.Text="Delay"
						Text="{Binding DelayText}" />
				</VerticalStackLayout>

				<Grid Grid.Column="1" RowDefinitions="16,*">

					<BoxView
						Grid.Row="0"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailTop}" />

					<BoxView
						Grid.Row="1"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />

					<Grid
						Grid.RowSpan="2"
						Margin="0,7,0,0"
						HeightRequest="18"
						VerticalOptions="Start"
						WidthRequest="18">

						<BoxView CornerRadius="9" Color="{Binding NodeColor}" />

						<BoxView
							CornerRadius="5"
							HeightRequest="10"
							HorizontalOptions="Center"
							VerticalOptions="Center"
							WidthRequest="10"
							Color="{DynamicResource Surface}" />
					</Grid>
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,10"
					Spacing="4">

					<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

					<Label
						IsVisible="{Binding HasPlatform}"
						StyleClass="Caption"
						Text="{Binding PlatformText}" />

					<!--  The vehicle skips this stop: nobody can get on (start) or off (end) here  -->
					<Label
						IsVisible="{Binding IsNotServed}"
						StyleClass="Cancelled"
						Text="{localization:Tr Journey.NotServed}" />
				</VerticalStackLayout>

			</Grid>
		</DataTemplate>


		<!--  Stop between departure and arrival  -->
		<DataTemplate x:Key="IntermediateTemplate" x:DataType="support:IntermediateRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<VerticalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="2">

					<Label StyleClass="Caption" Text="{Binding Time}" />

					<controls:OccupancyIndicator IsVisible="{Binding HasOccupancy}" Level="{Binding Occupancy}" />
				</VerticalStackLayout>

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />

					<BoxView
						Margin="0,8,0,0"
						CornerRadius="5"
						HeightRequest="10"
						HorizontalOptions="Center"
						VerticalOptions="Start"
						WidthRequest="10"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,6"
					Spacing="2">

					<controls:StopNameView
						Compact="True"
						Place="{Binding Place}"
						Stop="{Binding Name}" />

					<HorizontalStackLayout Spacing="8">

						<Label
							IsVisible="{Binding HasDelay}"
							StyleClass="Delay"
							support:Themed.IsOn="{Binding IsEarly}"
							support:Themed.OnText="OnTime"
							support:Themed.Text="Delay"
							Text="{Binding DelayText}" />

						<Label
							IsVisible="{Binding IsNotServed}"
							StyleClass="Cancelled"
							Text="{localization:Tr Journey.NotServed}" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Ride: line, direction, duration, expand toggle  -->
		<DataTemplate x:Key="LegTemplate" x:DataType="support:LegRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,0,0,8"
					Spacing="3">

					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">

						<Border
							BackgroundColor="{Binding Look.Fill}"
							StrokeDashArray="{Binding Look.Dashes}"
							StrokeShape="{Binding Look.Shape}"
							StrokeThickness="{Binding Look.StrokeThickness}"
							StyleClass="Chip"
							Stroke="{Binding Look.Stroke}"
							VerticalOptions="Center">

							<support:PillScroll Fraction="0.6">
								<Label
									FontFamily="{DynamicResource FontSemibold}"
									FontSize="{StaticResource FontCaption}"
									StyleClass="ChipLabel"
									Text="{Binding LineText}"
									TextColor="{Binding Look.Text}" />
							</support:PillScroll>
						</Border>

						<!--  Direction: the same soft pill as a ride heading on the followed-journeys page  -->
						<Border
							Grid.Column="1"
							Padding="10,3"
							BackgroundColor="{DynamicResource AccentSoft}"
							HorizontalOptions="Start"
							IsVisible="{Binding HasDirection}"
							StrokeShape="RoundRectangle 100"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontFamily="{DynamicResource FontSemibold}"
								FontSize="{StaticResource FontCaption}"
								LineBreakMode="TailTruncation"
								Text="{Binding Direction}"
								TextColor="{DynamicResource Accent}" />
						</Border>

						<Label
							Grid.Column="2"
							StyleClass="Caption"
							Text="{Binding DurationText}"
							VerticalOptions="Center" />
					</Grid>

					<Label
						IsVisible="{Binding HasFeatures}"
						StyleClass="Caption"
						Text="{Binding FeaturesText}" />

					<Label
						IsVisible="{Binding HasOperating}"
						StyleClass="Caption"
						Text="{Binding OperatingText}" />

					<HorizontalStackLayout IsVisible="{Binding HasOccupancy}" Spacing="8">

						<controls:OccupancyIndicator Level="{Binding Occupancy}" />

						<Label
							StyleClass="Caption"
							Text="{Binding OccupancyText}"
							VerticalOptions="Center" />
					</HorizontalStackLayout>

					<Label
						IsVisible="{Binding IsCancelled}"
						StyleClass="Cancelled"
						Text="{localization:Tr Journey.Cancelled}" />

					<Label
						FontFamily="{DynamicResource FontSemibold}"
						FontSize="{StaticResource FontCaption}"
						IsVisible="{Binding IsActive}"
						Text="{localization:Tr Journey.InProgress}"
						support:Motion.Breathe="True"
						TextColor="{DynamicResource Accent}" />

					<FlexLayout AlignContent="Start" AlignItems="Start" Wrap="Wrap">
						<Button
							Margin="0,0,8,8"
							Padding="12,0"
							Command="{Binding Source={RelativeSource AncestorType={x:Type local:JourneyViewModel}}, x:DataType=local:JourneyViewModel, Path=ShowLiveCommand}"
							CommandParameter="{Binding .}"
							FontSize="{StaticResource FontCaption}"
							IsVisible="{Binding CanShowLive}"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="{localization:Tr Extras.LiveShow}" />
						<Button
							Margin="0,0,8,8"
							Padding="12,0"
							Command="{Binding Source={RelativeSource AncestorType={x:Type local:JourneyViewModel}}, x:DataType=local:JourneyViewModel, Path=LegEarlierCommand}"
							CommandParameter="{Binding .}"
							FontSize="{StaticResource FontCaption}"
							IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:JourneyViewModel}}, x:DataType=local:JourneyViewModel, Path=HasLegAlternatives}"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="{localization:Tr Journey.LegEarlier}" />
						<Button
							Margin="0,0,8,8"
							Padding="12,0"
							Command="{Binding Source={RelativeSource AncestorType={x:Type local:JourneyViewModel}}, x:DataType=local:JourneyViewModel, Path=LegLaterCommand}"
							CommandParameter="{Binding .}"
							FontSize="{StaticResource FontCaption}"
							IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:JourneyViewModel}}, x:DataType=local:JourneyViewModel, Path=HasLegAlternatives}"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="{localization:Tr Journey.LegLater}" />
					</FlexLayout>

					<HorizontalStackLayout support:Motion.Feedback="True"
						IsVisible="{Binding HasIntermediates}"
						support:Dense.MinHeight="{StaticResource HitButton}"
						SemanticProperties.Description="{localization:Tr Journey.ShowOrHideIntermediateStops}"
						Spacing="6"
						VerticalOptions="Center">

						<Label
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontBody}"
							Text="{Binding StopsText}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center" />

						<controls:Icon
							Glyph="ChevronDown"
							support:Motion.Turn="{Binding ChevronRotation}"
							Size="18"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />

						<HorizontalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Tapped="StopsToggled" />
						</HorizontalStackLayout.GestureRecognizers>
					</HorizontalStackLayout>

				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Walking  -->
		<DataTemplate x:Key="WalkTemplate" x:DataType="support:WalkRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,10"
					Spacing="2">

					<!--  Walk: dashed outline with the walking icon, like the walk heading on the followed-journeys page  -->
					<Border
						Padding="10,3"
						HorizontalOptions="Start"
						Stroke="{DynamicResource InkMuted}"
						StrokeDashArray="3,2"
						StrokeShape="RoundRectangle 100"
						StrokeThickness="1.5">
						<HorizontalStackLayout Spacing="6">
							<controls:Icon
								Glyph="Walk"
								Size="14"
								VerticalOptions="Center"
								Color="{DynamicResource InkMuted}" />
							<Label
								FontSize="{StaticResource FontCaption}"
								LineBreakMode="WordWrap"
								Text="{Binding Text}"
								TextColor="{DynamicResource InkMuted}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
					</Border>

					<controls:StopNameView
						Compact="True"
						IsVisible="{Binding HasCaption}"
						Place="{Binding CaptionPlace}"
						Prefix="{Binding CaptionPrefix}"
						Stop="{Binding CaptionName}" />
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Change from one ride to the next.
		     Left: arrival time above the node, departure time below it, symmetric.
		     Middle: rail fills the full row height (top 48 / node 18 / rest).
     Occupancy dots sit outside the times: above the arrival, below the departure.
		     Right: the name sits on the node's line; details follow below.  -->
		<DataTemplate x:Key="InterchangeTemplate" x:DataType="support:InterchangeRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid
					Grid.Column="0"
					RowDefinitions="48,18,*"
					RowSpacing="0">

					<VerticalStackLayout
						Grid.Row="0"
						Padding="0,0,0,2"
						Spacing="1"
						VerticalOptions="End">

						<controls:OccupancyIndicator IsVisible="{Binding HasArrivalOccupancy}" Level="{Binding ArrivalOccupancy}" />

						<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding ArrivalTime}" />

						<Label
							IsVisible="{Binding HasArrivalDelay}"
							StyleClass="Delay"
							support:Themed.IsOn="{Binding ArrivalIsEarly}"
							support:Themed.OnText="OnTime"
							support:Themed.Text="Delay"
							Text="{Binding ArrivalDelay}" />
					</VerticalStackLayout>

					<VerticalStackLayout
						Grid.Row="2"
						Padding="0,2,0,0"
						Spacing="1"
						VerticalOptions="Start">

						<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding DepartureTime}" />

						<Label
							IsVisible="{Binding HasDepartureDelay}"
							StyleClass="Delay"
							support:Themed.IsOn="{Binding DepartureIsEarly}"
							support:Themed.OnText="OnTime"
							support:Themed.Text="Delay"
							Text="{Binding DepartureDelay}" />

						<controls:OccupancyIndicator IsVisible="{Binding HasDepartureOccupancy}" Level="{Binding DepartureOccupancy}" />
					</VerticalStackLayout>
				</Grid>

				<Grid
					Grid.Column="1"
					RowDefinitions="48,18,*"
					RowSpacing="0">

					<BoxView
						Grid.Row="0"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailTop}" />

					<Grid
						Grid.Row="1"
						HeightRequest="18"
						VerticalOptions="Center"
						WidthRequest="18">

						<BoxView CornerRadius="9" Color="{Binding NodeColor}" />

						<BoxView
							CornerRadius="5"
							HeightRequest="10"
							HorizontalOptions="Center"
							VerticalOptions="Center"
							WidthRequest="10"
							Color="{DynamicResource Surface}" />
					</Grid>

					<BoxView
						Grid.Row="2"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,46,0,10"
					Spacing="3">

					<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

					<!--  Change instructions as pills (not tappable): connection soft, walk dashed  -->
					<Border
						Padding="10,3"
						BackgroundColor="{DynamicResource AccentSoft}"
						HorizontalOptions="Start"
						IsVisible="{Binding HasConnection}"
						StrokeShape="RoundRectangle 100"
						StrokeThickness="0">
						<Label
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="WordWrap"
							Text="{Binding ConnectionText}"
							TextColor="{DynamicResource Accent}" />
					</Border>

					<Border
						Padding="10,3"
						HorizontalOptions="Start"
						IsVisible="{Binding HasWalk}"
						Stroke="{DynamicResource InkMuted}"
						StrokeDashArray="3,2"
						StrokeShape="RoundRectangle 100"
						StrokeThickness="1.5">
						<HorizontalStackLayout Spacing="6">
							<controls:Icon
								Glyph="Walk"
								Size="14"
								VerticalOptions="Center"
								Color="{DynamicResource InkMuted}" />
							<Label
								FontSize="{StaticResource FontCaption}"
								LineBreakMode="WordWrap"
								Text="{Binding WalkText}"
								TextColor="{DynamicResource InkMuted}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
					</Border>

					<Border
						Margin="0,2,0,0"
						HorizontalOptions="Start"
						IsVisible="{Binding HasWait}"
						StyleClass="Chip">

						<support:PillScroll>
							<Label StyleClass="Caption" Text="{Binding WaitText}" />
						</support:PillScroll>
					</Border>

					<Label
						IsVisible="{Binding HasRisk}"
						StyleClass="Delay"
						Text="{Binding RiskText}" />

					<Border
						Padding="10,3"
						BackgroundColor="{DynamicResource AccentSoft}"
						HorizontalOptions="Start"
						IsVisible="{Binding HasAssurance}"
						StrokeShape="RoundRectangle 100"
						StrokeThickness="0">
						<Label
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="WordWrap"
							Text="{Binding AssuranceText}"
							TextColor="{DynamicResource Accent}" />
					</Border>

					<!--  The change cannot be made (stop skipped, or the next vehicle leaves first)  -->
					<Label
						IsVisible="{Binding HasBlock}"
						LineBreakMode="WordWrap"
						StyleClass="Cancelled"
						Text="{Binding BlockText}" />

				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Provider message  -->
		<DataTemplate x:Key="NoticeTemplate" x:DataType="support:NoticeRow">

			<Grid
				ColumnDefinitions="60,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">

					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<controls:NoticeCard
					Grid.Column="2"
					Margin="0,2,0,8"
					Expanded="{Binding Expanded}"
					Technical="{Binding Technical}"
					Text="{Binding Text}" />
			</Grid>
		</DataTemplate>


		<support:TimelineTemplateSelector
			x:Key="RowSelector"
			Interchange="{StaticResource InterchangeTemplate}"
			Intermediate="{StaticResource IntermediateTemplate}"
			Leg="{StaticResource LegTemplate}"
			Notice="{StaticResource NoticeTemplate}"
			Stop="{StaticResource StopTemplate}"
			Walk="{StaticResource WalkTemplate}" />

	</ContentPage.Resources>


	<ScrollView x:Name="PageScroll">
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

			<VerticalStackLayout x:Name="HeaderBlock" Spacing="{DynamicResource SpaceM}">

				<controls:SearchHeader
					ActionCommand="{Binding ShareCommand}"
					ActionDescription="{localization:Tr Common.Share}"
					ActionGlyph="Share"
					From="{Binding FromName}"
					FromPlace="{Binding FromPlace}"
					SecondaryCommand="{Binding Bookmark.ToggleCommand}"
					SecondaryDescription="{Binding Bookmark.Description}"
					SecondaryGlyph="{Binding Bookmark.Glyph}"
					Subtitle="{Binding DayText}"
					To="{Binding ToName}"
					ToPlace="{Binding ToPlace}" />

				<controls:JourneyCard BindingContext="{Binding Summary}" />

				<Label
					IsVisible="{Binding HasAlternativeStatus}"
					StyleClass="Caption"
					Text="{Binding AlternativeStatus}" />

				<Label
					IsVisible="{Binding HasHandOffStatus}"
					StyleClass="Cancelled"
					Text="{Binding HandOffStatus}" />

				<!--  Followed: one slim, tappable strip that leads to all followed journeys; the actions are icons in the card above  -->
				<Border
					Padding="10,6"
					BackgroundColor="{DynamicResource AccentSoft}"
					IsVisible="{Binding IsFollowed}"
					SemanticProperties.Description="{localization:Tr Tracking.FollowedJourneys}"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="0"
					support:Motion.Feedback="True">
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
						<controls:Icon
							Glyph="BellFilled"
							Size="16"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />
						<Label
							Grid.Column="1"
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="TailTruncation"
							Text="{Binding TrackingStatus}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center" />
						<controls:Icon
							Grid.Column="2"
							Glyph="ChevronRight"
							Size="16"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />
					</Grid>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding OpenFollowedCommand}" />
					</Border.GestureRecognizers>
				</Border>

				<Label
					IsVisible="{Binding ShowTrackingProblem}"
					StyleClass="Cancelled"
					Text="{Binding TrackingStatus}" />

				<VerticalStackLayout
					x:Name="NoticesBlock"
					BindableLayout.ItemsSource="{Binding Notices}"
					IsVisible="{Binding HasNotices}"
					Spacing="{DynamicResource SpaceS}">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="support:NoticeRow">

							<controls:NoticeCard
								Expanded="{Binding Expanded}"
								Technical="{Binding Technical}"
								Text="{Binding Text}" />

						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>

			<!--  Tickets: collapsed to the passenger's own ticket, every ticket on demand  -->
			<Border
				Padding="12"
				IsVisible="{Binding HasFares}"
				StyleClass="Card">

				<VerticalStackLayout Spacing="{DynamicResource SpaceS}">

					<Grid
						support:Motion.Feedback="True"
						support:Dense.MinHeight="{StaticResource HitButton}"
						ColumnDefinitions="Auto,*,Auto,Auto"
						ColumnSpacing="10"
						RowDefinitions="Auto,Auto"
						RowSpacing="0"
						SemanticProperties.Description="{Binding FaresToggleDescription}">

						<controls:Icon
							Glyph="Ticket"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />

						<Label
							Grid.Column="1"
							Margin="0"
							StyleClass="Section"
							Text="{localization:Tr Extras.FaresTitle}"
							VerticalOptions="Center"
							VerticalTextAlignment="Center" />

						<Label
							Grid.Column="2"
							Grid.RowSpan="2"
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontTitle}"
							Text="{Binding FaresSummaryPrice}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center"
							VerticalTextAlignment="Center" />

						<controls:Icon
							Grid.Column="3"
							Grid.RowSpan="2"
							Glyph="ChevronDown"
							support:Motion.Turn="{Binding FaresChevronRotation}"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />

						<Label
							Grid.Row="1"
							Grid.Column="1"
							StyleClass="Caption"
							Text="{Binding FaresSummaryName}" />

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding ToggleFaresCommand}" />
						</Grid.GestureRecognizers>
					</Grid>

					<VerticalStackLayout IsVisible="{Binding FaresExpanded}" Spacing="{DynamicResource SpaceS}">

						<BoxView StyleClass="Divider" />

						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Fares}" Spacing="2">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="support:FareRow">
									<Border
										Padding="8,6"
										SemanticProperties.Description="{Binding AccessibilityText}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="0">
										<Border.Triggers>
											<DataTrigger
												Binding="{Binding IsPreferred}"
												TargetType="Border"
												Value="True">
												<Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
											</DataTrigger>
										</Border.Triggers>
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
											<VerticalStackLayout Spacing="0" VerticalOptions="Center">
												<Label LineBreakMode="WordWrap" Text="{Binding Name}" />
												<Label
													IsVisible="{Binding HasDetail}"
													LineBreakMode="WordWrap"
													StyleClass="Caption"
													Text="{Binding Detail}" />
											</VerticalStackLayout>
											<Label
												Grid.Column="1"
												FontFamily="{DynamicResource FontSemibold}"
												Text="{Binding PriceText}"
												VerticalOptions="Center" />
										</Grid>
									</Border>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>

						<Label
							IsVisible="{Binding HasFaresZones}"
							StyleClass="Caption"
							Text="{Binding FaresZonesText}" />

						<Label
							IsVisible="{Binding HasFaresNotes}"
							LineBreakMode="WordWrap"
							StyleClass="Faint"
							Text="{Binding FaresNotesText}" />

						<Label StyleClass="Faint" Text="{localization:Tr Extras.FareNotAll}" />
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label
				IsVisible="{Binding HasError}"
				StyleClass="Cancelled"
				Text="{Binding LoadError}" />

			<Border Padding="12,12,12,0" StyleClass="Card">

				<VerticalStackLayout BindableLayout.ItemTemplateSelector="{StaticResource RowSelector}" BindableLayout.ItemsSource="{Binding Rows}" />
			</Border>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
