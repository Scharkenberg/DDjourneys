<ContentPage
	x:Class="DDjourneys.Pages.JourneyPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="Journey"
	x:DataType="local:JourneyViewModel">

	<ContentPage.ToolbarItems>
		<ToolbarItem Command="{Binding ShareCommand}" Text="Share" />
	</ContentPage.ToolbarItems>

	<ContentPage.Resources>

		<!--  Stop where a leg starts or ends  -->
		<DataTemplate x:Key="StopTemplate" x:DataType="support:StopRow">
			<Grid
				ColumnDefinitions="56,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">
				<VerticalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="1">
					<Label FontFamily="OpenSansSemibold" Text="{Binding Time}" />
					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Caption"
						Text="{Binding ScheduledTime}"
						TextDecorations="Strikethrough" />
					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Delay"
						Text="{Binding DelayText}" />
				</VerticalStackLayout>

				<Grid Grid.Column="1" RowDefinitions="16,*">
					<BoxView
						Grid.Row="0"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailTop}" />
					<BoxView
						Grid.Row="1"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
					<Grid
						Grid.RowSpan="2"
						Margin="0,7,0,0"
						HeightRequest="18"
						VerticalOptions="Start"
						WidthRequest="18">
						<BoxView CornerRadius="9" Color="{Binding NodeColor}" />
						<BoxView
							CornerRadius="5"
							HeightRequest="10"
							HorizontalOptions="Center"
							VerticalOptions="Center"
							WidthRequest="10"
							Color="{DynamicResource Surface}" />
					</Grid>
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,12"
					Spacing="2">
					<Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
					<Label
						IsVisible="{Binding HasPlatform}"
						StyleClass="Caption"
						Text="{Binding PlatformText}" />
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Stop between departure and arrival  -->
		<DataTemplate x:Key="IntermediateTemplate" x:DataType="support:IntermediateRow">
			<Grid
				ColumnDefinitions="56,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">
				<HorizontalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="4">
					<Label StyleClass="Caption" Text="{Binding Time}" />
				</HorizontalStackLayout>

				<Grid Grid.Column="1">
					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
					<BoxView
						Margin="0,8,0,0"
						CornerRadius="5"
						HeightRequest="10"
						HorizontalOptions="Center"
						VerticalOptions="Start"
						WidthRequest="10"
						Color="{Binding RailBottom}" />
				</Grid>

				<HorizontalStackLayout
					Grid.Column="2"
					Padding="0,4,0,10"
					Spacing="8">
					<Label StyleClass="Caption" Text="{Binding Name}" />
					<Label
						IsVisible="{Binding HasDelay}"
						StyleClass="Delay"
						Text="{Binding DelayText}" />
					<Label
						IsVisible="{Binding IsNotServed}"
						StyleClass="Cancelled"
						Text="Not served" />
				</HorizontalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Ride: line, direction, duration, expand toggle  -->
		<DataTemplate x:Key="LegTemplate" x:DataType="support:LegRow">
			<Grid
				ColumnDefinitions="56,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">
				<Grid Grid.Column="1">
					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,0,0,12"
					Spacing="4">

					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
						<Border BackgroundColor="{Binding ModeColor}" StyleClass="Chip">
							<Label
								FontFamily="OpenSansSemibold"
								FontSize="13"
								Text="{Binding LineText}"
								TextColor="White" />
						</Border>
						<Label
							Grid.Column="1"
							IsVisible="{Binding HasDirection}"
							LineBreakMode="TailTruncation"
							StyleClass="Caption"
							Text="{Binding Direction}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="2"
							StyleClass="Caption"
							Text="{Binding DurationText}"
							VerticalOptions="Center" />
					</Grid>

					<Label
						IsVisible="{Binding HasFeatures}"
						StyleClass="Caption"
						Text="{Binding FeaturesText}" />

					<Label
						IsVisible="{Binding IsCancelled}"
						StyleClass="Cancelled"
						Text="Cancelled" />

					<Label
						FontFamily="OpenSansSemibold"
						FontSize="13"
						IsVisible="{Binding IsActive}"
						Text="In progress"
						TextColor="{DynamicResource Accent}" />

					<HorizontalStackLayout
						IsVisible="{Binding HasIntermediates}"
						MinimumHeightRequest="36"
						SemanticProperties.Description="Show or hide intermediate stops"
						Spacing="6"
						VerticalOptions="Center">
						<Label
							FontFamily="OpenSansSemibold"
							FontSize="14"
							Text="{Binding StopsText}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center" />
						<Label
							FontSize="14"
							Text="{Binding Chevron}"
							TextColor="{DynamicResource Accent}" />

						<HorizontalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Tapped="StopsToggled" />
						</HorizontalStackLayout.GestureRecognizers>
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Walking  -->
		<DataTemplate x:Key="WalkTemplate" x:DataType="support:WalkRow">
			<Grid
				ColumnDefinitions="56,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">
				<Grid Grid.Column="1">
					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,16"
					Spacing="2">
					<Label FontFamily="OpenSansSemibold" Text="{Binding Text}" />
					<Label
						IsVisible="{Binding HasCaption}"
						StyleClass="Caption"
						Text="{Binding Caption}" />
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Change from one ride to the next  -->
		<DataTemplate x:Key="InterchangeTemplate" x:DataType="support:InterchangeRow">
			<Grid
				ColumnDefinitions="56,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">
				<VerticalStackLayout
					Grid.Column="0"
					Padding="0,4,0,0"
					Spacing="10">
					<VerticalStackLayout Spacing="1">
						<Label FontFamily="OpenSansSemibold" Text="{Binding ArrivalTime}" />
						<Label
							IsVisible="{Binding HasArrivalDelay}"
							StyleClass="Delay"
							Text="{Binding ArrivalDelay}" />
					</VerticalStackLayout>

					<VerticalStackLayout Spacing="1">
						<Label FontFamily="OpenSansSemibold" Text="{Binding DepartureTime}" />
						<Label
							IsVisible="{Binding HasDepartureDelay}"
							StyleClass="Delay"
							Text="{Binding DepartureDelay}" />
					</VerticalStackLayout>
				</VerticalStackLayout>

				<Grid Grid.Column="1" RowDefinitions="16,*">
					<BoxView
						Grid.Row="0"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailTop}" />
					<BoxView
						Grid.Row="1"
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
					<Grid
						Grid.RowSpan="2"
						Margin="0,7,0,0"
						HeightRequest="18"
						VerticalOptions="Start"
						WidthRequest="18">
						<BoxView CornerRadius="9" Color="{Binding NodeColor}" />
						<BoxView
							CornerRadius="5"
							HeightRequest="10"
							HorizontalOptions="Center"
							VerticalOptions="Center"
							WidthRequest="10"
							Color="{DynamicResource Surface}" />
					</Grid>
				</Grid>

				<VerticalStackLayout
					Grid.Column="2"
					Padding="0,4,0,12"
					Spacing="4">
					<Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />

					<Label
						IsVisible="{Binding HasContinuesFrom}"
						StyleClass="Caption"
						Text="{Binding ContinuesFrom}" />

					<Label
						IsVisible="{Binding HasPlatform}"
						StyleClass="Caption"
						Text="{Binding PlatformText}" />

					<Label
						IsVisible="{Binding HasWalk}"
						StyleClass="Caption"
						Text="{Binding WalkText}" />

					<Border
						Margin="0,2,0,0"
						HorizontalOptions="Start"
						IsVisible="{Binding HasWait}"
						StyleClass="Chip">
						<Label StyleClass="Caption" Text="{Binding WaitText}" />
					</Border>

					<Label
						IsVisible="{Binding HasRisk}"
						StyleClass="Delay"
						Text="{Binding RiskText}" />
				</VerticalStackLayout>
			</Grid>
		</DataTemplate>


		<!--  Provider message  -->
		<DataTemplate x:Key="NoticeTemplate" x:DataType="support:NoticeRow">
			<Grid
				ColumnDefinitions="56,18,*"
				ColumnSpacing="12"
				Loaded="RowLoaded"
				SemanticProperties.Description="{Binding Description}">

				<Grid Grid.Column="1">
					<BoxView
						HorizontalOptions="Center"
						WidthRequest="4"
						Color="{Binding RailBottom}" />
				</Grid>

				<controls:NoticeCard
					Grid.Column="2"
					Margin="0,2,0,12"
					Expanded="{Binding Expanded}"
					Technical="{Binding Technical}"
					Text="{Binding Text}" />
			</Grid>
		</DataTemplate>


		<support:TimelineTemplateSelector
			x:Key="RowSelector"
			Interchange="{StaticResource InterchangeTemplate}"
			Intermediate="{StaticResource IntermediateTemplate}"
			Leg="{StaticResource LegTemplate}"
			Notice="{StaticResource NoticeTemplate}"
			Stop="{StaticResource StopTemplate}"
			Walk="{StaticResource WalkTemplate}" />

	</ContentPage.Resources>


	<ScrollView>
		<VerticalStackLayout Padding="{StaticResource PadPage}" Spacing="{StaticResource SpaceM}">

			<VerticalStackLayout x:Name="HeaderBlock" Spacing="{StaticResource SpaceM}">

				<VerticalStackLayout Spacing="2">
					<Label StyleClass="Title" Text="{Binding RouteText}" />
					<Label StyleClass="Caption" Text="{Binding DayText}" />
				</VerticalStackLayout>


				<controls:JourneyCard BindingContext="{Binding Summary}" />


				<VerticalStackLayout
					BindableLayout.ItemsSource="{Binding Notices}"
					IsVisible="{Binding HasNotices}"
					Spacing="{StaticResource SpaceS}">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="support:NoticeRow">
							<controls:NoticeCard
								Expanded="{Binding Expanded}"
								Technical="{Binding Technical}"
								Text="{Binding Text}" />
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</VerticalStackLayout>


			<Label
				IsVisible="{Binding HasError}"
				StyleClass="Cancelled"
				Text="{Binding LoadError}" />

			<Border Padding="12,12,12,0" StyleClass="Card">

				<VerticalStackLayout BindableLayout.ItemTemplateSelector="{StaticResource RowSelector}" BindableLayout.ItemsSource="{Binding Rows}" />

			</Border>

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>