<ContentPage
	x:Class="DDjourneys.Pages.TrackedJourneysPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Tracking.Title}"
	x:DataType="local:TrackedJourneysViewModel">

	<ContentPage.ToolbarItems>
		<ToolbarItem
			Command="{Binding DeleteAllCommand}"
			Order="Secondary"
			Text="{localization:Tr Tracking.DeleteAll}" />
	</ContentPage.ToolbarItems>

	<RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsRefreshing}">
		<ScrollView x:Name="Scroller">
			<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

				<Border IsVisible="{Binding NotificationsBlocked}" StyleClass="Card">
					<Label StyleClass="Caption" Text="{localization:Tr Tracking.NotificationsDenied}" />
				</Border>

				<Label
					IsVisible="{Binding HasError}"
					StyleClass="Cancelled"
					Text="{Binding ErrorText}" />

				<!--  Which journey the live notification follows (only where the platform has one)  -->
				<VerticalStackLayout IsVisible="{Binding HasLiveOptions}" Spacing="{DynamicResource SpaceS}">

					<Label StyleClass="Section" Text="{localization:Tr Tracking.LiveTitle}" />

					<Border Padding="0" StyleClass="Card">
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding LiveOptions}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="local:LiveOption">
									<Grid support:Motion.Feedback="True"
										support:Dense.Padding="12,10"
										ColumnDefinitions="*,Auto"
										ColumnSpacing="10"
										support:Dense.MinHeight="52"
										SemanticProperties.Description="{Binding Title}">

										<VerticalStackLayout Spacing="1" VerticalOptions="Center">
											<Label
												FontFamily="{DynamicResource FontSemibold}"
												LineBreakMode="TailTruncation"
												Text="{Binding Title}" />
											<Label
												IsVisible="{Binding HasSubtitle}"
												StyleClass="Caption"
												Text="{Binding Subtitle}" />
										</VerticalStackLayout>

										<controls:Icon
											Grid.Column="1"
											Glyph="Check"
											IsVisible="{Binding IsSelected}"
											Size="20"
											VerticalOptions="Center"
											Color="{DynamicResource Accent}" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding SelectCommand}" />
										</Grid.GestureRecognizers>
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

				<VerticalStackLayout
					Padding="0,32"
					IsVisible="{Binding IsEmpty}"
					Spacing="4">

					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Subtitle"
						Text="{localization:Tr Tracking.Empty}" />

					<Label
						HorizontalTextAlignment="Center"
						StyleClass="Caption"
						Text="{localization:Tr Tracking.EmptyHint}" />
				</VerticalStackLayout>

				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Sections}" Spacing="{DynamicResource SpaceM}">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="local:TrackedSection">

							<VerticalStackLayout Spacing="{DynamicResource SpaceS}">

								<Label StyleClass="Section" Text="{Binding Title}" />

								<VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="{DynamicResource SpaceS}">

									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="local:TrackedRow">

											<Border
												ClassId="{Binding PlanId}"
												Loaded="CardLoaded"
												SemanticProperties.Description="{Binding AccessibilityText}"
												StyleClass="Card"
												support:Themed.IsOn="{Binding IsFocused}"
												support:Themed.OnStroke="AccentBrush"
												support:Themed.Stroke="OutlineBrush">

												<!--  The journey opened from a notification is outlined (colour via Themed, width here)  -->
												<Border.Triggers>
													<DataTrigger
														Binding="{Binding IsFocused}"
														TargetType="Border"
														Value="True">
														<Setter Property="StrokeThickness" Value="2" />
													</DataTrigger>
												</Border.Triggers>

												<VerticalStackLayout Spacing="8">

													<Grid support:Motion.Feedback="True" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

														<VerticalStackLayout Spacing="2">

															<!--  The title may wrap to two lines; pill and chevron keep their place in their own columns  -->
															<Label
																FontFamily="{DynamicResource FontSemibold}"
																LineBreakMode="TailTruncation"
																MaxLines="2"
																Text="{Binding Title}" />

															<Label StyleClass="Caption" Text="{Binding Subtitle}" />

															<Label
																IsVisible="{Binding HasLines}"
																StyleClass="Faint"
																Text="{Binding LinesText}" />
														</VerticalStackLayout>

														<!--  This journey drives the live notification  -->
														<Border
															Grid.Column="1"
															Padding="8,2"
															BackgroundColor="{DynamicResource Accent}"
															IsVisible="{Binding IsLive}"
															StrokeShape="RoundRectangle 100"
															StrokeThickness="0"
															VerticalOptions="Start">
															<HorizontalStackLayout Spacing="5">
																<Ellipse
																	Fill="{DynamicResource OnAccentBrush}"
																	HeightRequest="6"
																	VerticalOptions="Center"
																	WidthRequest="6" />
																<Label
																	FontFamily="{DynamicResource FontSemibold}"
																	FontSize="{StaticResource FontCaption}"
																	Text="{Binding LiveBadgeText}"
																	TextColor="{DynamicResource OnAccent}" />
															</HorizontalStackLayout>
														</Border>

														<controls:Icon
															Grid.Column="2"
															Glyph="{Binding ExpandIcon}"
															Size="18"
															VerticalOptions="Start"
															Color="{DynamicResource InkMuted}" />

														<Grid.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
														</Grid.GestureRecognizers>
													</Grid>

													<Label
														FontFamily="{DynamicResource FontSemibold}"
														FontSize="{StaticResource FontCaption}"
														IsVisible="{Binding IsNormalStatus}"
														Text="{Binding StatusText}"
														TextColor="{DynamicResource Accent}" />

													<Label
														IsVisible="{Binding IsProblem}"
														StyleClass="Delay"
														Text="{Binding StatusText}" />

													<Label
														IsVisible="{Binding IsCancelled}"
														StyleClass="Cancelled"
														Text="{Binding StatusText}" />

													<ProgressBar
														IsVisible="{Binding HasProgress}"
														Progress="{Binding Progress}"
														ProgressColor="{DynamicResource Accent}" />

													<Label
														IsVisible="{Binding HasNext}"
														StyleClass="Caption"
														Text="{Binding NextText}" />

													<!--  Only the current notice; outdated or superseded ones are removed by the tracker, the rest can be swiped away  -->
													<SwipeView IsVisible="{Binding HasNotice}">
														<SwipeView.LeftItems>
															<SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
																<SwipeItem
																	BackgroundColor="{DynamicResource Raised}"
																	Command="{Binding DismissNoticeCommand}"
																	Text="{Binding DismissNoticeText}" />
															</SwipeItems>
														</SwipeView.LeftItems>
														<SwipeView.RightItems>
															<SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
																<SwipeItem
																	BackgroundColor="{DynamicResource Raised}"
																	Command="{Binding DismissNoticeCommand}"
																	Text="{Binding DismissNoticeText}" />
															</SwipeItems>
														</SwipeView.RightItems>

														<Border
															support:Dense.Padding="10,8"
															BackgroundColor="{DynamicResource Raised}"
															StrokeShape="RoundRectangle 10"
															StrokeThickness="0">
															<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
																<controls:Icon
																	Glyph="Info"
																	IsVisible="{Binding NoticeIsInfo}"
																	Size="16"
																	VerticalOptions="Start"
																	Color="{DynamicResource Accent}" />
																<controls:Icon
																	Glyph="Warning"
																	IsVisible="{Binding NoticeIsAlert}"
																	Size="16"
																	VerticalOptions="Start"
																	Color="{DynamicResource Delay}" />
																<Label
																	Grid.Column="1"
																	LineBreakMode="WordWrap"
																	StyleClass="Caption"
																	Text="{Binding NoticeText}" />
																<controls:IconButton
																	Grid.Column="2"
																	Command="{Binding DismissNoticeCommand}"
																	Glyph="Close"
																	SemanticProperties.Description="{Binding DismissNoticeText}"
																	Size="14"
																	VerticalOptions="Start"
																	Color="{DynamicResource InkMuted}" />
															</Grid>
														</Border>
													</SwipeView>

													<!--  Extended view: every stop, moving with the clock  -->
													<Label support:Motion.Feedback="True"
														FontFamily="{DynamicResource FontSemibold}"
														FontSize="{StaticResource FontCaption}"
														Text="{Binding CourseToggleText}"
														TextColor="{DynamicResource Accent}">
														<Label.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding ToggleCourseCommand}" />
														</Label.GestureRecognizers>
													</Label>

													<Label
														IsVisible="{Binding HasCourseHint}"
														StyleClass="Caption"
														Text="{Binding CourseHint}" />

													<VerticalStackLayout BindableLayout.ItemsSource="{Binding Course}" IsVisible="{Binding HasCourse}">
														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="local:CourseRow">
																<Grid
																	ColumnDefinitions="52,22,*"
																	support:Dense.MinHeight="30"
																	Opacity="{Binding Fade}">

																	<!--  Rail: accent where the journey has been, outline where it still goes  -->
																	<BoxView
																		Grid.Column="1"
																		CornerRadius="1.5"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsRailDone}"
																		VerticalOptions="Fill"
																		WidthRequest="3"
																		Color="{DynamicResource Accent}" />
																	<BoxView
																		Grid.Column="1"
																		CornerRadius="1.5"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsRailAhead}"
																		VerticalOptions="Fill"
																		WidthRequest="3"
																		Color="{DynamicResource Outline}" />

																	<!--  Ride heading: filled while that ride is under way  -->
																	<Border
																		Grid.Column="2"
																		Margin="0,8,0,4"
																		Padding="10,3"
																		BackgroundColor="{DynamicResource AccentSoft}"
																		HorizontalOptions="Start"
																		IsVisible="{Binding IsOtherRideHeader}"
																		StrokeShape="RoundRectangle 100"
																		StrokeThickness="0">
																		<Label
																			FontFamily="{DynamicResource FontSemibold}"
																			FontSize="{StaticResource FontCaption}"
																			LineBreakMode="TailTruncation"
																			Text="{Binding Text}"
																			TextColor="{DynamicResource Accent}" />
																	</Border>

																	<Border
																		Grid.Column="2"
																		Margin="0,8,0,4"
																		Padding="10,3"
																		BackgroundColor="{DynamicResource Accent}"
																		HorizontalOptions="Start"
																		IsVisible="{Binding IsCurrentRideHeader}"
																		StrokeShape="RoundRectangle 100"
																		StrokeThickness="0">
																		<Label
																			FontFamily="{DynamicResource FontSemibold}"
																			FontSize="{StaticResource FontCaption}"
																			LineBreakMode="TailTruncation"
																			Text="{Binding Text}"
																			TextColor="{DynamicResource OnAccent}" />
																	</Border>

																	<!--  Walk heading: dashed outline, like the walking pill elsewhere  -->
																	<Border
																		Grid.Column="2"
																		Margin="0,8,0,4"
																		Padding="10,3"
																		HorizontalOptions="Start"
																		IsVisible="{Binding IsWalkHeader}"
																		Stroke="{DynamicResource InkMuted}"
																		StrokeDashArray="3,2"
																		StrokeShape="RoundRectangle 100"
																		StrokeThickness="1.5">
																		<HorizontalStackLayout Spacing="6">
																			<controls:Icon
																				Glyph="Walk"
																				Size="14"
																				VerticalOptions="Center"
																				Color="{DynamicResource InkMuted}" />
																			<Label
																				FontSize="{StaticResource FontCaption}"
																				LineBreakMode="TailTruncation"
																				Text="{Binding Text}"
																				TextColor="{DynamicResource InkMuted}"
																				VerticalOptions="Center" />
																		</HorizontalStackLayout>
																	</Border>

																	<!--  Times  -->
																	<VerticalStackLayout
																		IsVisible="{Binding IsStop}"
																		Spacing="0"
																		VerticalOptions="Center">
																		<Label
																			FontSize="{StaticResource FontCaption}"
																			HorizontalTextAlignment="End"
																			Text="{Binding Time}" />
																		<Label
																			FontSize="{StaticResource FontCaption}"
																			HorizontalTextAlignment="End"
																			IsVisible="{Binding IsLate}"
																			StyleClass="Delay"
																			Text="{Binding LiveTime}" />
																		<Label
																			FontSize="{StaticResource FontCaption}"
																			HorizontalTextAlignment="End"
																			IsVisible="{Binding IsOnTimeLive}"
																			StyleClass="OnTime"
																			Text="{Binding LiveTime}" />
																	</VerticalStackLayout>

																	<!--  Dots: halo + solid where the vehicle is, ring for the next stop, filled behind, hollow ahead  -->
																	<Ellipse
																		Grid.Column="1"
																		Fill="{DynamicResource AccentSoftBrush}"
																		HeightRequest="22"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsCurrentStop}"
																		VerticalOptions="Center"
																		WidthRequest="22" />
																	<Ellipse
																		Grid.Column="1"
																		Fill="{DynamicResource AccentBrush}"
																		HeightRequest="12"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsCurrentStop}"
																		VerticalOptions="Center"
																		WidthRequest="12" />
																	<Ellipse
																		Grid.Column="1"
																		Fill="{DynamicResource SurfaceBrush}"
																		HeightRequest="14"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsNextStop}"
																		Stroke="{DynamicResource AccentBrush}"
																		StrokeThickness="3"
																		VerticalOptions="Center"
																		WidthRequest="14" />
																	<Ellipse
																		Grid.Column="1"
																		Fill="{DynamicResource AccentBrush}"
																		HeightRequest="8"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsPassedStop}"
																		VerticalOptions="Center"
																		WidthRequest="8" />
																	<Ellipse
																		Grid.Column="1"
																		Fill="{DynamicResource SurfaceBrush}"
																		HeightRequest="8"
																		HorizontalOptions="Center"
																		IsVisible="{Binding IsUpcomingStop}"
																		Stroke="{DynamicResource OutlineBrush}"
																		StrokeThickness="2"
																		VerticalOptions="Center"
																		WidthRequest="8" />

																	<!--  Stop name, platform/track, countdown  -->
																	<Grid
																		Grid.Column="2"
																		ColumnDefinitions="*,Auto"
																		ColumnSpacing="8"
																		IsVisible="{Binding IsStop}"
																		VerticalOptions="Center">
																		<VerticalStackLayout Spacing="0" VerticalOptions="Center">
																			<Label
																				support:Themed.Font="FontRegular"
																				support:Themed.IsOn="{Binding IsEmphasized}"
																				support:Themed.OnFont="FontSemibold"
																				LineBreakMode="TailTruncation"
																				Text="{Binding Text}" />
																			<Label
																				IsVisible="{Binding HasDetail}"
																				StyleClass="Faint"
																				Text="{Binding Detail}" />
																		</VerticalStackLayout>

																		<Label
																			Grid.Column="1"
																			FontFamily="{DynamicResource FontSemibold}"
																			FontSize="{StaticResource FontCaption}"
																			IsVisible="{Binding HasEta}"
																			Text="{Binding Eta}"
																			TextColor="{DynamicResource Accent}"
																			VerticalOptions="Center" />
																	</Grid>
																</Grid>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</VerticalStackLayout>

													<VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="8">

														<BoxView StyleClass="Divider" />

														<VerticalStackLayout IsVisible="{Binding HasHistory}" Spacing="4">
															<Label StyleClass="Section" Text="{Binding HistoryTitle}" />
															<VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="6">
																<BindableLayout.ItemTemplate>
																	<DataTemplate x:DataType="local:NoticeRow">
																		<Grid ColumnDefinitions="48,*" ColumnSpacing="8">
																			<Label
																				FontFamily="{DynamicResource FontSemibold}"
																				StyleClass="Caption"
																				Text="{Binding Time}" />
																			<Label
																				Grid.Column="1"
																				LineBreakMode="WordWrap"
																				StyleClass="Caption"
																				Text="{Binding Text}" />
																		</Grid>
																	</DataTemplate>
																</BindableLayout.ItemTemplate>
															</VerticalStackLayout>
															<BoxView StyleClass="Divider" />
														</VerticalStackLayout>

														<Label StyleClass="Section" Text="{localization:Tr Tracking.Alerts}" />

														<FlexLayout AlignContent="Start" AlignItems="Start" Wrap="Wrap">

															<Border support:Motion.Feedback="True" Margin="0,0,8,8" StyleClass="ChipButton">
																<HorizontalStackLayout Spacing="6">
																	<controls:Icon
																		Glyph="Check"
																		IsVisible="{Binding StartAlertOn}"
																		Size="15"
																		VerticalOptions="Center"
																		Color="{DynamicResource Accent}" />

																	<Label
																		StyleClass="Caption"
																		Text="{Binding StartAlertText}"
																		VerticalOptions="Center" />
																</HorizontalStackLayout>
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding ToggleStartAlertCommand}" />
																</Border.GestureRecognizers>
															</Border>

															<Border support:Motion.Feedback="True" Margin="0,0,8,8" StyleClass="ChipButton">
																<Label StyleClass="Caption" Text="{Binding LeadText}" />
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding CycleLeadCommand}" />
																</Border.GestureRecognizers>
															</Border>

															<Border support:Motion.Feedback="True" Margin="0,0,8,8" StyleClass="ChipButton">
																<HorizontalStackLayout Spacing="6">
																	<controls:Icon
																		Glyph="Check"
																		IsVisible="{Binding ChangeAlertOn}"
																		Size="15"
																		VerticalOptions="Center"
																		Color="{DynamicResource Accent}" />

																	<Label
																		StyleClass="Caption"
																		Text="{Binding ChangeAlertText}"
																		VerticalOptions="Center" />
																</HorizontalStackLayout>
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding ToggleChangeAlertCommand}" />
																</Border.GestureRecognizers>
															</Border>

															<Border support:Motion.Feedback="True" Margin="0,0,8,8" StyleClass="ChipButton">
																<HorizontalStackLayout Spacing="6">
																	<controls:Icon
																		Glyph="Check"
																		IsVisible="{Binding ProblemAlertOn}"
																		Size="15"
																		VerticalOptions="Center"
																		Color="{DynamicResource Accent}" />

																	<Label
																		StyleClass="Caption"
																		Text="{Binding ProblemAlertText}"
																		VerticalOptions="Center" />
																</HorizontalStackLayout>
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding ToggleProblemAlertCommand}" />
																</Border.GestureRecognizers>
															</Border>
														</FlexLayout>

														<Grid ColumnDefinitions="*,*" ColumnSpacing="8">

															<Button
																Command="{Binding PauseResumeCommand}"
																IsVisible="{Binding CanPause}"
																StyleClass="Tonal"
																Text="{Binding PauseText}" />

															<Button
																Grid.Column="1"
																Command="{Binding StopCommand}"
																StyleClass="Tonal"
																Text="{Binding StopText}" />
														</Grid>
													</VerticalStackLayout>

												</VerticalStackLayout>
											</Border>

										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>

							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>
	</RefreshView>
</ContentPage>
