<?xml version="1.0" encoding="utf-8" ?>
<support:PanePage
	x:Class="DDjourneys.Pages.WidgetSetupPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Widgets.SetupTitle}">

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

			<Label StyleClass="Section" Text="{localization:Tr Widgets.SetupSummary}" />
			<Label StyleClass="Caption" Text="{localization:Tr Widgets.SetupHint}" />

			<Label StyleClass="Subtitle" Text="{localization:Tr Widgets.SetupPick}" />
			<VerticalStackLayout x:Name="Pinned" Spacing="4" />

			<VerticalStackLayout x:Name="Editor" IsVisible="false" Spacing="10">
				<BoxView StyleClass="Divider" />

				<Label x:Name="EditorTitle" StyleClass="Title" />

				<Label StyleClass="Section" Text="{localization:Tr Widgets.SetupKind}" />
				<FlexLayout AlignContent="Start" AlignItems="Start" Wrap="Wrap">
					<Button
						x:Name="KindDepartures"
						Margin="0,0,8,8"
						Clicked="OnKindDepartures"
						StyleClass="ChipButton" />
					<Button
						x:Name="KindRoute"
						Margin="0,0,8,8"
						Clicked="OnKindRoute"
						StyleClass="ChipButton" />
				</FlexLayout>

				<!--  The places the widget needs: the one that is being chosen is filled in; a tap picks another.  -->
				<VerticalStackLayout Spacing="6">
					<Button
						x:Name="StopField"
						HorizontalOptions="Fill"
						Clicked="OnStopField"
						StyleClass="Chip" />
					<Button
						x:Name="FromField"
						HorizontalOptions="Fill"
						Clicked="OnFromField"
						StyleClass="Chip" />
					<Button
						x:Name="ToField"
						HorizontalOptions="Fill"
						Clicked="OnToField"
						StyleClass="Chip" />
				</VerticalStackLayout>

				<Entry
					x:Name="Search"
					Placeholder="{localization:Tr Widgets.SetupSearch}"
					PlaceholderColor="{DynamicResource InkMuted}"
					TextChanged="OnSearchChanged"
					TextColor="{DynamicResource Ink}" />
				<ActivityIndicator
					x:Name="Searching"
					HeightRequest="24"
					HorizontalOptions="Start"
					IsVisible="false"
					WidthRequest="24"
					Color="{DynamicResource Accent}" />
				<VerticalStackLayout x:Name="Results" Spacing="2" />

				<Label x:Name="RowsCaption" StyleClass="Section" />
				<Stepper
					x:Name="Rows"
					HorizontalOptions="Start"
					Increment="1"
					Maximum="10"
					Minimum="1"
					ValueChanged="OnRowsChanged" />

				<Button
					x:Name="Save"
					Clicked="OnSave"
					StyleClass="Tonal" />
			</VerticalStackLayout>

			<Label
				x:Name="SavedNote"
				IsVisible="false"
				StyleClass="Caption" />

			<!--  The board's own error says nothing: what Windows has on record for this app, to copy  -->
			<BoxView StyleClass="Divider" />
			<Label StyleClass="Subtitle" Text="{localization:Tr Widgets.DiagTitle}" />
			<Label StyleClass="Caption" Text="{localization:Tr Widgets.DiagHint}" />
			<Button
				x:Name="DiagButton"
				Clicked="OnDiagnostics"
				HorizontalOptions="Start"
				StyleClass="Tonal"
				Text="{localization:Tr Widgets.DiagCopy}" />
			<Label
				x:Name="DiagText"
				IsVisible="false"
				FontFamily="Consolas"
				FontSize="12"
				StyleClass="Faint" />
		</VerticalStackLayout>
	</ScrollView>
</support:PanePage>
