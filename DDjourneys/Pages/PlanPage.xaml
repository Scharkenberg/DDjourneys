<ContentPage
	x:Class="DDjourneys.Pages.PlanPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:core="clr-namespace:DDjourneys.Core.Models;assembly=DDjourneys.Core"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:DataType="local:PlanViewModel"
	Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="HasText" />
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

			<Grid ColumnDefinitions="*,Auto">
				<Label
					StyleClass="Headline"
					Text="{localization:Tr Plan.Title}"
					VerticalOptions="Center" />

				<HorizontalStackLayout Grid.Column="1" Spacing="0">
					<controls:IconButton
						Clicked="DeparturesClicked"
						Glyph="Clock"
						IsVisible="{Binding HasDepartures}"
						SemanticProperties.Description="{localization:Tr Departures.Title}" />

					<controls:IconButton
						Clicked="DisruptionsClicked"
						Glyph="Warning"
						IsVisible="{Binding HasDisruptions}"
						SemanticProperties.Description="{localization:Tr Disruptions.Title}" />

					<controls:IconButton
						Clicked="TrackedClicked"
						Glyph="Bell"
						IsVisible="{Binding IsTrackingAvailable}"
						SemanticProperties.Description="{localization:Tr Tracking.FollowedJourneys}" />

					<controls:IconButton
						Clicked="SettingsClicked"
						Glyph="Tune"
						SemanticProperties.Description="{localization:Tr Settings.Title}" />
				</HorizontalStackLayout>
			</Grid>

			<!--  From / To  -->
			<Border StyleClass="Card">
				<Grid
					ColumnDefinitions="*,Auto"
					ColumnSpacing="4"
					RowDefinitions="Auto,Auto,Auto,Auto,Auto">

					<Grid
						Grid.Row="0"
						support:Dense.MinHeight="{StaticResource HitRow}"
						ColumnDefinitions="*,36,36,36">

						<VerticalStackLayout
							support:Motion.Feedback="True"
							Spacing="0"
							VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.FromPlaceholder}" />

							<controls:StopNameView
								Muted="{Binding NoFrom}"
								Place="{Binding FromPlace}"
								Stop="{Binding FromName}" />

							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="FromTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>

						<controls:IconButton
							Grid.Column="1"
							Command="{Binding UseLocationFromCommand}"
							Glyph="Locate"
							SemanticProperties.Description="{localization:Tr Plan.UseLocationFrom}"
							TargetSize="{StaticResource HitIconTight}" />

						<controls:IconButton
							Grid.Column="2"
							Clicked="FromMapClicked"
							Glyph="Map"
							SemanticProperties.Description="{localization:Tr Extras.MapPickOnMap}"
							TargetSize="{StaticResource HitIconTight}" />

						<controls:IconButton
							Grid.Column="3"
							Command="{Binding ToggleFromFavouriteCommand}"
							Glyph="{Binding FromStar}"
							InputTransparent="{Binding NoFrom}"
							Opacity="{Binding StarOpacityFrom}"
							SemanticProperties.Description="{localization:Tr Plan.ToggleFavouriteFrom}"
							TargetSize="{StaticResource HitIconTight}" />
					</Grid>

					<BoxView
						Grid.Row="1"
						HeightRequest="1"
						Color="{DynamicResource Outline}" />

					<Grid
						Grid.Row="2"
						support:Dense.MinHeight="{StaticResource HitRow}"
						ColumnDefinitions="*,36,36,36">

						<VerticalStackLayout
							support:Motion.Feedback="True"
							Spacing="0"
							VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.ToPlaceholder}" />

							<controls:StopNameView
								Muted="{Binding NoTo}"
								Place="{Binding ToPlace}"
								Stop="{Binding ToName}" />

							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="ToTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>

						<controls:IconButton
							Grid.Column="1"
							Command="{Binding UseLocationToCommand}"
							Glyph="Locate"
							SemanticProperties.Description="{localization:Tr Plan.UseLocationTo}"
							TargetSize="{StaticResource HitIconTight}" />

						<controls:IconButton
							Grid.Column="2"
							Clicked="ToMapClicked"
							Glyph="Map"
							SemanticProperties.Description="{localization:Tr Extras.MapPickOnMap}"
							TargetSize="{StaticResource HitIconTight}" />

						<controls:IconButton
							Grid.Column="3"
							Command="{Binding ToggleToFavouriteCommand}"
							Glyph="{Binding ToStar}"
							InputTransparent="{Binding NoTo}"
							Opacity="{Binding StarOpacityTo}"
							SemanticProperties.Description="{localization:Tr Plan.ToggleFavouriteTo}"
							TargetSize="{StaticResource HitIconTight}" />
					</Grid>

					<!--  A stop over is added where it happens: between start and destination  -->
					<BoxView
						Grid.Row="3"
						Grid.ColumnSpan="2"
						HeightRequest="1"
						IsVisible="{Binding NoVia}"
						Color="{DynamicResource Outline}" />

					<HorizontalStackLayout
						Grid.Row="4"
						Grid.ColumnSpan="2"
						Padding="0,2"
						support:Dense.MinHeight="{StaticResource HitButton}"
						support:Motion.Feedback="True"
						IsVisible="{Binding NoVia}"
						SemanticProperties.Description="{localization:Tr Plan.AddVia}"
						Spacing="8">
						<controls:Icon
							Glyph="Plus"
							Size="18"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />
						<Label
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontCaption}"
							Text="{localization:Tr Plan.AddVia}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center" />
						<HorizontalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding PickViaCommand}" />
						</HorizontalStackLayout.GestureRecognizers>
					</HorizontalStackLayout>

					<controls:IconButton
						Grid.RowSpan="3"
						Grid.Column="1"
						Clicked="SwapClicked"
						Command="{Binding SwapCommand}"
						Glyph="SwapVertical"
						SemanticProperties.Description="{localization:Tr Plan.SwapDescription}"
						Size="22"
						TargetSize="{StaticResource HitIconTight}"
						VerticalOptions="Center" />

				</Grid>
			</Border>

			<!--  Stop over  -->
			<Border
				Padding="0"
				IsVisible="{Binding HasVia}"
				StyleClass="Card">
				<Grid
					support:Dense.MinHeight="{StaticResource HitRowTight}"
					support:Dense.Padding="12,4"
					ColumnDefinitions="*,38">

					<VerticalStackLayout
						support:Motion.Feedback="True"
						Spacing="0"
						VerticalOptions="Center">
						<Label StyleClass="Caption" Text="{localization:Tr Plan.Via}" />

						<controls:StopNameView Place="{Binding ViaPlace}" Stop="{Binding ViaName}" />

						<VerticalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding PickViaCommand}" />
						</VerticalStackLayout.GestureRecognizers>
					</VerticalStackLayout>

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding ClearViaCommand}"
						Glyph="Close"
						SemanticProperties.Description="{localization:Tr Plan.ClearVia}"
						TargetSize="{StaticResource HitIconTight}" />
				</Grid>
			</Border>

			<!--  Date and time  -->
			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<Grid
						support:Dense.Padding="10,6"
						ColumnDefinitions="*,*"
						ColumnSpacing="{DynamicResource SpaceS}">

						<Button
							Grid.Column="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							support:Themed.IsOn="{Binding IsDeparture}"
							support:Themed.OnBackground="Accent"
							support:Themed.OnText="OnAccent"
							Command="{Binding DepartCommand}"
							StyleClass="Tonal"
							Text="{localization:Tr Plan.Departure}" />

						<Button
							Grid.Column="1"
							support:Dense.MinHeight="{StaticResource HitButton}"
							support:Themed.IsOn="{Binding IsArrival}"
							support:Themed.OnBackground="Accent"
							support:Themed.OnText="OnAccent"
							Command="{Binding ArriveCommand}"
							StyleClass="Tonal"
							Text="{localization:Tr Plan.Arrival}" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<!--  Date and time share one row while they fit; otherwise the time takes its own row  -->
					<controls:WhenPicker
						Date="{Binding Date}"
						MaximumDate="{Binding MaxDate}"
						MinimumDate="{Binding MinDate}"
						Time="{Binding Time}" />

					<BoxView StyleClass="Divider" />

					<!--  Five steps in one row, whatever the width: the quick steps roll over midnight; Now in the middle  -->
					<Grid
						support:Dense.Padding="10,6"
						ColumnDefinitions="*,*,*,*,*"
						ColumnSpacing="4">

						<Button
							Grid.Column="0"
							Padding="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							Command="{Binding NudgeCommand}"
							CommandParameter="-60"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							StyleClass="Tonal"
							Text="&#x2212;1 h" />

						<Button
							Grid.Column="1"
							Padding="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							Command="{Binding NudgeCommand}"
							CommandParameter="-15"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							StyleClass="Tonal"
							Text="&#x2212;15 m" />

						<!--  "Now" resets the time: in the middle of the steps, so the row says everything about the moment  -->
						<Button
							Grid.Column="2"
							Padding="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							Command="{Binding NowCommand}"
							FontSize="{StaticResource FontCaption}"
							IsEnabled="{Binding IsNotNow}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							StyleClass="Tonal"
							Text="{localization:Tr Departures.Now}" />

						<Button
							Grid.Column="3"
							Padding="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							Command="{Binding NudgeCommand}"
							CommandParameter="15"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							StyleClass="Tonal"
							Text="+15 m" />

						<Button
							Grid.Column="4"
							Padding="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							Command="{Binding NudgeCommand}"
							CommandParameter="60"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							StyleClass="Tonal"
							Text="+1 h" />
					</Grid>

				</VerticalStackLayout>
			</Border>

			<!--  Search; the bookmark of the connection sits next to it: filled when saved, one tap toggles  -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SpaceS}">
				<Button Command="{Binding SearchCommand}" Text="{localization:Tr Plan.SearchJourneys}" />

				<Border
					Grid.Column="1"
					support:Dense.MinHeight="{StaticResource HitRow}"
					support:Motion.Feedback="True"
					BackgroundColor="{DynamicResource AccentSoft}"
					SemanticProperties.Description="{Binding Bookmark.Description}"
					StrokeShape="RoundRectangle 6"
					StrokeThickness="0"
					WidthRequest="52">
					<controls:Icon
						Glyph="{Binding Bookmark.Glyph}"
						HorizontalOptions="Center"
						Size="22"
						VerticalOptions="Center"
						Color="{DynamicResource Accent}" />
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding Bookmark.ToggleCommand}" />
					</Border.GestureRecognizers>
				</Border>
			</Grid>

			<!--  Places: home, favourites and recent places in one swipeable strip of chips (one tap fills the next free field)  -->
			<ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
				<HorizontalStackLayout Spacing="0">

					<Border
						Margin="0,0,6,0"
						support:Dense.MinHeight="{StaticResource HitButton}"
						support:Motion.Feedback="True"
						SemanticProperties.Description="{localization:Tr Extras.HomeTitle}"
						StyleClass="ChipButton">
						<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
							<controls:Icon
								Glyph="Home"
								Size="16"
								VerticalOptions="Center"
								Color="{DynamicResource Accent}" />
							<Label
								FontFamily="{DynamicResource FontSemibold}"
								FontSize="{StaticResource FontCaption}"
								LineBreakMode="NoWrap"
								Text="{Binding HomeName}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding HomeCommand}" />
						</Border.GestureRecognizers>
					</Border>

					<controls:IconButton
						Margin="0,0,6,0"
						Command="{Binding SetHomeCommand}"
						Glyph="Edit"
						IsVisible="{Binding HasHome}"
						SemanticProperties.Description="{localization:Tr Plan.SetHome}"
						TargetSize="{StaticResource HitIconTight}" />

					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding PlaceChips}" Spacing="0">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="local:PlaceChip">
								<Border
									Margin="0,0,6,0"
									support:Dense.MinHeight="{StaticResource HitButton}"
									support:Motion.Feedback="True"
									SemanticProperties.Description="{Binding Description}"
									StyleClass="ChipButton">
									<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
										<controls:Icon
											Glyph="{Binding Glyph}"
											Size="16"
											VerticalOptions="Center"
											Color="{DynamicResource InkMuted}" />
										<Label
											FontFamily="{DynamicResource FontSemibold}"
											FontSize="{StaticResource FontCaption}"
											LineBreakMode="NoWrap"
											Text="{Binding Name}"
											VerticalOptions="Center" />
										<Label
											FontSize="{StaticResource FontCaption}"
											IsVisible="{Binding HasCity}"
											LineBreakMode="NoWrap"
											StyleClass="Faint"
											Text="{Binding City}"
											VerticalOptions="Center" />
									</HorizontalStackLayout>
									<Border.GestureRecognizers>
										<TapGestureRecognizer Tapped="PlaceTapped" />
									</Border.GestureRecognizers>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>

					<controls:IconButton
						Command="{Binding ClearRecentsCommand}"
						Glyph="Trash"
						IsVisible="{Binding HasRecents}"
						SemanticProperties.Description="{localization:Tr Common.Clear}"
						TargetSize="{StaticResource HitIconTight}" />
				</HorizontalStackLayout>
			</ScrollView>

			<!--  Routes: saved ones (bookmark) first, then the latest searches (clock); one tap looks the connection up  -->
			<Border
				Padding="0"
				IsVisible="{Binding HasRouteLines}"
				StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding RouteLines}">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="local:RouteLine">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="0">

									<Grid
										support:Dense.MinHeight="{StaticResource HitRowTight}"
										support:Dense.Padding="12,4,4,4"
										support:Motion.Feedback="True"
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="10"
										SemanticProperties.Description="{Binding Description}">

										<controls:Icon
											Glyph="{Binding Glyph}"
											Size="18"
											VerticalOptions="Center"
											Color="{DynamicResource InkMuted}" />

										<Label
											Grid.Column="1"
											LineBreakMode="MiddleTruncation"
											Text="{Binding Text}"
											VerticalOptions="Center" />

										<controls:IconButton
											Grid.Column="2"
											Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, x:DataType=local:PlanViewModel, Path=ForgetLineCommand}"
											CommandParameter="{Binding .}"
											Glyph="Close"
											SemanticProperties.Description="{localization:Tr Plan.ForgetSearch}"
											Size="16"
											TargetSize="{StaticResource HitIconTight}" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, x:DataType=local:PlanViewModel, Path=UseLineCommand}" CommandParameter="{Binding .}" />
										</Grid.GestureRecognizers>
									</Grid>

									<BoxView Grid.Row="1" StyleClass="Divider" />
								</Grid>

							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</VerticalStackLayout>

					<!--  Footer: the rest of the searches, and clearing them  -->
					<Grid
						Padding="8,2"
						ColumnDefinitions="*,Auto"
						IsVisible="{Binding HasRecentRoutes}">
						<Button
							Padding="14,0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							Command="{Binding ToggleRoutesCommand}"
							FontSize="{StaticResource FontCaption}"
							HorizontalOptions="Start"
							IsVisible="{Binding CanExpandRoutes}"
							StyleClass="Tonal"
							Text="{Binding RoutesToggleText}" />
						<controls:IconButton
							Grid.Column="1"
							Command="{Binding ClearRoutesCommand}"
							Glyph="Trash"
							SemanticProperties.Description="{localization:Tr Common.Clear}"
							TargetSize="{StaticResource HitIconTight}" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Label
				IsVisible="{Binding IsPlacesEmpty}"
				StyleClass="Caption"
				Text="{localization:Tr Plan.PlacesYouSearchForWillAppearHere}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>