<ContentPage
	x:Class="DDjourneys.Pages.PlanPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:core="clr-namespace:DDjourneys.Core.Models;assembly=DDjourneys.Core"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	x:DataType="local:PlanViewModel"
	Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<Style TargetType="DatePicker">
			<Setter Property="TextColor" Value="{DynamicResource Ink}" />
			<Setter Property="FontFamily" Value="OpenSansSemibold" />
			<Setter Property="FontSize" Value="15" />
		</Style>
		<Style TargetType="TimePicker">
			<Setter Property="TextColor" Value="{DynamicResource Ink}" />
			<Setter Property="FontFamily" Value="OpenSansSemibold" />
			<Setter Property="FontSize" Value="15" />
		</Style>
		<Style x:Key="IconButton" TargetType="Button">
			<Setter Property="BackgroundColor" Value="Transparent" />
			<Setter Property="TextColor" Value="{DynamicResource Accent}" />
			<Setter Property="FontSize" Value="22" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="MinimumHeightRequest" Value="44" />
			<Setter Property="MinimumWidthRequest" Value="44" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="{StaticResource PadPage}" Spacing="{StaticResource SpaceM}">

			<Label StyleClass="Headline" Text="Where to?" />

			<!--  From / To  -->
			<Border StyleClass="Card">
				<Grid
					ColumnDefinitions="*,Auto"
					ColumnSpacing="{StaticResource SpaceS}"
					RowDefinitions="Auto,Auto,Auto">

					<Grid
						Grid.Row="0"
						Padding="0,8"
						ColumnDefinitions="*,Auto">
						<VerticalStackLayout Spacing="2" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="From" />
							<Label
								FontFamily="OpenSansSemibold"
								LineBreakMode="TailTruncation"
								Text="{Binding FromText}">
								<Label.Triggers>
									<DataTrigger
										Binding="{Binding HasFrom}"
										TargetType="Label"
										Value="False">
										<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
									</DataTrigger>
								</Label.Triggers>
							</Label>
							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="FromTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>
						<Button
							Grid.Column="1"
							Command="{Binding ToggleFromFavouriteCommand}"
							IsVisible="{Binding HasFrom}"
							SemanticProperties.Description="Toggle favourite for start"
							Style="{StaticResource IconButton}"
							Text="{Binding FromStar}" />
					</Grid>

					<BoxView
						Grid.Row="1"
						HeightRequest="1"
						Color="{DynamicResource Outline}" />

					<Grid
						Grid.Row="2"
						Padding="0,8"
						ColumnDefinitions="*,Auto">
						<VerticalStackLayout Spacing="2" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="To" />
							<Label
								FontFamily="OpenSansSemibold"
								LineBreakMode="TailTruncation"
								Text="{Binding ToText}">
								<Label.Triggers>
									<DataTrigger
										Binding="{Binding HasTo}"
										TargetType="Label"
										Value="False">
										<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
									</DataTrigger>
								</Label.Triggers>
							</Label>
							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="ToTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>
						<Button
							Grid.Column="1"
							Command="{Binding ToggleToFavouriteCommand}"
							IsVisible="{Binding HasTo}"
							SemanticProperties.Description="Toggle favourite for destination"
							Style="{StaticResource IconButton}"
							Text="{Binding ToStar}" />
					</Grid>

					<Button
						Grid.RowSpan="3"
						Grid.Column="1"
						Clicked="SwapClicked"
						Command="{Binding SwapCommand}"
						FontSize="26"
						SemanticProperties.Description="Swap start and destination"
						Style="{StaticResource IconButton}"
						Text="&#x21C5;"
						VerticalOptions="Center" />

				</Grid>
			</Border>

			<!--  Date and time  -->
			<Border StyleClass="Card">
				<VerticalStackLayout Spacing="{StaticResource SpaceM}">

					<Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceS}">
						<Button
							Grid.Column="0"
							Command="{Binding DepartCommand}"
							MinimumHeightRequest="40"
							StyleClass="Tonal"
							Text="Depart">
							<Button.Triggers>
								<DataTrigger
									Binding="{Binding IsArrival}"
									TargetType="Button"
									Value="False">
									<Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
									<Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
								</DataTrigger>
							</Button.Triggers>
						</Button>
						<Button
							Grid.Column="1"
							Command="{Binding ArriveCommand}"
							MinimumHeightRequest="40"
							StyleClass="Tonal"
							Text="Arrive by">
							<Button.Triggers>
								<DataTrigger
									Binding="{Binding IsArrival}"
									TargetType="Button"
									Value="True">
									<Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
									<Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
								</DataTrigger>
							</Button.Triggers>
						</Button>
					</Grid>

					<Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="{StaticResource SpaceM}">
						<VerticalStackLayout Grid.Column="0" Spacing="2">
							<Label StyleClass="Caption" Text="Date" />
							<DatePicker
								Date="{Binding Date}"
								Format="ddd, d MMM"
								MinimumDate="{Binding MinDate}" />
						</VerticalStackLayout>
						<VerticalStackLayout Grid.Column="1" Spacing="2">
							<Label StyleClass="Caption" Text="Time" />
							<TimePicker Format="HH:mm" Time="{Binding Time}" />
						</VerticalStackLayout>
						<Button
							Grid.Column="2"
							Command="{Binding NowCommand}"
							IsVisible="{Binding IsNotNow}"
							MinimumHeightRequest="40"
							StyleClass="Tonal"
							Text="Now"
							VerticalOptions="End" />
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Button Command="{Binding SearchCommand}" Text="Search journeys" />

			<!--  Favourites  -->
			<VerticalStackLayout IsVisible="{Binding HasFavourites}" Spacing="{StaticResource SpaceS}">
				<Label StyleClass="Title" Text="Favourites" />
				<FlexLayout BindableLayout.ItemsSource="{Binding Favourites}" Wrap="Wrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="core:Location">
							<Border
								Margin="0,0,8,8"
								Padding="14,12"
								StrokeShape="RoundRectangle 12"
								StyleClass="Chip">
								<Label Text="{Binding Name}" />
								<Border.GestureRecognizers>
									<TapGestureRecognizer Tapped="PlaceTapped" />
								</Border.GestureRecognizers>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>
			</VerticalStackLayout>

			<!--  Recent  -->
			<VerticalStackLayout IsVisible="{Binding HasRecents}" Spacing="{StaticResource SpaceS}">
				<Grid ColumnDefinitions="*,Auto">
					<Label
						StyleClass="Title"
						Text="Recent"
						VerticalOptions="Center" />
					<Button
						Grid.Column="1"
						Command="{Binding ClearRecentsCommand}"
						FontSize="14"
						Style="{StaticResource IconButton}"
						Text="Clear" />
				</Grid>
				<Border Padding="8" StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Recents}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="core:Location">
								<VerticalStackLayout Padding="8,10" Spacing="2">
									<Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
									<Label StyleClass="Caption" Text="{Binding Place}" />
									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Tapped="PlaceTapped" />
									</VerticalStackLayout.GestureRecognizers>
								</VerticalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<Label
				IsVisible="{Binding IsPlacesEmpty}"
				StyleClass="Caption"
				Text="Places you search for will appear here." />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
