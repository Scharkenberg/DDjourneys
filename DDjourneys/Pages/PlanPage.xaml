<ContentPage
	x:Class="DDjourneys.Pages.PlanPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:core="clr-namespace:DDjourneys.Core.Models;assembly=DDjourneys.Core"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:DataType="local:PlanViewModel"
	Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="HasText" />
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

			<Grid ColumnDefinitions="*,Auto">
				<Label
					StyleClass="Headline"
					Text="{localization:Tr Plan.Title}"
					VerticalOptions="Center" />

				<HorizontalStackLayout Grid.Column="1" Spacing="0">
					<controls:IconButton
						Clicked="DeparturesClicked"
						Glyph="Clock"
						IsVisible="{Binding HasDepartures}"
						SemanticProperties.Description="{localization:Tr Departures.Title}" />

					<controls:IconButton
						Clicked="DisruptionsClicked"
						Glyph="Warning"
						IsVisible="{Binding HasDisruptions}"
						SemanticProperties.Description="{localization:Tr Disruptions.Title}" />

					<controls:IconButton
						Clicked="TrackedClicked"
						Glyph="Bell"
						IsVisible="{Binding IsTrackingAvailable}"
						SemanticProperties.Description="{localization:Tr Tracking.FollowedJourneys}" />

					<controls:IconButton
						Clicked="SettingsClicked"
						Glyph="Tune"
						SemanticProperties.Description="{localization:Tr Settings.Title}" />
				</HorizontalStackLayout>
			</Grid>

			<!--  From / To  -->
			<Border StyleClass="Card">
				<Grid
					ColumnDefinitions="*,Auto"
					ColumnSpacing="4"
					RowDefinitions="Auto,Auto,Auto,Auto,Auto">

					<Grid
						Grid.Row="0"
						ColumnDefinitions="*,36,36,36"
						support:Dense.MinHeight="{StaticResource HitRow}">

						<VerticalStackLayout support:Motion.Feedback="True" Spacing="0" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.FromPlaceholder}" />

							<controls:StopNameView
								Muted="{Binding NoFrom}"
								Place="{Binding FromPlace}"
								Stop="{Binding FromName}" />

							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="FromTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>

						<controls:IconButton
							Grid.Column="1"
							Command="{Binding UseLocationFromCommand}"
							TargetSize="{StaticResource HitIconTight}"
							Glyph="Locate"
							SemanticProperties.Description="{localization:Tr Plan.UseLocationFrom}" />

						<controls:IconButton
							Grid.Column="2"
							Clicked="FromMapClicked"
							Glyph="Map"
							SemanticProperties.Description="{localization:Tr Extras.MapPickOnMap}"
							TargetSize="{StaticResource HitIconTight}" />

						<controls:IconButton
							Grid.Column="3"
							Command="{Binding ToggleFromFavouriteCommand}"
							TargetSize="{StaticResource HitIconTight}"
							Glyph="{Binding FromStar}"
							InputTransparent="{Binding NoFrom}"
							Opacity="{Binding StarOpacityFrom}"
							SemanticProperties.Description="{localization:Tr Plan.ToggleFavouriteFrom}" />
					</Grid>

					<BoxView
						Grid.Row="1"
						HeightRequest="1"
						Color="{DynamicResource Outline}" />

					<Grid
						Grid.Row="2"
						ColumnDefinitions="*,36,36,36"
						support:Dense.MinHeight="{StaticResource HitRow}">

						<VerticalStackLayout support:Motion.Feedback="True" Spacing="0" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.ToPlaceholder}" />

							<controls:StopNameView
								Muted="{Binding NoTo}"
								Place="{Binding ToPlace}"
								Stop="{Binding ToName}" />

							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="ToTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>

						<controls:IconButton
							Grid.Column="1"
							Command="{Binding UseLocationToCommand}"
							TargetSize="{StaticResource HitIconTight}"
							Glyph="Locate"
							SemanticProperties.Description="{localization:Tr Plan.UseLocationTo}" />

						<controls:IconButton
							Grid.Column="2"
							Clicked="ToMapClicked"
							Glyph="Map"
							SemanticProperties.Description="{localization:Tr Extras.MapPickOnMap}"
							TargetSize="{StaticResource HitIconTight}" />

						<controls:IconButton
							Grid.Column="3"
							Command="{Binding ToggleToFavouriteCommand}"
							TargetSize="{StaticResource HitIconTight}"
							Glyph="{Binding ToStar}"
							InputTransparent="{Binding NoTo}"
							Opacity="{Binding StarOpacityTo}"
							SemanticProperties.Description="{localization:Tr Plan.ToggleFavouriteTo}" />
					</Grid>

					<!--  A stop over is added where it happens: between start and destination  -->
					<BoxView
						Grid.Row="3"
						Grid.ColumnSpan="2"
						HeightRequest="1"
						IsVisible="{Binding NoVia}"
						Color="{DynamicResource Outline}" />

					<HorizontalStackLayout
						Grid.Row="4"
						Grid.ColumnSpan="2"
						Padding="0,2"
						IsVisible="{Binding NoVia}"
						Spacing="8"
						support:Dense.MinHeight="{StaticResource HitButton}"
						support:Motion.Feedback="True"
						SemanticProperties.Description="{localization:Tr Plan.AddVia}">
						<controls:Icon
							Glyph="Plus"
							Size="18"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />
						<Label
							FontFamily="{DynamicResource FontSemibold}"
							FontSize="{StaticResource FontCaption}"
							Text="{localization:Tr Plan.AddVia}"
							TextColor="{DynamicResource Accent}"
							VerticalOptions="Center" />
						<HorizontalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding PickViaCommand}" />
						</HorizontalStackLayout.GestureRecognizers>
					</HorizontalStackLayout>

					<controls:IconButton
						Grid.RowSpan="3"
						Grid.Column="1"
						Clicked="SwapClicked"
						Command="{Binding SwapCommand}"
						Glyph="SwapVertical"
						SemanticProperties.Description="{localization:Tr Plan.SwapDescription}"
						Size="22"
						TargetSize="{StaticResource HitIconTight}"
						VerticalOptions="Center" />

				</Grid>
			</Border>

			<!--  Stop over  -->
			<Border
				Padding="0"
				IsVisible="{Binding HasVia}"
				StyleClass="Card">
				<Grid
					support:Dense.MinHeight="{StaticResource HitRowTight}"
					support:Dense.Padding="12,4"
					ColumnDefinitions="*,38">

					<VerticalStackLayout support:Motion.Feedback="True" Spacing="0" VerticalOptions="Center">
						<Label StyleClass="Caption" Text="{localization:Tr Plan.Via}" />

						<controls:StopNameView Place="{Binding ViaPlace}" Stop="{Binding ViaName}" />

						<VerticalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding PickViaCommand}" />
						</VerticalStackLayout.GestureRecognizers>
					</VerticalStackLayout>

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding ClearViaCommand}"
							TargetSize="{StaticResource HitIconTight}"
						Glyph="Close"
						SemanticProperties.Description="{localization:Tr Plan.ClearVia}" />
				</Grid>
			</Border>

			<!--  Date and time  -->
			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<Grid
						support:Dense.Padding="10,6"
						ColumnDefinitions="*,*"
						ColumnSpacing="{DynamicResource SpaceS}">

						<Button
							Grid.Column="0"
							Command="{Binding DepartCommand}"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							support:Themed.IsOn="{Binding IsDeparture}"
							support:Themed.OnBackground="Accent"
							support:Themed.OnText="OnAccent"
							Text="{localization:Tr Plan.Departure}" />

						<Button
							Grid.Column="1"
							Command="{Binding ArriveCommand}"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							support:Themed.IsOn="{Binding IsArrival}"
							support:Themed.OnBackground="Accent"
							support:Themed.OnText="OnAccent"
							Text="{localization:Tr Plan.Arrival}" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<!--  Date and time share one row while they fit; otherwise the time takes its own row  -->
					<controls:WhenPicker
						Date="{Binding Date}"
						MaximumDate="{Binding MaxDate}"
						MinimumDate="{Binding MinDate}"
						Time="{Binding Time}" />

					<BoxView StyleClass="Divider" />

					<!--  Five steps in one row, whatever the width: the quick steps roll over midnight; Now in the middle  -->
					<Grid
						support:Dense.Padding="10,6"
						ColumnDefinitions="*,*,*,*,*"
						ColumnSpacing="4">

						<Button
							Grid.Column="0"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="-60"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="&#x2212;1 h" />

						<Button
							Grid.Column="1"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="-15"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="&#x2212;15m" />

						<!--  "Now" resets the time: in the middle of the steps, so the row says everything about the moment  -->
						<Button
							Grid.Column="2"
							Padding="0"
							Command="{Binding NowCommand}"
							FontSize="{StaticResource FontCaption}"
							IsEnabled="{Binding IsNotNow}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="{localization:Tr Departures.Now}" />

						<Button
							Grid.Column="3"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="15"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="+15m" />

						<Button
							Grid.Column="4"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="60"
							FontSize="{StaticResource FontCaption}"
							LineBreakMode="NoWrap"
							MinimumWidthRequest="0"
							support:Dense.MinHeight="{StaticResource HitButton}"
							StyleClass="Tonal"
							Text="+1 h" />
					</Grid>

				</VerticalStackLayout>
			</Border>

			<!--  Search; the bookmark of the connection sits next to it: filled when saved, one tap toggles  -->
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource SpaceS}">
				<Button Command="{Binding SearchCommand}" Text="{localization:Tr Plan.SearchJourneys}" />

				<Border
					Grid.Column="1"
					BackgroundColor="{DynamicResource AccentSoft}"
					SemanticProperties.Description="{Binding Bookmark.Description}"
					StrokeShape="RoundRectangle 6"
					StrokeThickness="0"
					WidthRequest="52"
					support:Dense.MinHeight="{StaticResource HitRow}"
					support:Motion.Feedback="True">
					<controls:Icon
						Glyph="{Binding Bookmark.Glyph}"
						HorizontalOptions="Center"
						Size="22"
						VerticalOptions="Center"
						Color="{DynamicResource Accent}" />
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding Bookmark.ToggleCommand}" />
					</Border.GestureRecognizers>
				</Border>
			</Grid>

			<!--  Home  -->
			<Border Padding="0" StyleClass="Card">
				<Grid
					support:Dense.MinHeight="{StaticResource HitRow}"
					support:Dense.Padding="14,6,4,6"
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="12">

					<controls:Icon
						Glyph="Home"
						Size="22"
						VerticalOptions="Center"
						Color="{DynamicResource Accent}" />

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="1"
						VerticalOptions="Center"
						support:Motion.Feedback="True">
						<Label StyleClass="Caption" Text="{localization:Tr Extras.HomeTitle}" />
						<controls:StopNameView
							Muted="{Binding NoHome}"
							Place="{Binding HomePlace}"
							Stop="{Binding HomeName}" />
						<VerticalStackLayout.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding HomeCommand}" />
						</VerticalStackLayout.GestureRecognizers>
					</VerticalStackLayout>

					<controls:IconButton
						Grid.Column="2"
						Command="{Binding SetHomeCommand}"
						Glyph="Edit"
						IsVisible="{Binding HasHome}"
						SemanticProperties.Description="{localization:Tr Plan.SetHome}" />
				</Grid>
			</Border>

			<!--  Saved routes  -->
			<VerticalStackLayout IsVisible="{Binding HasSavedRoutes}" Spacing="{DynamicResource SpaceS}">

				<Label StyleClass="Title" Text="{localization:Tr Plan.SavedRoutes}" />

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding SavedRoutes}">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="core:SavedRoute">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="0">

									<Grid
										support:Motion.Feedback="True"
										support:Dense.Padding="12,8"
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="10"
										support:Dense.MinHeight="{StaticResource HitRow}"
										SemanticProperties.Description="{Binding Name}">

										<controls:Icon
											Margin="0,2,0,0"
											Glyph="Bookmark"
											Size="18"
											VerticalOptions="Start"
											Color="{DynamicResource InkMuted}" />

										<VerticalStackLayout Grid.Column="1" Spacing="3">

											<Label FontFamily="{DynamicResource FontSemibold}" LineBreakMode="TailTruncation" Text="{Binding Name}" />

											<Label StyleClass="Caption" Text="{Binding Description}" />
										</VerticalStackLayout>

										<controls:IconButton
											Grid.Column="2"
											Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, Path=ForgetSavedRouteCommand}"
											CommandParameter="{Binding .}"
											Glyph="Close"
											SemanticProperties.Description="{localization:Tr Plan.ForgetSavedRoute}"
											Size="16"
											VerticalOptions="Center" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, Path=UseSavedRouteCommand}" CommandParameter="{Binding .}" />
										</Grid.GestureRecognizers>
									</Grid>

									<BoxView Grid.Row="1" StyleClass="Divider" />
								</Grid>

							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<!--  Recent searches: tapping a row looks the same connection up again  -->
			<VerticalStackLayout IsVisible="{Binding HasRecentRoutes}" Spacing="{DynamicResource SpaceS}">

				<Grid ColumnDefinitions="*,Auto">

					<Label
						StyleClass="Title"
						Text="{localization:Tr Plan.RecentSearches}"
						VerticalOptions="Center" />

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding ClearRoutesCommand}"
						Glyph="Trash"
						SemanticProperties.Description="{localization:Tr Common.Clear}"
						Size="20" />
				</Grid>

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentRoutes}">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="local:RouteRow">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="0">

									<Grid support:Motion.Feedback="True"
										support:Dense.Padding="12,8"
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="10"
										support:Dense.MinHeight="{StaticResource HitRow}"
										SemanticProperties.Description="{Binding Description}">

										<controls:Icon
											Margin="0,2,0,0"
											Glyph="History"
											Size="18"
											VerticalOptions="Start"
											Color="{DynamicResource InkMuted}" />

										<VerticalStackLayout Grid.Column="1" Spacing="3">

											<controls:StopNameView
												Compact="True"
												Place="{Binding FromPlace}"
												Stop="{Binding FromName}" />

											<controls:StopNameView
												Compact="True"
												Place="{Binding ToPlace}"
												Prefix="&#x2192;"
												Stop="{Binding ToName}" />
										</VerticalStackLayout>

										<controls:IconButton
											Grid.Column="2"
											Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, Path=ForgetRouteCommand}"
											CommandParameter="{Binding .}"
											Glyph="Close"
											SemanticProperties.Description="{localization:Tr Plan.ForgetSearch}"
											Size="16"
											VerticalOptions="Center" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, Path=UseRouteCommand}" CommandParameter="{Binding .}" />
										</Grid.GestureRecognizers>
									</Grid>

									<!--  Hairline between rows (the last one sits on the card border)  -->
									<BoxView Grid.Row="1" StyleClass="Divider" />
								</Grid>

							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</VerticalStackLayout>
				</Border>

				<Button
					Command="{Binding ToggleRoutesCommand}"
					FontSize="{StaticResource FontCaption}"
					HorizontalOptions="Start"
					IsVisible="{Binding CanExpandRoutes}"
					support:Dense.MinHeight="{StaticResource HitButton}"
					Padding="14,0"
					StyleClass="Tonal"
					Text="{Binding RoutesToggleText}" />
			</VerticalStackLayout>

			<!--  Favourites  -->
			<VerticalStackLayout IsVisible="{Binding HasFavourites}" Spacing="{DynamicResource SpaceS}">

				<Label StyleClass="Title" Text="{localization:Tr Plan.Favourites}" />

				<FlexLayout AlignContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding Favourites}" Wrap="Wrap">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="core:Location">
							<Border Margin="0,0,8,8" StyleClass="ChipButton">

								<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

								<Border.GestureRecognizers>
									<TapGestureRecognizer Tapped="PlaceTapped" />
								</Border.GestureRecognizers>

							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>
			</VerticalStackLayout>

			<!--  Recent  -->
			<VerticalStackLayout IsVisible="{Binding HasRecents}" Spacing="{DynamicResource SpaceS}">

				<Grid ColumnDefinitions="*,Auto">

					<Label
						StyleClass="Title"
						Text="{localization:Tr Plan.Recent}"
						VerticalOptions="Center" />

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding ClearRecentsCommand}"
						Glyph="Trash"
						SemanticProperties.Description="{localization:Tr Common.Clear}"
						Size="20" />
				</Grid>

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Recents}">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="core:Location">

								<VerticalStackLayout
									support:Dense.Padding="12,8"
									support:Dense.MinHeight="{StaticResource HitRow}"
									Spacing="1"
									VerticalOptions="Center">

									<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Tapped="PlaceTapped" />
									</VerticalStackLayout.GestureRecognizers>
								</VerticalStackLayout>

							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<Label
				IsVisible="{Binding IsPlacesEmpty}"
				StyleClass="Caption"
				Text="{localization:Tr Plan.PlacesYouSearchForWillAppearHere}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>