<ContentPage
	x:Class="DDjourneys.Pages.PlanPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:core="clr-namespace:DDjourneys.Core.Models;assembly=DDjourneys.Core"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:DataType="local:PlanViewModel"
	Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<toolkit:IsStringNotNullOrWhiteSpaceConverter x:Key="HasText" />
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

			<Grid ColumnDefinitions="*,Auto">
				<Label
					StyleClass="Headline"
					Text="{localization:Tr Plan.Title}"
					VerticalOptions="Center" />

				<HorizontalStackLayout Grid.Column="1" Spacing="0">
					<controls:IconButton
						Clicked="TrackedClicked"
						Glyph="Bell"
						IsVisible="{Binding IsTrackingAvailable}"
						SemanticProperties.Description="{localization:Tr Tracking.FollowedJourneys}" />

					<controls:IconButton
						Clicked="SettingsClicked"
						Glyph="Tune"
						SemanticProperties.Description="{localization:Tr Settings.Title}" />
				</HorizontalStackLayout>
			</Grid>

			<!--  From / To  -->
			<Border StyleClass="Card">
				<Grid
					ColumnDefinitions="*,Auto"
					ColumnSpacing="{DynamicResource SpaceS}"
					RowDefinitions="Auto,Auto,Auto">

					<Grid
						Grid.Row="0"
						ColumnDefinitions="*,44"
						support:Dense.MinHeight="64">

						<VerticalStackLayout support:Motion.Feedback="True" Spacing="2" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.FromPlaceholder}" />

							<controls:StopNameView
								Muted="{Binding NoFrom}"
								Place="{Binding FromPlace}"
								Stop="{Binding FromName}" />

							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="FromTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>

						<controls:IconButton
							Grid.Column="1"
							Command="{Binding ToggleFromFavouriteCommand}"
							Glyph="{Binding FromStar}"
							InputTransparent="{Binding NoFrom}"
							Opacity="{Binding StarOpacityFrom}"
							SemanticProperties.Description="{localization:Tr Plan.ToggleFavouriteFrom}" />
					</Grid>

					<BoxView
						Grid.Row="1"
						HeightRequest="1"
						Color="{DynamicResource Outline}" />

					<Grid
						Grid.Row="2"
						ColumnDefinitions="*,44"
						support:Dense.MinHeight="64">

						<VerticalStackLayout support:Motion.Feedback="True" Spacing="2" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.ToPlaceholder}" />

							<controls:StopNameView
								Muted="{Binding NoTo}"
								Place="{Binding ToPlace}"
								Stop="{Binding ToName}" />

							<VerticalStackLayout.GestureRecognizers>
								<TapGestureRecognizer Tapped="ToTapped" />
							</VerticalStackLayout.GestureRecognizers>
						</VerticalStackLayout>

						<controls:IconButton
							Grid.Column="1"
							Command="{Binding ToggleToFavouriteCommand}"
							Glyph="{Binding ToStar}"
							InputTransparent="{Binding NoTo}"
							Opacity="{Binding StarOpacityTo}"
							SemanticProperties.Description="{localization:Tr Plan.ToggleFavouriteTo}" />
					</Grid>

					<controls:IconButton
						Grid.RowSpan="3"
						Grid.Column="1"
						Clicked="SwapClicked"
						Command="{Binding SwapCommand}"
						Glyph="SwapVertical"
						SemanticProperties.Description="{localization:Tr Plan.SwapDescription}"
						Size="24"
						VerticalOptions="Center" />

				</Grid>
			</Border>

			<!--  Date and time  -->
			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<Grid
						support:Dense.Padding="12,10"
						ColumnDefinitions="*,*"
						ColumnSpacing="{DynamicResource SpaceS}">

						<Button
							Grid.Column="0"
							Command="{Binding DepartCommand}"
							support:Dense.MinHeight="38"
							StyleClass="Tonal"
							support:Themed.IsOn="{Binding IsDeparture}"
							support:Themed.OnBackground="Accent"
							support:Themed.OnText="OnAccent"
							Text="{localization:Tr Plan.Departure}" />

						<Button
							Grid.Column="1"
							Command="{Binding ArriveCommand}"
							support:Dense.MinHeight="38"
							StyleClass="Tonal"
							support:Themed.IsOn="{Binding IsArrival}"
							support:Themed.OnBackground="Accent"
							support:Themed.OnText="OnAccent"
							Text="{localization:Tr Plan.Arrival}" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<!--  Date and time share one row  -->
					<Grid
						x:Name="DateTimeGrid"
						support:Dense.Padding="12,6"
						ColumnDefinitions="*,*"
						ColumnSpacing="12"
						SizeChanged="OnDateTimeGridSizeChanged"
						support:Dense.MinHeight="64">

						<VerticalStackLayout x:Name="DateCell" Spacing="0" VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.Date}" />

							<DatePicker
								x:Name="DatePickerControl"
								Date="{Binding Date}"
								Format="ddd, d MMM"
								HorizontalOptions="Start"
								MaximumDate="{Binding MaxDate}"
								MinimumDate="{Binding MinDate}" />
						</VerticalStackLayout>

						<VerticalStackLayout
							x:Name="TimeCell"
							Grid.Column="1"
							Spacing="0"
							VerticalOptions="Center">
							<Label StyleClass="Caption" Text="{localization:Tr Plan.Time}" />

							<TimePicker
								x:Name="TimePickerControl"
								Format="HH:mm"
								HorizontalOptions="Start"
								Time="{Binding Time}" />
						</VerticalStackLayout>
					</Grid>

					<BoxView StyleClass="Divider" />

					<!--  Quick steps roll over midnight; "Now" resets  -->
					<Grid
						support:Dense.Padding="12,10"
						ColumnDefinitions="*,*,*,*"
						ColumnSpacing="{DynamicResource SpaceS}">

						<Button
							Grid.Column="0"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="-60"
							FontSize="{StaticResource FontCaption}"
							support:Dense.MinHeight="40"
							StyleClass="Tonal"
							Text="&#x2212;1 h" />

						<Button
							Grid.Column="1"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="-15"
							FontSize="{StaticResource FontCaption}"
							support:Dense.MinHeight="40"
							StyleClass="Tonal"
							Text="&#x2212;15" />

						<Button
							Grid.Column="2"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="15"
							FontSize="{StaticResource FontCaption}"
							support:Dense.MinHeight="40"
							StyleClass="Tonal"
							Text="+15" />

						<Button
							Grid.Column="3"
							Padding="0"
							Command="{Binding NudgeCommand}"
							CommandParameter="60"
							FontSize="{StaticResource FontCaption}"
							support:Dense.MinHeight="40"
							StyleClass="Tonal"
							Text="+1 h" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="{DynamicResource SpaceS}">

						<Label
							LineBreakMode="TailTruncation"
							StyleClass="Subtitle"
							VerticalOptions="Center">

							<Label.FormattedText>
								<FormattedString>
									<Span Text="{Binding ModeText}" TextColor="{DynamicResource InkMuted}" />
									<Span Text="  " />
									<Span Text="{Binding WhenText}" TextColor="{DynamicResource Accent}" />
								</FormattedString>
							</Label.FormattedText>
						</Label>

						<!--  Own slot: "Leave now" does not fit a fifth of the row  -->
						<Button
							Grid.Column="1"
							Padding="14,0"
							Command="{Binding NowCommand}"
							FontSize="{StaticResource FontCaption}"
							IsEnabled="{Binding IsNotNow}"
							support:Dense.MinHeight="36"
							StyleClass="Tonal"
							Text="{localization:Tr Plan.LeaveNow}" />
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Button Command="{Binding SearchCommand}" Text="{localization:Tr Plan.SearchJourneys}" />

			<!--  Recent searches: tapping a row looks the same connection up again  -->
			<VerticalStackLayout IsVisible="{Binding HasRecentRoutes}" Spacing="{DynamicResource SpaceS}">

				<Grid ColumnDefinitions="*,Auto">

					<Label
						StyleClass="Title"
						Text="{localization:Tr Plan.RecentSearches}"
						VerticalOptions="Center" />

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding ClearRoutesCommand}"
						Glyph="Trash"
						SemanticProperties.Description="{localization:Tr Common.Clear}"
						Size="20" />
				</Grid>

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentRoutes}">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="local:RouteRow">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="0">

									<Grid support:Motion.Feedback="True"
										support:Dense.Padding="14,10"
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="10"
										support:Dense.MinHeight="56"
										SemanticProperties.Description="{Binding Description}">

										<controls:Icon
											Margin="0,2,0,0"
											Glyph="History"
											Size="18"
											VerticalOptions="Start"
											Color="{DynamicResource InkMuted}" />

										<VerticalStackLayout Grid.Column="1" Spacing="3">

											<controls:StopNameView
												Compact="True"
												Place="{Binding FromPlace}"
												Stop="{Binding FromName}" />

											<controls:StopNameView
												Compact="True"
												Place="{Binding ToPlace}"
												Prefix="&#x2192;"
												Stop="{Binding ToName}" />
										</VerticalStackLayout>

										<controls:IconButton
											Grid.Column="2"
											Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, Path=ForgetRouteCommand}"
											CommandParameter="{Binding .}"
											Glyph="Close"
											SemanticProperties.Description="{localization:Tr Plan.ForgetSearch}"
											Size="16"
											VerticalOptions="Center" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:PlanViewModel}}, Path=UseRouteCommand}" CommandParameter="{Binding .}" />
										</Grid.GestureRecognizers>
									</Grid>

									<!--  Hairline between rows (the last one sits on the card border)  -->
									<BoxView Grid.Row="1" StyleClass="Divider" />
								</Grid>

							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</VerticalStackLayout>
				</Border>

				<Button
					Command="{Binding ToggleRoutesCommand}"
					FontSize="{StaticResource FontCaption}"
					HorizontalOptions="Start"
					IsVisible="{Binding CanExpandRoutes}"
					support:Dense.MinHeight="40"
					Padding="14,0"
					StyleClass="Tonal"
					Text="{Binding RoutesToggleText}" />
			</VerticalStackLayout>

			<!--  Favourites  -->
			<VerticalStackLayout IsVisible="{Binding HasFavourites}" Spacing="{DynamicResource SpaceS}">

				<Label StyleClass="Title" Text="{localization:Tr Plan.Favourites}" />

				<FlexLayout BindableLayout.ItemsSource="{Binding Favourites}" Wrap="Wrap">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="core:Location">
							<Border Margin="0,0,8,8" StyleClass="ChipButton">

								<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

								<Border.GestureRecognizers>
									<TapGestureRecognizer Tapped="PlaceTapped" />
								</Border.GestureRecognizers>

							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>
			</VerticalStackLayout>

			<!--  Recent  -->
			<VerticalStackLayout IsVisible="{Binding HasRecents}" Spacing="{DynamicResource SpaceS}">

				<Grid ColumnDefinitions="*,Auto">

					<Label
						StyleClass="Title"
						Text="{localization:Tr Plan.Recent}"
						VerticalOptions="Center" />

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding ClearRecentsCommand}"
						Glyph="Trash"
						SemanticProperties.Description="{localization:Tr Common.Clear}"
						Size="20" />
				</Grid>

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Recents}">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="core:Location">

								<VerticalStackLayout
									support:Dense.Padding="14,10"
									support:Dense.MinHeight="48"
									Spacing="1"
									VerticalOptions="Center">

									<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />

									<VerticalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Tapped="PlaceTapped" />
									</VerticalStackLayout.GestureRecognizers>
								</VerticalStackLayout>

							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<Label
				IsVisible="{Binding IsPlacesEmpty}"
				StyleClass="Caption"
				Text="{localization:Tr Plan.PlacesYouSearchForWillAppearHere}" />

		</VerticalStackLayout>
	</ScrollView>

</ContentPage>