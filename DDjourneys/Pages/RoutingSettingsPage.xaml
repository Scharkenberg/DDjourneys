<ContentPage
	x:Class="DDjourneys.Pages.RoutingSettingsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Routing.Title}"
	x:DataType="local:RoutingSettingsViewModel">

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceS}">

			<Label StyleClass="Caption" Text="{localization:Tr Routing.Hint}" />

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionModes}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Modes}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ToggleOption">
								<Grid
									support:Dense.Padding="12,8"
									ColumnDefinitions="*,Auto"
									ColumnSpacing="12"
									support:Dense.MinHeight="{StaticResource HitRow}">

									<VerticalStackLayout Spacing="1" VerticalOptions="Center">
										<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
										<Label
											IsVisible="{Binding HasDescription}"
											StyleClass="Caption"
											Text="{Binding Description}" />
									</VerticalStackLayout>

									<Switch
										Grid.Column="1"
										IsToggled="{Binding IsOn}"
										SemanticProperties.Description="{Binding Title}"
										VerticalOptions="Center" />
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionTransfers}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Transfers.Options}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ChoiceOption">
								<Grid support:Motion.Feedback="True"
									support:Dense.Padding="12,8"
									ColumnDefinitions="*,Auto"
									support:Dense.MinHeight="{StaticResource HitRow}">

									<Label
										FontFamily="{DynamicResource FontSemibold}"
										Text="{Binding Title}"
										VerticalOptions="Center" />

									<controls:Icon
										Grid.Column="1"
										Glyph="Check"
										IsVisible="{Binding IsSelected}"
										Size="20"
										VerticalOptions="Center"
										Color="{DynamicResource Accent}" />

									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectCommand}" />
									</Grid.GestureRecognizers>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionVia}" />

			<!--  Stay at the stop over: chips, not a radio list, because nine options must wrap  -->
			<Border Padding="12" StyleClass="Card">
				<VerticalStackLayout Spacing="{DynamicResource SpaceS}">
					<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Routing.ViaMinutes}" />
					<Label StyleClass="Caption" Text="{localization:Tr Routing.ViaMinutesHint}" />
					<FlexLayout AlignContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding ViaStay.Options}" Wrap="Wrap">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ChoiceOption">
								<Border
									Margin="0,0,8,8"
									Padding="12,6"
									StyleClass="ChipButton"
									support:Themed.Background="Clear"
									support:Themed.IsOn="{Binding IsSelected}"
									support:Themed.OnBackground="AccentSoft"
									SemanticProperties.Description="{Binding Title}">
										<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectCommand}" />
									</Border.GestureRecognizers>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</FlexLayout>
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionWalking}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Pace.Options}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ChoiceOption">
								<Grid support:Motion.Feedback="True"
									support:Dense.Padding="12,8"
									ColumnDefinitions="*,Auto"
									support:Dense.MinHeight="{StaticResource HitRow}">

									<Label
										FontFamily="{DynamicResource FontSemibold}"
										Text="{Binding Title}"
										VerticalOptions="Center" />

									<controls:Icon
										Grid.Column="1"
										Glyph="Check"
										IsVisible="{Binding IsSelected}"
										Size="20"
										VerticalOptions="Center"
										Color="{DynamicResource Accent}" />

									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectCommand}" />
									</Grid.GestureRecognizers>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
					<VerticalStackLayout IsVisible="{Binding ShowWalkToStops}">
						<BoxView StyleClass="Divider" />
						<VerticalStackLayout support:Dense.Padding="12,8" Spacing="4">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Routing.Footpath}" />

							<Label StyleClass="Caption" Text="{Binding FootpathText}" />

							<Slider
								Maximum="{x:Static local:RoutingSettingsViewModel.MaxFootpath}"
								Minimum="0"
								SemanticProperties.Description="{localization:Tr Routing.Footpath}"
								Value="{Binding FootpathMinutes}" />
						</VerticalStackLayout>
						<BoxView StyleClass="Divider" />
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Walking}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="support:ToggleOption">
									<Grid
										support:Dense.Padding="12,8"
										ColumnDefinitions="*,Auto"
										ColumnSpacing="12"
										support:Dense.MinHeight="{StaticResource HitRow}">

										<VerticalStackLayout Spacing="1" VerticalOptions="Center">
											<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
											<Label
												IsVisible="{Binding HasDescription}"
												StyleClass="Caption"
												Text="{Binding Description}" />
										</VerticalStackLayout>

										<Switch
											Grid.Column="1"
											IsToggled="{Binding IsOn}"
											SemanticProperties.Description="{Binding Title}"
											VerticalOptions="Center" />
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionAccessibility}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Accessibility.Options}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ChoiceOption">
								<Grid support:Motion.Feedback="True"
									support:Dense.Padding="12,8"
									ColumnDefinitions="*,Auto"
									support:Dense.MinHeight="{StaticResource HitRow}">

									<Label
										FontFamily="{DynamicResource FontSemibold}"
										Text="{Binding Title}"
										VerticalOptions="Center" />

									<controls:Icon
										Grid.Column="1"
										Glyph="Check"
										IsVisible="{Binding IsSelected}"
										Size="20"
										VerticalOptions="Center"
										Color="{DynamicResource Accent}" />

									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectCommand}" />
									</Grid.GestureRecognizers>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionEntrance}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Entrance.Options}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ChoiceOption">
								<Grid support:Motion.Feedback="True"
									support:Dense.Padding="12,8"
									ColumnDefinitions="*,Auto"
									support:Dense.MinHeight="{StaticResource HitRow}">

									<Label
										FontFamily="{DynamicResource FontSemibold}"
										Text="{Binding Title}"
										VerticalOptions="Center" />

									<controls:Icon
										Grid.Column="1"
										Glyph="Check"
										IsVisible="{Binding IsSelected}"
										Size="20"
										VerticalOptions="Center"
										Color="{DynamicResource Accent}" />

									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectCommand}" />
									</Grid.GestureRecognizers>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<VerticalStackLayout IsVisible="{Binding ShowPassenger}" Spacing="{DynamicResource SpaceS}">
				<Label StyleClass="Section" Text="{localization:Tr Routing.SectionTickets}" />

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout>
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Passenger.Options}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="support:ChoiceOption">
									<Grid support:Motion.Feedback="True"
										support:Dense.Padding="12,8"
										ColumnDefinitions="*,Auto"
										support:Dense.MinHeight="{StaticResource HitRow}">

										<Label
											FontFamily="{DynamicResource FontSemibold}"
											Text="{Binding Title}"
											VerticalOptions="Center" />

										<controls:Icon
											Grid.Column="1"
											Glyph="Check"
											IsVisible="{Binding IsSelected}"
											Size="20"
											VerticalOptions="Center"
											Color="{DynamicResource Accent}" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding SelectCommand}" />
										</Grid.GestureRecognizers>
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<VerticalStackLayout IsVisible="{Binding ShowOptimisation}" Spacing="{DynamicResource SpaceS}">
				<Label StyleClass="Section" Text="{localization:Tr Extras.OptSection}" />

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout>
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Optimisation.Options}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="support:ChoiceOption">
									<Grid support:Motion.Feedback="True"
										support:Dense.Padding="12,8"
										ColumnDefinitions="*,Auto"
										support:Dense.MinHeight="{StaticResource HitRow}">

										<Label
											FontFamily="{DynamicResource FontSemibold}"
											Text="{Binding Title}"
											VerticalOptions="Center" />

										<controls:Icon
											Grid.Column="1"
											Glyph="Check"
											IsVisible="{Binding IsSelected}"
											Size="20"
											VerticalOptions="Center"
											Color="{DynamicResource Accent}" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding SelectCommand}" />
										</Grid.GestureRecognizers>
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>
				<Label StyleClass="Caption" Text="{localization:Tr Extras.OptNote}" />
			</VerticalStackLayout>

			<VerticalStackLayout IsVisible="{Binding ShowExtraCharge}" Spacing="{DynamicResource SpaceS}">
				<Label StyleClass="Section" Text="{localization:Tr Routing.SectionExtraCharge}" />

				<Border Padding="0" StyleClass="Card">
					<VerticalStackLayout>
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding ExtraCharge.Options}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="support:ChoiceOption">
									<Grid support:Motion.Feedback="True"
										support:Dense.Padding="12,8"
										ColumnDefinitions="*,Auto"
										support:Dense.MinHeight="{StaticResource HitRow}">

										<Label
											FontFamily="{DynamicResource FontSemibold}"
											Text="{Binding Title}"
											VerticalOptions="Center" />

										<controls:Icon
											Grid.Column="1"
											Glyph="Check"
											IsVisible="{Binding IsSelected}"
											Size="20"
											VerticalOptions="Center"
											Color="{DynamicResource Accent}" />

										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding SelectCommand}" />
										</Grid.GestureRecognizers>
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<Label StyleClass="Section" Text="{localization:Tr Routing.SectionMore}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding More}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="support:ToggleOption">
								<Grid
									support:Dense.Padding="12,8"
									ColumnDefinitions="*,Auto"
									ColumnSpacing="12"
									support:Dense.MinHeight="{StaticResource HitRow}">

									<VerticalStackLayout Spacing="1" VerticalOptions="Center">
										<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
										<Label
											IsVisible="{Binding HasDescription}"
											StyleClass="Caption"
											Text="{Binding Description}" />
									</VerticalStackLayout>

									<Switch
										Grid.Column="1"
										IsToggled="{Binding IsOn}"
										SemanticProperties.Description="{Binding Title}"
										VerticalOptions="Center" />
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Button
				Margin="0,8,0,0"
				Command="{Binding ResetCommand}"
				StyleClass="Tonal"
				Text="{localization:Tr Routing.Reset}" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
