<support:PanePage
	x:Class="DDjourneys.Pages.MapPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Extras.MapTitle}">

	<Grid>
		<controls:MapView x:Name="Map" />

		<!--  What to do here: zoom in for stops, or tap to pick (not interactive)  -->
		<Border
			x:Name="Hint"
			Margin="12,8"
			Padding="12,6"
			BackgroundColor="{DynamicResource Surface}"
			HorizontalOptions="Center"
			InputTransparent="True"
			IsVisible="False"
			Opacity="0.95"
			Stroke="{DynamicResource Outline}"
			StrokeShape="RoundRectangle 100"
			StrokeThickness="1"
			VerticalOptions="Start">
			<Label
				x:Name="HintLabel"
				FontSize="{DynamicResource FontCaption}"
				HorizontalTextAlignment="Center"
				TextColor="{DynamicResource InkMuted}" />
		</Border>

		<!--  B4: the diversions note of a line course (the active route changes of its line)  -->
		<Border
			x:Name="Notice"
			Margin="12,12,12,44"
			Padding="12,8"
			BackgroundColor="{DynamicResource Surface}"
			InputTransparent="True"
			IsVisible="False"
			Opacity="0.95"
			Stroke="{DynamicResource Outline}"
			StrokeShape="RoundRectangle 16"
			StrokeThickness="1"
			VerticalOptions="End">
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
				<controls:Icon
					Glyph="Warning"
					Size="18"
					VerticalOptions="Center"
					Color="{DynamicResource Delay}" />
				<Label
					x:Name="NoticeText"
					Grid.Column="1"
					FontSize="{DynamicResource FontCaption}"
					LineBreakMode="TailTruncation"
					MaxLines="5"
					TextColor="{DynamicResource Ink}"
					VerticalOptions="Center" />
			</Grid>
		</Border>
	</Grid>
</support:PanePage>
