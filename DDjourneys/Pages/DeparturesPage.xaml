<support:PanePage
	x:Class="DDjourneys.Pages.DeparturesPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:core="clr-namespace:DDjourneys.Core.Models;assembly=DDjourneys.Core"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Departures.Title}"
	x:DataType="local:DeparturesViewModel">

	<!--  The stop and the choice between departures and arrivals stay where they are; only the list below them scrolls  -->
	<Grid RowDefinitions="Auto,*" RowSpacing="0">

		<VerticalStackLayout Padding="12,8,12,0" Spacing="6">

			<!--  Stop: one slim line  -->
			<Border Padding="0" StyleClass="Card">
				<Grid
					support:Dense.Padding="12,4"
					support:Dense.MinHeight="{StaticResource HitRowTight}"
					ColumnDefinitions="*,Auto,Auto,Auto"
					ColumnSpacing="0"
					SemanticProperties.Description="{localization:Tr Departures.Stop}">

					<controls:StopNameView
						x:Name="StopLine"
						Compact="True"
						Place="{Binding StopPlace}"
						SingleLine="True"
						Stop="{Binding StopName}"
						VerticalOptions="Center" />

					<controls:IconButton
						Grid.Column="1"
						Command="{Binding LocateCommand}"
						Glyph="Locate"
						SemanticProperties.Description="{localization:Tr Departures.UseMyLocation}"
						TargetSize="{StaticResource HitIconTight}" />

					<controls:IconButton
						Grid.Column="2"
						Clicked="MapClicked"
						Glyph="Map"
						SemanticProperties.Description="{localization:Tr Extras.MapPickOnMap}"
						TargetSize="{StaticResource HitIconTight}" />

					<controls:IconButton
						Grid.Column="3"
						Command="{Binding RefreshCommand}"
						Glyph="Refresh"
						IsVisible="{Binding HasStop}"
						SemanticProperties.Description="{localization:Tr Departures.Refresh}"
						TargetSize="{StaticResource HitIconTight}" />

					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding PickStopCommand}" />
					</Grid.GestureRecognizers>
				</Grid>
			</Border>

			<Label
				IsVisible="{Binding HasZone}"
				StyleClass="Caption"
				Text="{Binding ZoneText}" />

			<!--  Departures / arrivals / now: one slim row  -->
			<Grid
				ColumnDefinitions="*,*,Auto"
				ColumnSpacing="{DynamicResource SpaceS}"
				IsVisible="{Binding HasStop}">
				<Button
					Command="{Binding DepartCommand}"
					support:Dense.MinHeight="{StaticResource HitButton}"
					StyleClass="Tonal"
					support:Themed.IsOn="{Binding IsDeparture}"
					support:Themed.OnBackground="Accent"
					support:Themed.OnText="OnAccent"
					Text="{localization:Tr Departures.DeparturesTab}" />
				<Button
					Grid.Column="1"
					Command="{Binding ArriveCommand}"
					support:Dense.MinHeight="{StaticResource HitButton}"
					StyleClass="Tonal"
					support:Themed.IsOn="{Binding IsArrival}"
					support:Themed.OnBackground="Accent"
					support:Themed.OnText="OnAccent"
					Text="{localization:Tr Departures.ArrivalsTab}" />
				<Button
					Grid.Column="2"
					Padding="14,0"
					Command="{Binding NowCommand}"
					IsEnabled="{Binding IsNotNow}"
					support:Dense.MinHeight="{StaticResource HitButton}"
					StyleClass="Tonal"
					Text="{localization:Tr Departures.Now}" />
			</Grid>

			<BoxView Margin="-12,2,-12,0" StyleClass="Divider" />
		</VerticalStackLayout>

		<RefreshView
			Grid.Row="1"
			Command="{Binding RefreshCommand}"
			IsRefreshing="{Binding IsBusy}">
			<ScrollView>
				<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceM}">

					<!--  The moment  -->
					<Border
						Padding="0"
						IsVisible="{Binding HasStop}"
						StyleClass="Card">
						<controls:WhenPicker Date="{Binding Date}" Time="{Binding Time}" />
					</Border>

					<Label
						HorizontalTextAlignment="Center"
						IsVisible="{Binding HasMessage}"
						StyleClass="Caption"
						Text="{Binding Message}" />

				<!--  Departure rows  -->
				<Border Padding="0" StyleClass="Card">
					<Border.Triggers>
						<DataTrigger
							Binding="{Binding Rows.Count}"
							TargetType="Border"
							Value="0">
							<Setter Property="IsVisible" Value="False" />
						</DataTrigger>
					</Border.Triggers>

					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="local:DepartureRow">
								<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
									<Grid
										support:Dense.Padding="12,8"
										support:Dense.MinHeight="{StaticResource HitRow}"
										support:Motion.Feedback="True"
										ColumnDefinitions="68,*,Auto"
										ColumnSpacing="10"
										SemanticProperties.Description="{Binding Description}">

										<Border
											BackgroundColor="{Binding Look.Fill}"
											StrokeDashArray="{Binding Look.Dashes}"
											StrokeShape="{Binding Look.Shape}"
											StrokeThickness="{Binding Look.StrokeThickness}"
											StyleClass="Chip"
											Stroke="{Binding Look.Stroke}"
											HorizontalOptions="Start"
											VerticalOptions="Center"
											WidthRequest="68">
											<support:PillScroll>
												<Label
													FontFamily="{DynamicResource FontSemibold}"
													FontSize="{StaticResource FontCaption}"
													StyleClass="ChipLabel"
													Text="{Binding LineText}"
													TextColor="{Binding Look.Text}" />
											</support:PillScroll>
										</Border>

										<VerticalStackLayout
											Grid.Column="1"
											Spacing="1"
											VerticalOptions="Center">
											<Label
												LineBreakMode="TailTruncation"
												Text="{Binding Direction}" />
											<HorizontalStackLayout Spacing="8">
												<Label
													IsVisible="{Binding HasPlatform}"
													StyleClass="Caption"
													Text="{Binding PlatformText}" />
												<Label
													IsVisible="{Binding IsCancelled}"
													StyleClass="Cancelled"
													Text="{localization:Tr Departures.Cancelled}" />
												<controls:OccupancyIndicator
													IsVisible="{Binding HasOccupancy}"
													Level="{Binding Occupancy}"
													VerticalOptions="Center" />
											</HorizontalStackLayout>
										</VerticalStackLayout>

										<HorizontalStackLayout
											Grid.Column="2"
											Spacing="4"
											VerticalOptions="Center">

											<!--  Route changes: before the time, so the times stay in one column on the right  -->
											<controls:IconButton
												Command="{Binding Source={RelativeSource AncestorType={x:Type local:DeparturesViewModel}}, x:DataType=local:DeparturesViewModel, Path=OpenChangesCommand}"
												CommandParameter="{Binding .}"
												Glyph="Warning"
												IsVisible="{Binding HasChanges}"
												SemanticProperties.Description="{localization:Tr Departures.RouteChanges}" />

											<VerticalStackLayout Spacing="0" HorizontalOptions="End">
												<Label
													FontFamily="{DynamicResource FontSemibold}"
													HorizontalTextAlignment="End"
													Text="{Binding TimeText}" />
												<Label
													HorizontalTextAlignment="End"
													IsVisible="{Binding HasDelay}"
													StyleClass="Caption"
													Text="{Binding DelayText}" />
												<Label
													HorizontalTextAlignment="End"
													IsVisible="{Binding HasIn}"
													StyleClass="Caption"
													Text="{Binding InText}" />
											</VerticalStackLayout>
										</HorizontalStackLayout>

										<Grid.GestureRecognizers>
											<TapGestureRecognizer
												Command="{Binding Source={RelativeSource AncestorType={x:Type local:DeparturesViewModel}}, x:DataType=local:DeparturesViewModel, Path=OpenRunCommand}"
												CommandParameter="{Binding .}" />
										</Grid.GestureRecognizers>
									</Grid>

									<BoxView Grid.Row="1" StyleClass="Divider" />
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</Border>

				<!--  Nearby stops  -->
				<VerticalStackLayout IsVisible="{Binding HasNearby}" Spacing="{DynamicResource SpaceS}">
					<Label StyleClass="Title" Text="{localization:Tr Departures.Nearby}" />
					<Border Padding="0" StyleClass="Card">
						<VerticalStackLayout BindableLayout.ItemsSource="{Binding Nearby}">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="local:NearbyRow">
									<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
										<Grid
											support:Dense.Padding="12,8"
											support:Dense.MinHeight="{StaticResource HitRow}"
											support:Motion.Feedback="True"
											ColumnDefinitions="*,Auto"
											ColumnSpacing="10">
											<controls:StopNameView
												Place="{Binding Place}"
												Stop="{Binding Name}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												StyleClass="Caption"
												Text="{Binding DistanceText}"
												VerticalOptions="Center" />
											<Grid.GestureRecognizers>
												<TapGestureRecognizer
													Command="{Binding Source={RelativeSource AncestorType={x:Type local:DeparturesViewModel}}, x:DataType=local:DeparturesViewModel, Path=SelectNearbyCommand}"
													CommandParameter="{Binding .}" />
											</Grid.GestureRecognizers>
										</Grid>
										<BoxView Grid.Row="1" StyleClass="Divider" />
									</Grid>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

				<!--  Around this stop: where to go next, and what can be unfolded. Every row says what it holds.  -->
				<VerticalStackLayout IsVisible="{Binding HasStop}" Spacing="{DynamicResource SpaceS}">
					<Label StyleClass="Section" Text="{localization:Tr Extras.AroundTitle}" />

					<Border Padding="0" StyleClass="Card">
						<VerticalStackLayout>

							<controls:SectionRow
								Command="{Binding OpenMapCommand}"
								Glyph="Map"
								Summary="{localization:Tr Extras.MapSummary}"
								Title="{localization:Tr Extras.MapShow}" />
							<BoxView StyleClass="Divider" />

							<controls:SectionRow
								x:Name="LiveRow"
								Glyph="Pulse"
								Summary="{localization:Tr Extras.LiveSummary}"
								Title="{localization:Tr Extras.LiveTitle}" />
							<BoxView StyleClass="Divider" />

							<!--  Lines  -->
							<controls:SectionRow
								Command="{Binding ToggleLinesCommand}"
								Glyph="Bus"
								IsExpandable="True"
								IsExpanded="{Binding ShowLines}"
								Summary="{Binding LinesSummary}"
								Title="{localization:Tr Extras.LinesTitle}" />
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}" IsVisible="{Binding ShowLines}">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="local:StopLineRow">
										<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
											<BoxView StyleClass="Divider" />
											<Grid
												Grid.Row="1"
												support:Dense.Padding="12,8"
												ColumnDefinitions="68,*"
												ColumnSpacing="10">
												<Border
													BackgroundColor="{Binding Look.Fill}"
													StrokeDashArray="{Binding Look.Dashes}"
													StrokeShape="{Binding Look.Shape}"
													StrokeThickness="{Binding Look.StrokeThickness}"
													StyleClass="Chip"
													Stroke="{Binding Look.Stroke}"
													HorizontalOptions="Start"
													VerticalOptions="Start"
													WidthRequest="68">
													<support:PillScroll>
														<Label
															FontFamily="{DynamicResource FontSemibold}"
															FontSize="{StaticResource FontCaption}"
															StyleClass="ChipLabel"
															Text="{Binding LineText}"
															TextColor="{Binding Look.Text}" />
													</support:PillScroll>
												</Border>
												<Label
													Grid.Column="1"
													StyleClass="Caption"
													Text="{Binding DirectionsText}" />
											</Grid>
										</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
							<BoxView StyleClass="Divider" />

							<!--  Accessibility of the chosen stop (open data)  -->
							<controls:SectionRow
								Command="{Binding ToggleAccessibilityCommand}"
								Glyph="Accessible"
								IsExpandable="True"
								IsExpanded="{Binding ShowAccessibility}"
								Summary="{localization:Tr Extras.AccessHint}"
								Title="{localization:Tr Extras.AccessTitle}" />
							<VerticalStackLayout IsVisible="{Binding ShowAccessibility}">
								<Label
									Margin="14,0,14,10"
									IsVisible="{Binding HasAccessibilityMessage}"
									StyleClass="Caption"
									Text="{Binding AccessibilityMessage}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding Accessibility}">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="local:AccessRow">
											<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
												<BoxView StyleClass="Divider" />
												<VerticalStackLayout
													Grid.Row="1"
													support:Dense.Padding="12,8"
													Spacing="2">
													<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Title}" />
													<Label StyleClass="Caption" Text="{Binding Details}" />
												</VerticalStackLayout>
											</Grid>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</VerticalStackLayout>
							<BoxView StyleClass="Divider" />

							<!--  DVB service points near the stop or the passenger (open data)  -->
							<controls:SectionRow
								Command="{Binding ToggleServicePointsCommand}"
								Glyph="MapPin"
								IsExpandable="True"
								IsExpanded="{Binding ShowServicePoints}"
								Summary="{Binding ServicePointsSummary}"
								Title="{localization:Tr Extras.ServiceTitle}" />
							<VerticalStackLayout IsVisible="{Binding ShowServicePoints}">
								<Label
									Margin="14,0,14,10"
									IsVisible="{Binding HasServicePointsMessage}"
									StyleClass="Caption"
									Text="{Binding ServicePointsMessage}" />
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding ServicePoints}">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="local:ServicePointRow">
											<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
												<BoxView StyleClass="Divider" />
												<Grid
													Grid.Row="1"
													support:Dense.Padding="12,8"
													support:Motion.Feedback="True"
													ColumnDefinitions="*,Auto"
													ColumnSpacing="10">
													<VerticalStackLayout Spacing="2">
														<Label FontFamily="{DynamicResource FontSemibold}" Text="{Binding Name}" />
														<Label
															IsVisible="{Binding HasDetails}"
															StyleClass="Caption"
															Text="{Binding Details}" />
													</VerticalStackLayout>
													<Label
														Grid.Column="1"
														StyleClass="Caption"
														Text="{Binding DistanceText}"
														VerticalOptions="Start" />
													<Grid.GestureRecognizers>
														<TapGestureRecognizer
															Command="{Binding Source={RelativeSource AncestorType={x:Type local:DeparturesViewModel}}, x:DataType=local:DeparturesViewModel, Path=OpenServicePointCommand}"
															CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>
												</Grid>
											</Grid>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>
				</VerticalStackLayout>

				<!--  Favourites and recent stops, until one is chosen  -->
				<VerticalStackLayout IsVisible="{Binding ShowQuickPicks}" Spacing="{DynamicResource SpaceS}">
					<Label StyleClass="Title" Text="{localization:Tr Plan.Recent}" />
					<FlexLayout AlignContent="Start" AlignItems="Start" BindableLayout.ItemsSource="{Binding QuickPicks}" Wrap="Wrap">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="core:Location">
								<Border Margin="0,0,8,8" StyleClass="ChipButton">
									<controls:StopNameView Place="{Binding Place}" Stop="{Binding Name}" />
									<Border.GestureRecognizers>
										<TapGestureRecognizer
											Command="{Binding Source={RelativeSource AncestorType={x:Type local:DeparturesViewModel}}, x:DataType=local:DeparturesViewModel, Path=SelectStopCommand}"
											CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</FlexLayout>
				</VerticalStackLayout>

				<Label
					HorizontalTextAlignment="Center"
					IsVisible="{Binding ShowHint}"
					StyleClass="Caption"
					Text="{localization:Tr Departures.Hint}" />

				<Label
					HorizontalTextAlignment="Center"
					IsVisible="{Binding HasStop}"
					StyleClass="Caption"
					Text="{Binding UpdatedText}" />

			</VerticalStackLayout>
		</ScrollView>
		</RefreshView>
	</Grid>
</support:PanePage>
