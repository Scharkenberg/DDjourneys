<ContentPage
	x:Class="DDjourneys.Pages.SettingsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Settings.Title}"
	x:DataType="local:SettingsViewModel">

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceS}">

			<Label StyleClass="Section" Text="{localization:Tr Settings.Theme}" />

			<Border Padding="0" StyleClass="Card">
				<Grid
					support:Dense.MinHeight="{StaticResource HitRow}"
					support:Dense.Padding="12,8"
					support:Motion.Feedback="True"
					ColumnDefinitions="*,Auto"
					ColumnSpacing="10">
					<VerticalStackLayout Spacing="1" VerticalOptions="Center">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.AppearanceTitle}" />
						<Label
							LineBreakMode="TailTruncation"
							StyleClass="Caption"
							Text="{Binding AppearanceSummary}" />
					</VerticalStackLayout>

					<controls:Icon
						Grid.Column="1"
						Glyph="ChevronRight"
						Size="20"
						VerticalOptions="Center"
						Color="{DynamicResource InkMuted}" />

					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding OpenAppearanceCommand}" />
					</Grid.GestureRecognizers>
				</Grid>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Settings.Language}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailableLanguages}">

					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="localization:LocalizationPack">
							<Grid
								support:Dense.MinHeight="{StaticResource HitRow}"
								support:Dense.Padding="12,8"
								support:Motion.Feedback="True"
								ColumnDefinitions="*,Auto">

								<Label
									FontFamily="{DynamicResource FontSemibold}"
									Text="{Binding DisplayName}"
									VerticalOptions="Center" />

								<controls:Icon
									Grid.Column="1"
									Glyph="Check"
									IsVisible="{Binding IsSelected}"
									Size="20"
									VerticalOptions="Center"
									Color="{DynamicResource Accent}" />

								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:SettingsViewModel}}, x:DataType=local:SettingsViewModel, Path=SelectLanguageCommand}" CommandParameter="{Binding Code}" />
								</Grid.GestureRecognizers>
							</Grid>
						</DataTemplate>
					</BindableLayout.ItemTemplate>

				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Settings.Appearance}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.Animations}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.AnimationsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding Animations}"
							SemanticProperties.Description="{localization:Tr Settings.Animations}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.TechnicalDetails}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.TechnicalDetailsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ShowTechnicalDetails}"
							SemanticProperties.Description="{localization:Tr Settings.TechnicalDetails}"
							VerticalOptions="Center" />
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Settings.MapSection}" />

			<!--  Which library draws the map: CARTO vector (needs a key and WebGL 2) or Leaflet raster (anything)  -->
			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<VerticalStackLayout support:Dense.Padding="12,8" Spacing="1">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.MapEngineTitle}" />
						<Label StyleClass="Caption" Text="{localization:Tr Settings.MapEngineDescription}" />
					</VerticalStackLayout>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						support:Motion.Feedback="True"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.MapEngineCarto}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.MapEngineCartoDescription}" />
						</VerticalStackLayout>

						<controls:Icon
							Grid.Column="1"
							Glyph="Check"
							IsVisible="{Binding MapEngineIsCarto}"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding SelectMapEngineCommand}" CommandParameter="carto" />
						</Grid.GestureRecognizers>
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						support:Motion.Feedback="True"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.MapEngineLeaflet}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.MapEngineLeafletDescription}" />
						</VerticalStackLayout>

						<controls:Icon
							Grid.Column="1"
							Glyph="Check"
							IsVisible="{Binding MapEngineIsLeaflet}"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding SelectMapEngineCommand}" CommandParameter="leaflet" />
						</Grid.GestureRecognizers>
					</Grid>

				</VerticalStackLayout>
			</Border>

			<!--  The basemap needs the user's own CARTO key; without a usable one the map stays off  -->
			<Border
				Padding="0"
				IsVisible="{Binding MapEngineIsCarto}"
				StyleClass="Card">
				<VerticalStackLayout support:Dense.Padding="12,8" Spacing="6">
					<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.MapKeyTitle}" />
					<Label StyleClass="Caption" Text="{localization:Tr Settings.MapKeyDescription}" />

					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<Entry
							ClearButtonVisibility="WhileEditing"
							Placeholder="{localization:Tr Settings.MapKeyPlaceholder}"
							ReturnType="Done"
							SemanticProperties.Description="{localization:Tr Settings.MapKeyTitle}"
							Text="{Binding MapKeyDraft}"
							VerticalOptions="Center" />
						<Button
							Grid.Column="1"
							Command="{Binding SaveMapKeyCommand}"
							StyleClass="Tonal"
							Text="{localization:Tr Settings.MapKeySave}"
							VerticalOptions="Center" />
					</Grid>

					<Label StyleClass="Faint" Text="{Binding MapKeyStatus}" />
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Settings.JourneyOptions}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<!--  Provider: opens the list of data providers  -->
					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						support:Motion.Feedback="True"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="10">
						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Provider.Title}" />
							<Label
								LineBreakMode="TailTruncation"
								StyleClass="Caption"
								Text="{Binding ProviderText}" />
						</VerticalStackLayout>

						<controls:Icon
							Grid.Column="1"
							Glyph="ChevronRight"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource InkMuted}" />

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding OpenProvidersCommand}" />
						</Grid.GestureRecognizers>
					</Grid>

					<BoxView StyleClass="Divider" />

					<VerticalStackLayout support:Dense.Padding="12,8" Spacing="4">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.Results}" />

						<Label StyleClass="Caption" Text="{Binding MaxResultsText}" />

						<Slider
							Maximum="{x:Static local:SettingsViewModel.MaxResultsLimit}"
							Minimum="{x:Static local:SettingsViewModel.MinResults}"
							SemanticProperties.Description="{localization:Tr Settings.Results}"
							Value="{Binding MaxResults}" />
					</VerticalStackLayout>

					<BoxView StyleClass="Divider" />

					<VerticalStackLayout support:Dense.Padding="12,8" Spacing="4">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.LeadMinutes}" />

						<Label StyleClass="Caption" Text="{Binding LeadText}" />

						<Slider
							Maximum="60"
							Minimum="1"
							SemanticProperties.Description="{localization:Tr Settings.LeadMinutes}"
							Value="{Binding LeadMinutes}" />
					</VerticalStackLayout>

					<BoxView StyleClass="Divider" />

					<VerticalStackLayout support:Dense.Padding="12,8" Spacing="4">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.RequestTimeout}" />

						<Label StyleClass="Caption" Text="{Binding TimeoutText}" />

						<Slider
							Maximum="60"
							Minimum="5"
							SemanticProperties.Description="{localization:Tr Settings.RequestTimeout}"
							Value="{Binding TimeoutSeconds}" />
					</VerticalStackLayout>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.ArriveBy}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.ArriveByDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding DefaultArrival}"
							SemanticProperties.Description="{localization:Tr Settings.ArriveBy}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.WalkingLegs}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.WalkingLegsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ShowWalkingLegs}"
							SemanticProperties.Description="{localization:Tr Settings.WalkingLegs}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.ExpandNotices}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.ExpandNoticesDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ExpandNotices}"
							SemanticProperties.Description="{localization:Tr Settings.ExpandNotices}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						support:Motion.Feedback="True"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="10">
						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.RoutingEntry}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.RoutingEntryDescription}" />
						</VerticalStackLayout>

						<controls:Icon
							Grid.Column="1"
							Glyph="ChevronRight"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource InkMuted}" />

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding OpenRoutingCommand}" />
						</Grid.GestureRecognizers>
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						support:Motion.Feedback="True"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="10">
						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.StartEntry}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.StartEntryDescription}" />
						</VerticalStackLayout>

						<controls:Icon
							Grid.Column="1"
							Glyph="ChevronRight"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource InkMuted}" />

						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding OpenStartCommand}" />
						</Grid.GestureRecognizers>
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr PlaceSearch.Title}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Extras.SearchAddresses}" />
							<Label StyleClass="Caption" Text="{localization:Tr Extras.SearchAddressesDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding SearchAddresses}"
							SemanticProperties.Description="{localization:Tr Extras.SearchAddresses}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Extras.SearchPois}" />
							<Label StyleClass="Caption" Text="{localization:Tr Extras.SearchPoisDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding SearchPois}"
							SemanticProperties.Description="{localization:Tr Extras.SearchPois}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Extras.ExactPosition}" />
							<Label StyleClass="Caption" Text="{localization:Tr Extras.ExactPositionDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ExactPosition}"
							SemanticProperties.Description="{localization:Tr Extras.ExactPosition}"
							VerticalOptions="Center" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Settings.JourneyDisplay}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.Occupancy}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.OccupancyDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ShowOccupancy}"
							SemanticProperties.Description="{localization:Tr Settings.Occupancy}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.Platforms}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.PlatformsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ShowPlatforms}"
							SemanticProperties.Description="{localization:Tr Settings.Platforms}"
							VerticalOptions="Center" />
					</Grid>

					<BoxView StyleClass="Divider" />

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.ExpandStops}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.ExpandStopsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding ExpandStops}"
							SemanticProperties.Description="{localization:Tr Settings.ExpandStops}"
							VerticalOptions="Center" />
					</Grid>

				</VerticalStackLayout>
			</Border>

			<Label StyleClass="Section" Text="{localization:Tr Settings.PlaceSearch}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<VerticalStackLayout support:Dense.Padding="12,8" Spacing="4">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.SearchDelay}" />

						<Label StyleClass="Caption" Text="{Binding SearchDelayText}" />

						<Slider
							Maximum="{x:Static local:SettingsViewModel.MaxSearchDelay}"
							Minimum="{x:Static local:SettingsViewModel.MinSearchDelay}"
							SemanticProperties.Description="{localization:Tr Settings.SearchDelay}"
							Value="{Binding SearchDelayMs}" />
					</VerticalStackLayout>

					<BoxView StyleClass="Divider" />

					<VerticalStackLayout support:Dense.Padding="12,8" Spacing="4">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.MinQueryLength}" />

						<Label StyleClass="Caption" Text="{Binding MinQueryLengthText}" />

						<Slider
							Maximum="{x:Static local:SettingsViewModel.MinQueryLengthCeiling}"
							Minimum="{x:Static local:SettingsViewModel.MinQueryLengthFloor}"
							SemanticProperties.Description="{localization:Tr Settings.MinQueryLength}"
							Value="{Binding MinQueryLength}" />
					</VerticalStackLayout>

				</VerticalStackLayout>
			</Border>

			<Button
				Margin="0,8,0,0"
				Command="{Binding ResetCommand}"
				StyleClass="Tonal"
				Text="{localization:Tr Settings.ResetJourneySettings}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout>

					<Grid
						support:Dense.MinHeight="{StaticResource HitRow}"
						support:Dense.Padding="12,8"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="12">

						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.DeveloperOptions}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.DeveloperOptionsDescription}" />
						</VerticalStackLayout>

						<Switch
							Grid.Column="1"
							IsToggled="{Binding DeveloperOptions}"
							SemanticProperties.Description="{localization:Tr Settings.DeveloperOptions}"
							VerticalOptions="Center" />
					</Grid>

					<VerticalStackLayout IsVisible="{Binding DeveloperOptions}">

						<BoxView StyleClass="Divider" />

						<Grid
							support:Dense.MinHeight="{StaticResource HitRow}"
							support:Dense.Padding="12,8"
							ColumnDefinitions="*,Auto"
							ColumnSpacing="12">

							<VerticalStackLayout Spacing="1" VerticalOptions="Center">
								<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.ExpertView}" />
								<Label StyleClass="Caption" Text="{localization:Tr Settings.ExpertViewDescription}" />
							</VerticalStackLayout>

							<Switch
								Grid.Column="1"
								IsToggled="{Binding ExpertView}"
								SemanticProperties.Description="{localization:Tr Settings.ExpertView}"
								VerticalOptions="Center" />
						</Grid>

						<BoxView StyleClass="Divider" />

						<Grid
							support:Dense.MinHeight="{StaticResource HitRow}"
							support:Dense.Padding="12,8"
							ColumnDefinitions="*,Auto"
							ColumnSpacing="12">

							<VerticalStackLayout Spacing="1" VerticalOptions="Center">
								<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.LogToFile}" />
								<Label StyleClass="Caption" Text="{localization:Tr Settings.LogToFileDescription}" />
							</VerticalStackLayout>

							<Switch
								Grid.Column="1"
								IsToggled="{Binding LogToFile}"
								SemanticProperties.Description="{localization:Tr Settings.LogToFile}"
								VerticalOptions="Center" />
						</Grid>

						<VerticalStackLayout IsVisible="{Binding HasLog}">
							<BoxView StyleClass="Divider" />

							<Label
								Margin="12,8,12,0"
								LineBreakMode="CharacterWrap"
								StyleClass="Faint"
								Text="{Binding LogInfo}" />

							<FlexLayout
								support:Dense.Padding="12,8"
								AlignContent="Start"
								AlignItems="Start"
								Wrap="Wrap">
								<Button
									Margin="0,4,8,4"
									Command="{Binding ShareLogCommand}"
									StyleClass="Tonal"
									Text="{localization:Tr Settings.ShareLog}" />
								<Button
									Margin="0,4,0,4"
									Command="{Binding ClearLogCommand}"
									StyleClass="Tonal"
									Text="{localization:Tr Settings.ClearLog}" />
							</FlexLayout>
						</VerticalStackLayout>

						<BoxView StyleClass="Divider" />

						<VerticalStackLayout support:Dense.Padding="12,8" Spacing="6">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.InterfaceVersions}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.InterfaceVersionsDescription}" />
							<Label
								FontSize="{StaticResource FontMicro}"
								LineBreakMode="CharacterWrap"
								Text="{Binding InterfaceReport}" />
							<Button
								Margin="0,4,0,4"
								Command="{Binding CopyInterfacesCommand}"
								HorizontalOptions="Start"
								StyleClass="Tonal"
								Text="{localization:Tr Settings.CopyInterfaces}" />
						</VerticalStackLayout>

					</VerticalStackLayout>

				</VerticalStackLayout>
			</Border>

			<Border Padding="0" StyleClass="Card">
				<Grid
					support:Dense.MinHeight="{StaticResource HitRow}"
					support:Dense.Padding="12,8"
					support:Motion.Feedback="True"
					ColumnDefinitions="*,Auto"
					ColumnSpacing="10"
					SemanticProperties.Description="{localization:Tr Settings.About}">
					<VerticalStackLayout Spacing="1" VerticalOptions="Center">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.About}" />
						<Label StyleClass="Caption" Text="{localization:Tr Settings.AboutEntryDescription}" />
					</VerticalStackLayout>

					<controls:Icon
						Grid.Column="1"
						Glyph="Info"
						Size="20"
						VerticalOptions="Center"
						Color="{DynamicResource InkMuted}" />

					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
					</Grid.GestureRecognizers>
				</Grid>
			</Border>

			<Label
				Margin="0,8"
				HorizontalOptions="Center"
				StyleClass="Caption"
				Text="{Binding Version}" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>