<ContentPage
	xmlns:support="clr-namespace:DDjourneys.Support"
	x:Class="DDjourneys.Pages.PlaceSearchPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr PlaceSearch.Title}"
	x:DataType="local:PlaceSearchViewModel">

	<ContentPage.Resources>
		<DataTemplate x:Key="PlaceRow" x:DataType="local:PlaceRow">
			<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
				<VerticalStackLayout
					support:Dense.Padding="14,10"
					support:Dense.MinHeight="48"
					Spacing="2"
					VerticalOptions="Center">
					<controls:StopNameView Place="{Binding Detail}" Stop="{Binding Name}" />
					<Label
						IsVisible="{Binding HasKind}"
						StyleClass="Caption"
						Text="{Binding KindText}" />
				</VerticalStackLayout>

				<!--  Hairline between rows (the last one sits on the card border)  -->
				<BoxView Grid.Row="1" StyleClass="Divider" />

				<Grid.GestureRecognizers>
					<TapGestureRecognizer Tapped="PlaceTapped" />
				</Grid.GestureRecognizers>
			</Grid>
		</DataTemplate>
	</ContentPage.Resources>

	<Grid
		Padding="{DynamicResource PadPage}"
		RowDefinitions="Auto,*"
		RowSpacing="{DynamicResource SpaceM}">

		<!--  The field carries its own frame: the platform underline is gone on purpose  -->
		<Border
			Grid.Row="0"
			Padding="10,0"
			StyleClass="Card">

			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource SpaceS}">

				<controls:Icon
					Glyph="Search"
					Size="19"
					VerticalOptions="Center"
					Color="{DynamicResource InkMuted}" />

				<Entry
					x:Name="QueryEntry"
					Grid.Column="1"
					ClearButtonVisibility="WhileEditing"
					Placeholder="{localization:Tr PlaceSearch.SearchPlaceholder}"
					ReturnType="Search"
					SemanticProperties.Description="{localization:Tr PlaceSearch.SearchForPlace}"
					Text="{Binding Query}" />

				<ActivityIndicator
					Grid.Column="2"
					HeightRequest="20"
					IsRunning="{Binding IsSearching}"
					IsVisible="{Binding IsSearching}"
					VerticalOptions="Center"
					WidthRequest="20" />
			</Grid>
		</Border>

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Spacing="{DynamicResource SpaceM}">

				<Label
					Margin="0,24,0,0"
					HorizontalTextAlignment="Center"
					IsVisible="{Binding HasMessage}"
					StyleClass="Caption"
					Text="{Binding Message}" />

				<Border
					Padding="0"
					IsVisible="{Binding HasResults}"
					StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource PlaceRow}" BindableLayout.ItemsSource="{Binding Results}" />
				</Border>

				<VerticalStackLayout IsVisible="{Binding ShowRecents}" Spacing="{DynamicResource SpaceS}">
					<Label StyleClass="Title" Text="{localization:Tr Plan.Recent}" />
					<Border Padding="0" StyleClass="Card">
						<VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource PlaceRow}" BindableLayout.ItemsSource="{Binding Recents}" />
					</Border>
				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>
	</Grid>

</ContentPage>