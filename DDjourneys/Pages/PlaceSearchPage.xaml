<ContentPage
	x:Class="DDjourneys.Pages.PlaceSearchPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr PlaceSearch.Title}"
	x:DataType="local:PlaceSearchViewModel">

	<ContentPage.Resources>
		<DataTemplate x:Key="PlaceRow" x:DataType="local:PlaceRow">
			<Grid RowDefinitions="Auto,Auto" RowSpacing="0">
				<VerticalStackLayout
					Padding="14,10"
					MinimumHeightRequest="48"
					Spacing="2"
					VerticalOptions="Center">
					<Label
						FontFamily="OpenSansSemibold"
						LineBreakMode="TailTruncation"
						Text="{Binding Name}" />
					<Label
						IsVisible="{Binding HasDetail}"
						LineBreakMode="TailTruncation"
						StyleClass="Caption"
						Text="{Binding Detail}" />
				</VerticalStackLayout>

				<!--  Hairline between rows (the last one sits on the card border)  -->
				<BoxView Grid.Row="1" StyleClass="Divider" />

				<Grid.GestureRecognizers>
					<TapGestureRecognizer Tapped="PlaceTapped" />
				</Grid.GestureRecognizers>
			</Grid>
		</DataTemplate>
	</ContentPage.Resources>

	<Grid
		Padding="{StaticResource PadPage}"
		RowDefinitions="Auto,*"
		RowSpacing="{StaticResource SpaceM}">

		<Grid
			Grid.Row="0"
			ColumnDefinitions="*,Auto"
			ColumnSpacing="{StaticResource SpaceS}">
			<Entry
				x:Name="QueryEntry"
				Grid.Column="0"
				ClearButtonVisibility="WhileEditing"
				Placeholder="{localization:Tr PlaceSearch.SearchPlaceholder}"
				ReturnType="Search"
				SemanticProperties.Description="{localization:Tr PlaceSearch.SearchForPlace}"
				Text="{Binding Query}" />
			<ActivityIndicator
				Grid.Column="1"
				HeightRequest="20"
				IsRunning="{Binding IsSearching}"
				IsVisible="{Binding IsSearching}"
				VerticalOptions="Center"
				WidthRequest="20" />
		</Grid>

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Spacing="{StaticResource SpaceM}">

				<Label
					Margin="0,24,0,0"
					HorizontalTextAlignment="Center"
					IsVisible="{Binding HasMessage}"
					StyleClass="Caption"
					Text="{Binding Message}" />

				<Border
					Padding="0"
					IsVisible="{Binding HasResults}"
					StyleClass="Card">
					<VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource PlaceRow}" BindableLayout.ItemsSource="{Binding Results}" />
				</Border>

				<VerticalStackLayout IsVisible="{Binding ShowRecents}" Spacing="{StaticResource SpaceS}">
					<Label StyleClass="Title" Text="{localization:Tr Plan.Recent}" />
					<Border Padding="0" StyleClass="Card">
						<VerticalStackLayout BindableLayout.ItemTemplate="{StaticResource PlaceRow}" BindableLayout.ItemsSource="{Binding Recents}" />
					</Border>
				</VerticalStackLayout>

			</VerticalStackLayout>
		</ScrollView>
	</Grid>

</ContentPage>