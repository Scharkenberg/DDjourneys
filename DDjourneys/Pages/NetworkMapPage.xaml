<ContentPage
	x:Class="DDjourneys.Pages.NetworkMapPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr Extras.NetworkMap}">

	<Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

		<!--  The title is the page's own (the shell bar says it); this row holds only the tools, at the trailing edge.  -->
		<HorizontalStackLayout
			HorizontalOptions="End"
			support:Dense.Padding="12,4"
			Spacing="4">
			<controls:IconButton
				x:Name="ZoomOutButton"
				Clicked="ZoomOutClicked"
				Glyph="Minus"
				SemanticProperties.Description="{localization:Tr Extras.NetworkMapZoomOut}"
				TargetSize="{StaticResource HitIcon}" />

			<controls:IconButton
				x:Name="ZoomInButton"
				Clicked="ZoomInClicked"
				Glyph="Plus"
				SemanticProperties.Description="{localization:Tr Extras.NetworkMapZoomIn}"
				TargetSize="{StaticResource HitIcon}" />

			<controls:IconButton
				x:Name="RefreshButton"
				Clicked="RefreshClicked"
				Glyph="Refresh"
				SemanticProperties.Description="{localization:Tr Extras.NetworkMapRefresh}"
				TargetSize="{StaticResource HitIcon}" />

			<controls:IconButton
				x:Name="PdfButton"
				Clicked="OpenPdfClicked"
				Glyph="Document"
				SemanticProperties.Description="{localization:Tr Extras.NetworkMapOpenPdf}"
				TargetSize="{StaticResource HitIcon}" />
		</HorizontalStackLayout>

		<!--  The plan stays a light paper in dark mode: it is a print product.  -->
		<Grid Grid.Row="1" BackgroundColor="{DynamicResource Surface}">
			<controls:ZoomImage x:Name="Zoom" Opacity="0" />

			<ActivityIndicator
				x:Name="Busy"
				HeightRequest="32"
				HorizontalOptions="Center"
				IsRunning="True"
				VerticalOptions="Center"
				WidthRequest="32"
				Color="{DynamicResource Accent}" />

			<VerticalStackLayout
				x:Name="Message"
				Padding="24"
				HorizontalOptions="Center"
				IsVisible="false"
				Spacing="{DynamicResource SpaceM}"
				VerticalOptions="Center">
				<Label
					FontFamily="{DynamicResource FontSemibold}"
					HorizontalTextAlignment="Center"
					Text="{localization:Tr Extras.NetworkMapFailed}" />

				<Button
					Clicked="RetryClicked"
					HorizontalOptions="Center"
					StyleClass="Tonal"
					Text="{localization:Tr Common.TryAgain}" />
			</VerticalStackLayout>

			<!--  A saved plan stands in for the current one: said once, calmly, over the corner of the plan.  -->
			<Border
				x:Name="Stale"
				Margin="12"
				Padding="12,6"
				HorizontalOptions="Start"
				IsVisible="false"
				StrokeShape="RoundRectangle 12"
				StyleClass="Card"
				VerticalOptions="Start">
				<Label StyleClass="Caption" Text="{localization:Tr Extras.NetworkMapStale}" />
			</Border>
		</Grid>

		<Label
			Grid.Row="2"
			Margin="12,6,12,10"
			StyleClass="Caption"
			Text="{localization:Tr Extras.NetworkMapCredit}" />
	</Grid>
</ContentPage>
