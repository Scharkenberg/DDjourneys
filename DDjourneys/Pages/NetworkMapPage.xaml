<ContentPage
	x:Class="DDjourneys.Pages.NetworkMapPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr Extras.NetworkMap}">

	<Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

		<Grid
			support:Dense.Padding="12,8"
			ColumnDefinitions="*,Auto,Auto"
			ColumnSpacing="8">
			<Label
				Margin="4,0,0,0"
				FontFamily="{DynamicResource FontSemibold}"
				Text="{localization:Tr Extras.NetworkMap}"
				VerticalOptions="Center" />

			<controls:IconButton
				Grid.Column="1"
				Clicked="RefreshClicked"
				Glyph="Refresh"
				SemanticProperties.Description="{localization:Tr Extras.NetworkMapRefresh}"
				TargetSize="{StaticResource HitButton}" />

			<controls:IconButton
				Grid.Column="2"
				Clicked="OpenPdfClicked"
				Glyph="Document"
				SemanticProperties.Description="{localization:Tr Extras.NetworkMapOpenPdf}"
				TargetSize="{StaticResource HitButton}" />
		</Grid>

		<!--  The plan stays a light paper in dark mode: it is a print product.  -->
		<Grid Grid.Row="1" BackgroundColor="{DynamicResource Surface}">
			<controls:ZoomImage x:Name="Zoom" />

			<VerticalStackLayout
				x:Name="Message"
				Padding="24"
				HorizontalOptions="Center"
				IsVisible="false"
				VerticalOptions="Center">
				<Label
					x:Name="MessageText"
					FontFamily="{DynamicResource FontSemibold}"
					HorizontalTextAlignment="Center"
					Text="{localization:Tr Extras.NetworkMapFailed}" />

			<Button
					x:Name="Retry"
					Clicked="RetryClicked"
					HorizontalOptions="Center"
					IsVisible="false"
					StyleClass="Tonal"
					Text="{localization:Tr Common.TryAgain}" />
			</VerticalStackLayout>

			<Label
				x:Name="Stale"
				Margin="12"
				IsVisible="false"
				StyleClass="Caption"
				Text="{localization:Tr Extras.NetworkMapStale}"
				VerticalOptions="Start" />
		</Grid>

		<Label
			Grid.Row="2"
			Margin="12,6,12,10"
			StyleClass="Caption"
			Text="{localization:Tr Extras.NetworkMapCredit}" />
	</Grid>
</ContentPage>
