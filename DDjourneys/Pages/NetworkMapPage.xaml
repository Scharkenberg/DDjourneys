<ContentPage
	x:Class="DDjourneys.Pages.NetworkMapPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:support="clr-namespace:DDjourneys.Support"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr Extras.NetworkMap}">

	<Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

		<!--  Which plan of the DVB catalog (chips, they scroll when narrow), then the tools at the trailing edge.  -->
		<Grid
			ColumnDefinitions="*,Auto"
			ColumnSpacing="8"
			support:Dense.Padding="12,4">
			<ScrollView HorizontalOptions="Start" Orientation="Horizontal" VerticalOptions="Center">
				<HorizontalStackLayout Padding="0,0,8,0" Spacing="4">
					<Border
						x:Name="PlanStandard"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanStandard}">
						<Label
							x:Name="PlanStandardLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanStandard}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="StandardTapped" />
						</Border.GestureRecognizers>
					</Border>

					<Border
						x:Name="PlanNight"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanNight}">
						<Label
							x:Name="PlanNightLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanNight}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="NightTapped" />
						</Border.GestureRecognizers>
					</Border>

					<Border
						x:Name="PlanBarrierFree"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanBarrierFree}">
						<Label
							x:Name="PlanBarrierFreeLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanBarrierFree}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="BarrierFreeTapped" />
						</Border.GestureRecognizers>
					</Border>

					<Border
						x:Name="PlanCityMap"
						StyleClass="ChipButton"
						support:Themed.Background="Clear"
						support:Themed.OnBackground="Accent"
						SemanticProperties.Description="{localization:Tr Extras.NetworkMapPlanCityMap}">
						<Label
							x:Name="PlanCityMapLabel"
							FontFamily="{DynamicResource FontSemibold}"
							Text="{localization:Tr Extras.NetworkMapPlanCityMap}"
							support:Themed.OnText="OnAccent"
							support:Themed.Text="Ink" />
						<Border.GestureRecognizers>
							<TapGestureRecognizer Tapped="CityTapped" />
						</Border.GestureRecognizers>
					</Border>
				</HorizontalStackLayout>
			</ScrollView>

			<HorizontalStackLayout
				Grid.Column="1"
				HorizontalOptions="End"
				Spacing="4"
				VerticalOptions="Center">
				<controls:IconButton
					x:Name="ZoomOutButton"
					Clicked="ZoomOutClicked"
					Glyph="Minus"
					IsEnabled="False"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapZoomOut}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="ZoomInButton"
					Clicked="ZoomInClicked"
					Glyph="Plus"
					IsEnabled="False"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapZoomIn}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="RefreshButton"
					Clicked="RefreshClicked"
					Glyph="Refresh"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapRefresh}"
					TargetSize="{StaticResource HitIcon}" />

				<controls:IconButton
					x:Name="PdfButton"
					Clicked="OpenPdfClicked"
					Glyph="Document"
					SemanticProperties.Description="{localization:Tr Extras.NetworkMapOpenPdf}"
					TargetSize="{StaticResource HitIcon}" />
			</HorizontalStackLayout>
		</Grid>

		<!--  The plan stays a light paper in dark mode: it is a print product (plan.html only dims it a little).  -->
		<Grid Grid.Row="1" BackgroundColor="{DynamicResource Bg}">
			<controls:PlanView
				x:Name="Plan"
				Opacity="0"
				Shown="PlanShown"
				ZoomChanged="PlanZoomChanged"
				PlanLost="ReloadPlan" />

			<ActivityIndicator
				x:Name="Busy"
				HeightRequest="32"
				HorizontalOptions="Center"
				IsRunning="True"
				VerticalOptions="Center"
				WidthRequest="32"
				Color="{DynamicResource Accent}" />

			<VerticalStackLayout
				x:Name="Message"
				Padding="24"
				HorizontalOptions="Center"
				IsVisible="false"
				Spacing="{DynamicResource SpaceM}"
				VerticalOptions="Center">
				<Label
					FontFamily="{DynamicResource FontSemibold}"
					HorizontalTextAlignment="Center"
					Text="{localization:Tr Extras.NetworkMapFailed}" />

				<Button
					Clicked="RetryClicked"
					HorizontalOptions="Center"
					StyleClass="Tonal"
					Text="{localization:Tr Common.TryAgain}" />
			</VerticalStackLayout>

			<!--  A saved plan stands in for the current one: said once, calmly, over the corner of the plan.  -->
			<Border
				x:Name="Stale"
				Margin="12"
				Padding="12,6"
				HorizontalOptions="Start"
				InputTransparent="True"
				IsVisible="false"
				StrokeShape="RoundRectangle 12"
				StyleClass="Card"
				VerticalOptions="Start">
				<Label StyleClass="Caption" Text="{localization:Tr Extras.NetworkMapStale}" />
			</Border>
		</Grid>

		<Label
			Grid.Row="2"
			Margin="12,6,12,10"
			StyleClass="Caption"
			Text="{localization:Tr Extras.NetworkMapCredit}" />
	</Grid>
</ContentPage>
