<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="DDjourneys.Pages.ThemesPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	Title="{localization:Tr Settings.ThemesTitle}"
	x:DataType="local:ThemesViewModel">

	<ScrollView>
		<VerticalStackLayout Padding="{StaticResource PadPage}" Spacing="{StaticResource SpaceS}">

			<Label StyleClass="Section" Text="{localization:Tr Settings.ThemesLightHeader}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding LightThemes}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="local:ThemeOption">
							<VerticalStackLayout>
								<Grid
									Padding="12,8"
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="12"
									MinimumHeightRequest="52"
									SemanticProperties.Description="{Binding Name}">

									<!--  Swatch: background, raised panel, accent and ink bars  -->
									<Border
										Padding="4"
										BackgroundColor="{Binding Bg}"
										HeightRequest="32"
										Stroke="{Binding Outline}"
										StrokeShape="RoundRectangle 4"
										StrokeThickness="1"
										VerticalOptions="Center"
										WidthRequest="48">
										<Grid ColumnDefinitions="*,*" ColumnSpacing="3">
											<BoxView CornerRadius="2" Color="{Binding Raised}" />
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="3"
												VerticalOptions="Center">
												<BoxView
													CornerRadius="2"
													HeightRequest="6"
													Color="{Binding Accent}" />
												<BoxView
													CornerRadius="2"
													HeightRequest="4"
													Color="{Binding Ink}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
										<Label StyleClass="Caption" Text="{Binding Description}" />
									</VerticalStackLayout>

									<Label
										Grid.Column="2"
										FontSize="20"
										IsVisible="{Binding IsSelected}"
										Text="&#x2713;"
										TextColor="{DynamicResource Accent}"
										VerticalOptions="Center" />

									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:ThemesViewModel}}, Path=SelectThemeCommand}" CommandParameter="{Binding Id}" />
									</Grid.GestureRecognizers>
								</Grid>

								<BoxView StyleClass="Divider" />
							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</Border>

			<Label
				Margin="{StaticResource SectionGap}"
				StyleClass="Section"
				Text="{localization:Tr Settings.ThemesDarkHeader}" />

			<Border Padding="0" StyleClass="Card">
				<VerticalStackLayout BindableLayout.ItemsSource="{Binding DarkThemes}">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="local:ThemeOption">
							<VerticalStackLayout>
								<Grid
									Padding="12,8"
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="12"
									MinimumHeightRequest="52"
									SemanticProperties.Description="{Binding Name}">

									<!--  Swatch: background, raised panel, accent and ink bars  -->
									<Border
										Padding="4"
										BackgroundColor="{Binding Bg}"
										HeightRequest="32"
										Stroke="{Binding Outline}"
										StrokeShape="RoundRectangle 4"
										StrokeThickness="1"
										VerticalOptions="Center"
										WidthRequest="48">
										<Grid ColumnDefinitions="*,*" ColumnSpacing="3">
											<BoxView CornerRadius="2" Color="{Binding Raised}" />
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="3"
												VerticalOptions="Center">
												<BoxView
													CornerRadius="2"
													HeightRequest="6"
													Color="{Binding Accent}" />
												<BoxView
													CornerRadius="2"
													HeightRequest="4"
													Color="{Binding Ink}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label FontFamily="OpenSansSemibold" Text="{Binding Name}" />
										<Label StyleClass="Caption" Text="{Binding Description}" />
									</VerticalStackLayout>

									<Label
										Grid.Column="2"
										FontSize="20"
										IsVisible="{Binding IsSelected}"
										Text="&#x2713;"
										TextColor="{DynamicResource Accent}"
										VerticalOptions="Center" />

									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:ThemesViewModel}}, Path=SelectThemeCommand}" CommandParameter="{Binding Id}" />
									</Grid.GestureRecognizers>
								</Grid>

								<BoxView StyleClass="Divider" />
							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
