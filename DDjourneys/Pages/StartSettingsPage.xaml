<ContentPage
	x:Class="DDjourneys.Pages.StartSettingsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:DDjourneys.Controls"
	xmlns:local="clr-namespace:DDjourneys.Pages"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:support="clr-namespace:DDjourneys.Support"
	Title="{localization:Tr Settings.StartTitle}"
	x:DataType="local:StartSettingsViewModel">

	<ScrollView>
		<VerticalStackLayout Padding="{DynamicResource PadPage}" Spacing="{DynamicResource SpaceS}">

			<Border Padding="0" StyleClass="Card">
				<Grid
					support:Dense.Padding="12,8"
					ColumnDefinitions="*,Auto"
					ColumnSpacing="12"
					support:Dense.MinHeight="52">

					<VerticalStackLayout Spacing="1" VerticalOptions="Center">
						<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.StartInputMode}" />
						<Label StyleClass="Caption" Text="{localization:Tr Settings.StartInputModeDescription}" />
					</VerticalStackLayout>

					<Switch
						Grid.Column="1"
						IsToggled="{Binding InputMode}"
						SemanticProperties.Description="{localization:Tr Settings.StartInputMode}"
						VerticalOptions="Center" />
				</Grid>
			</Border>

			<Label
				IsVisible="{Binding InputMode}"
				StyleClass="Section"
				Text="{localization:Tr Settings.StartFromTitle}" />

			<Border
				Padding="0"
				IsVisible="{Binding InputMode}"
				StyleClass="Card">
				<VerticalStackLayout>

					<!--  The device position  -->
					<Grid
						support:Dense.Padding="12,10"
						ColumnDefinitions="*,Auto"
						support:Dense.MinHeight="56"
						support:Motion.Feedback="True">
						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.StartFromLocation}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.StartFromLocationDescription}" />
						</VerticalStackLayout>
						<controls:Icon
							Grid.Column="1"
							Glyph="Check"
							IsVisible="{Binding UseLocation}"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding SelectLocationCommand}" />
						</Grid.GestureRecognizers>
					</Grid>

					<BoxView StyleClass="Divider" />

					<!--  A chosen stop, point of interest or address  -->
					<Grid
						support:Dense.Padding="12,10"
						ColumnDefinitions="*,Auto"
						support:Dense.MinHeight="56"
						support:Motion.Feedback="True">
						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label FontFamily="{DynamicResource FontSemibold}" Text="{localization:Tr Settings.StartFromPlace}" />
							<Label StyleClass="Caption" Text="{localization:Tr Settings.StartFromPlaceDescription}" />
						</VerticalStackLayout>
						<controls:Icon
							Grid.Column="1"
							Glyph="Check"
							IsVisible="{Binding UsePlace}"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource Accent}" />
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding SelectPlaceCommand}" />
						</Grid.GestureRecognizers>
					</Grid>

					<BoxView IsVisible="{Binding UsePlace}" StyleClass="Divider" />

					<Grid
						support:Dense.Padding="12,10"
						ColumnDefinitions="*,Auto"
						ColumnSpacing="10"
						IsVisible="{Binding UsePlace}"
						support:Dense.MinHeight="56"
						support:Motion.Feedback="True"
						SemanticProperties.Description="{Binding PlaceName}">
						<VerticalStackLayout Spacing="1" VerticalOptions="Center">
							<Label
								FontFamily="{DynamicResource FontSemibold}"
								LineBreakMode="TailTruncation"
								Text="{Binding PlaceName}"
								TextColor="{DynamicResource Accent}" />
							<Label
								IsVisible="{Binding HasPlaceDetail}"
								StyleClass="Caption"
								Text="{Binding PlaceDetail}" />
						</VerticalStackLayout>
						<controls:Icon
							Grid.Column="1"
							Glyph="ChevronRight"
							Size="20"
							VerticalOptions="Center"
							Color="{DynamicResource InkMuted}" />
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding PickPlaceCommand}" />
						</Grid.GestureRecognizers>
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Label
				IsVisible="{Binding InputMode}"
				StyleClass="Caption"
				Text="{localization:Tr Settings.StartPlaceHint}" />

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
