<Shell
	x:Class="DDjourneys.AppShell"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:localization="clr-namespace:DDjourneys.Localization"
	xmlns:pages="clr-namespace:DDjourneys.Pages"
	Title="DDjourneys"
	FlyoutBehavior="Disabled">

	<!--  The phone: four tabs. The constructor removes the door below; a tab's page is built only when the tab is first opened.  -->
	<TabBar x:Name="PhoneTabs">
		<Tab Route="plan" Title="{localization:Tr Shell.TabPlan}">
			<ShellContent ContentTemplate="{DataTemplate pages:PlanPage}" />
		</Tab>
		<Tab Route="departures" Title="{localization:Tr Departures.Title}">
			<ShellContent ContentTemplate="{DataTemplate pages:DeparturesPage}" />
		</Tab>
		<Tab x:Name="MapTab" Route="map" Title="{localization:Tr Extras.MapTitle}">
			<ShellContent ContentTemplate="{DataTemplate pages:MapPage}" />
		</Tab>
		<Tab Route="more" Title="{localization:Tr Shell.TabMore}">
			<ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" />
		</Tab>
	</TabBar>

	<!--  Every other form factor: the single door, the planner (the constructor removes the tab bar there).  -->
	<ShellItem x:Name="SingleDoor">
		<ShellContent ContentTemplate="{DataTemplate pages:PlanPage}" Route="plan" />
	</ShellItem>

</Shell>