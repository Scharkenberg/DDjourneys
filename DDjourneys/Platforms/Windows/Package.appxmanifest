<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap rescap com desktop uap3">

  <Identity Name="maui-package-name-placeholder" Publisher="CN=User Name" Version="0.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="93BDB5A7-2313-439D-A00A-E54D4EAE85C9" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
	<DisplayName>$placeholder$</DisplayName>
	<PublisherDisplayName>User Name</PublisherDisplayName>
	<Logo>$placeholder$.png</Logo>
  </Properties>

  <Dependencies>
	<TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
	<TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
	<Resource Language="x-generate" />
  </Resources>

  <Applications>
	<Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
	  <uap:VisualElements
        DisplayName="$placeholder$"
        Description="$placeholder$"
        Square150x150Logo="$placeholder$.png"
        Square44x44Logo="$placeholder$.png"
        BackgroundColor="transparent">
		<uap:DefaultTile Square71x71Logo="$placeholder$.png" Wide310x150Logo="$placeholder$.png" Square310x310Logo="$placeholder$.png" />
		<uap:SplashScreen Image="$placeholder$.png" />
	  </uap:VisualElements>
	  <Extensions>
		<!-- External contract: ddjourneys://plan?... (docs/EXTERNAL_CONTRACT.md) -->
		<uap:Extension Category="windows.protocol">
		  <uap:Protocol Name="ddjourneys">
			<uap:DisplayName>DDjourneys</uap:DisplayName>
		  </uap:Protocol>
		</uap:Extension>

		<!-- App notification activation (live journey buttons and taps). The CLSID is arbitrary but must match below. -->
		<desktop:Extension Category="windows.toastNotificationActivation">
		  <desktop:ToastNotificationActivation ToastActivatorCLSID="D4C0A5A2-6B1E-4F0A-9C3B-7E2D8A1F5B63" />
		</desktop:Extension>

		<com:Extension Category="windows.comServer">
		  <com:ComServer>
			<com:ExeServer Executable="DDjourneys.exe" DisplayName="DDjourneys" Arguments="----AppNotificationActivated:">
			  <com:Class Id="D4C0A5A2-6B1E-4F0A-9C3B-7E2D8A1F5B63" />
			  <!-- The Windows Widgets Board CoCreates this one (the same value as WindowsWidgets.ProviderClassId). -->
			  <com:Class Id="8F1D5A53-2A1F-4B0B-B5E1-1D2A6C90F3D7" DisplayName="DDjourneys widget provider" />
			</com:ExeServer>
		  </com:ComServer>
		</com:Extension>

		<!-- The widget provider registration (verified against "Widget provider package manifest XML format"):
		     a uap3 AppExtension with the Widgets Board's name; the activation is CreateInstance (COM, the
		     recommended type); pinning happens in the board's picker - there is no pin API. -->
		<uap3:Extension Category="windows.appExtension">
		  <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="DDjourneys" Id="DdWidgets" PublicFolder="Assets\\Widgets">
			<uap3:Properties>
			  <WidgetProvider>
				<ProviderIcons>
				  <Icon Path="Assets\\Widgets\\provider.png" />
				</ProviderIcons>
				<Activation>
				  <CreateInstance ClassId="8F1D5A53-2A1F-4B0B-B5E1-1D2A6C90F3D7" />
				</Activation>
				<Definitions>
				  <Definition Id="Departures_Widget" DisplayName="DDjourneys · Departures" Description="The departures of a stop, live" AllowMultiple="true">
					<Capabilities>
					  <Capability>
						<Size Name="small" />
					  </Capability>
					  <Capability>
						<Size Name="medium" />
					  </Capability>
				</Capabilities>
					<ThemeResources>
					  <Icons>
						<Icon Path="Assets\\Widgets\\departures.png" />
					  </Icons>
					  <Screenshots>
						<Screenshot Path="Assets\\Widgets\\departures.png" DisplayAltText="The departures of a stop" />
					  </Screenshots>
					  <DarkMode>
						<Screenshots>
						  <Screenshot Path="Assets\\Widgets\\departures.png" DisplayAltText="The departures of a stop" />
						</Screenshots>
					  </DarkMode>
					  <LightMode />
					</ThemeResources>
				  </Definition>
				  <Definition Id="Route_Widget" DisplayName="DDjourneys · Route" Description="The next journeys of a saved route" AllowMultiple="true">
					<Capabilities>
					  <Capability>
						<Size Name="small" />
					  </Capability>
					  <Capability>
						<Size Name="medium" />
					  </Capability>
					</Capabilities>
					<ThemeResources>
					  <Icons>
						<Icon Path="Assets\\Widgets\\route.png" />
					  </Icons>
					  <Screenshots>
						<Screenshot Path="Assets\\Widgets\\route.png" DisplayAltText="The next journeys of a route" />
					  </Screenshots>
					  <DarkMode>
						<Screenshots>
						  <Screenshot Path="Assets\\Widgets\\route.png" DisplayAltText="The next journeys of a route" />
						</Screenshots>
					  </DarkMode>
					  <LightMode />
					</ThemeResources>
				  </Definition>
				</Definitions>
			  </WidgetProvider>
			</uap3:Properties>
		  </uap3:AppExtension>
		</uap3:Extension>
	  </Extensions>
	</Application>
  </Applications>

  <Capabilities>
	<rescap:Capability Name="runFullTrust" />
	<DeviceCapability Name="location" />
  </Capabilities>

</Package>