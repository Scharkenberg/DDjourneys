<ResourceDictionary
	x:Class="DDjourneys.ThemeLight"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
	<!--  Light theme. Keys must match the other theme files.  -->
	<Color x:Key="Bg">#F2F4F5</Color>
	<Color x:Key="Surface">#FFFFFF</Color>
	<Color x:Key="Raised">#DFE6E9</Color>
	<Color x:Key="Outline">#B4C1C7</Color>
	<Color x:Key="Ink">#0F1A1F</Color>
	<Color x:Key="InkMuted">#4A5960</Color>
	<Color x:Key="Accent">#0B6E8A</Color>
	<Color x:Key="OnAccent">#FFFFFF</Color>
	<Color x:Key="AccentSoft">#D3E9F0</Color>
	<Color x:Key="OnTime">#15803D</Color>
	<Color x:Key="Delay">#9A5B00</Color>
	<Color x:Key="Cancelled">#B91C1C</Color>
</ResourceDictionary>
