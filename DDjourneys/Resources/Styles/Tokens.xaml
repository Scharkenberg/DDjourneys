<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary>

	<!-- Theme colours live in Theme*.xaml and are swapped at runtime by Theme.cs -->

	<!-- Mode chips (generic per mode, not official line colours). White text. -->
	<Color x:Key="ModeTram">#B3261E</Color>
	<Color x:Key="ModeBus">#6B3FA0</Color>
	<Color x:Key="ModeSuburban">#1F7A4D</Color>
	<Color x:Key="ModeTrain">#4B5B66</Color>
	<Color x:Key="ModeFerry">#1D5FA8</Color>
	<Color x:Key="ModeCableCar">#8A5A00</Color>
	<Color x:Key="ModeWalk">#5B6B74</Color>

	<!-- Spacing: 4-pt grid, tighter than before -->
	<x:Double x:Key="SpaceXS">4</x:Double>
	<x:Double x:Key="SpaceS">8</x:Double>
	<x:Double x:Key="SpaceM">12</x:Double>
	<x:Double x:Key="SpaceL">16</x:Double>
	<x:Double x:Key="SpaceXL">24</x:Double>
	<Thickness x:Key="SectionGap">0,8,0,0</Thickness>
	<Thickness x:Key="PadCard">14</Thickness>
	<Thickness x:Key="PadPage">16,12</Thickness>
	<!-- Native controls (pickers, entries) get generous padding: their own chrome differs per platform -->
	<Thickness x:Key="PadField">14,8</Thickness>

	<!-- Radii: sharp. Pills are reserved for non-interactive elements. -->
	<x:Double x:Key="RadiusControl">4</x:Double>
	<x:Double x:Key="RadiusCard">6</x:Double>
	<x:Double x:Key="RadiusSheet">8</x:Double>
	<CornerRadius x:Key="CornerControl">4</CornerRadius>

	<!-- Type scale (Major-second-ish, compact) -->
	<x:Double x:Key="FontMicro">12</x:Double>
	<x:Double x:Key="FontCaption">14</x:Double>
	<x:Double x:Key="FontBody">16</x:Double>
	<x:Double x:Key="FontSubtitle">18</x:Double>
	<x:Double x:Key="FontTitle">24</x:Double>
	<x:Double x:Key="FontHeadline">28</x:Double>
	<x:Double x:Key="FontTime">28</x:Double>

	<!-- Motion (ms) -->
	<x:Int32 x:Key="MotionFast">120</x:Int32>
	<x:Int32 x:Key="MotionBase">220</x:Int32>
	<x:Int32 x:Key="MotionSlow">360</x:Int32>

	<!--  Transparent as a resource key, for support:Themed  -->
	<Color x:Key="Clear">Transparent</Color>
</ResourceDictionary>
