<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:support="clr-namespace:DDjourneys.Support">

	<Style ApplyToDerivedTypes="True" TargetType="Page">
		<Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
	</Style>

	<Style ApplyToDerivedTypes="True" TargetType="Shell">
		<Setter Property="Shell.BackgroundColor" Value="{DynamicResource Bg}" />
		<Setter Property="Shell.ForegroundColor" Value="{DynamicResource Accent}" />
		<Setter Property="Shell.TitleColor" Value="{DynamicResource Ink}" />
		<Setter Property="Shell.NavBarHasShadow" Value="False" />
	</Style>

	<!--  Text. Classes: Headline, Title, Time, Caption, OnTime, Delay, Cancelled  -->
	<Style TargetType="Label">
		<Setter Property="TextColor" Value="{DynamicResource Ink}" />
		<Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<!--  Motion (Motion.cs): shown later = rises in; Pulse (below) = a changed value ticks over  -->
		<Setter Property="support:Motion.OnShow" Value="True" />
	</Style>
	<Style Class="Headline" TargetType="Label">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontHeadline}" />
	</Style>
	<Style Class="Title" TargetType="Label">
		<Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontTitle}" />
	</Style>
	<Style Class="Time" TargetType="Label">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontTime}" />
		<Setter Property="support:Motion.Pulse" Value="True" />
	</Style>
	<Style Class="Caption" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
	</Style>
	<!--  Secondary detail under a name (city, region): smaller than Caption, same accessible colour  -->
	<Style Class="Faint" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource FontMicro}" />
		<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
	</Style>
	<Style Class="OnTime" TargetType="Label">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource OnTime}" />
		<Setter Property="support:Motion.Pulse" Value="True" />
	</Style>
	<Style Class="Delay" TargetType="Label">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource Delay}" />
		<Setter Property="support:Motion.Pulse" Value="True" />
	</Style>
	<Style Class="Cancelled" TargetType="Label">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource Cancelled}" />
	</Style>

	<!--  Surfaces. Classes: Card (16), Chip (pill). Tone and outline, no shadows.  -->
	<Style Class="Card" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
		<Setter Property="Stroke" Value="{DynamicResource OutlineBrush}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="Padding" Value="{DynamicResource PadCard}" />
		<Setter Property="support:Motion.Enter" Value="Rise" />
		<Setter Property="support:Motion.OnShow" Value="True" />
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style TargetType="Grid">
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style TargetType="ContentView">
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style TargetType="VerticalStackLayout">
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style TargetType="HorizontalStackLayout">
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style TargetType="FlexLayout">
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style TargetType="StackLayout">
		<Setter Property="support:PointerLight.Enabled" Value="True" />
	</Style>
	<Style Class="Chip" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{DynamicResource Raised}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 100" />
		<!--  Generous horizontal padding: Android measures the semibold font a hair too narrow  -->
		<Setter Property="support:Dense.Padding" Value="12,4" />
		<Setter Property="support:Dense.MinHeight" Value="28" />
		<!--  A long text scrolls inside the pill (support:PillScroll, which also sizes and reveals the pill)  -->
	</Style>
	<!--  Pill text must never wrap or truncate ("Walk 20 min" -> "Walk 20")  -->
	<Style Class="ChipLabel" TargetType="Label">
		<Setter Property="LineBreakMode" Value="NoWrap" />
		<Setter Property="MaxLines" Value="1" />
		<Setter Property="HorizontalOptions" Value="Center" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="HorizontalTextAlignment" Value="Center" />
	</Style>

	<!--  Buttons. Default filled; class Tonal for secondary actions.  -->
	<!--
		Colours go through support:Themed (local dynamic resources); see Themed.cs for why
		DynamicResource setters must not be used in VisualStates or Triggers here.
	-->
	<Style TargetType="Button">
		<Setter Property="support:Themed.Background" Value="Accent" />
		<Setter Property="support:Themed.Text" Value="OnAccent" />
		<Setter Property="support:Themed.DisabledBackground" Value="Raised" />
		<Setter Property="support:Themed.DisabledText" Value="InkMuted" />
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="BorderWidth" Value="0" />
		<Setter Property="BorderColor" Value="Transparent" />
		<Setter Property="support:Dense.MinHeight" Value="{StaticResource HitPrimary}" />
		<Setter Property="Padding" Value="16,0" />
		<Setter Property="support:Motion.Enter" Value="Zoom" />
		<Setter Property="support:Motion.OnShow" Value="True" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<!--  Mouse hover: slightly lighter (opacity only; colours stay with Themed, nothing moves)  -->
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Property="Opacity" Value="0.86" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="Scale" Value="0.97" />
						</VisualState.Setters>
					</VisualState>
					<!--  Disabled colours: Themed.Disabled* (explicit colours; opacity would wash the label out)  -->
					<VisualState x:Name="Disabled" />
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>
	<Style Class="IconButton" TargetType="Button">
		<Setter Property="support:Themed.Background" Value="Clear" />
		<Setter Property="support:Themed.Text" Value="Accent" />
		<Setter Property="support:Themed.DisabledBackground" Value="Clear" />
		<Setter Property="support:Themed.DisabledText" Value="InkMuted" />
		<Setter Property="FontSize" Value="22" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="support:Dense.MinHeight" Value="{StaticResource HitIcon}" />
		<Setter Property="support:Dense.MinWidth" Value="{StaticResource HitIcon}" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Property="Opacity" Value="0.7" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="Scale" Value="0.94" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled" />
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>
	<Style Class="Tonal" TargetType="Button">
		<Setter Property="support:Themed.Background" Value="AccentSoft" />
		<Setter Property="support:Themed.Text" Value="Accent" />
	</Style>


	<!--  Tappable chip: NOT a pill (interactive)  -->
	<Style Class="ChipButton" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{DynamicResource Raised}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 4" />
		<Setter Property="support:Dense.Padding" Value="12,8" />
		<Setter Property="support:Motion.Enter" Value="Zoom" />
	</Style>
	<!--  Row container: no border; hairline divider is a separate BoxView  -->
	<Style Class="Divider" TargetType="BoxView">
		<Setter Property="HeightRequest" Value="1" />
		<Setter Property="Color" Value="{DynamicResource Outline}" />
		<Setter Property="support:Motion.Enter" Value="Grow" />
	</Style>
	<Style Class="Section" TargetType="Label">
		<Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource Accent}" />
		<Setter Property="CharacterSpacing" Value="0.5" />
		<Setter Property="TextTransform" Value="Uppercase" />
		<Setter Property="Margin" Value="4,8,0,0" />
		<Setter Property="support:Motion.Enter" Value="Fade" />
	</Style>
	<Style Class="Subtitle" TargetType="Label">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontSubtitle}" />
	</Style>

	<!--  Native controls: themed, never wrapped in tight borders  -->
	<Style TargetType="DatePicker">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>
	<Style TargetType="TimePicker">
		<Setter Property="FontFamily" Value="{DynamicResource FontSemibold}" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>
	<Style TargetType="Picker">
		<Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>
	<!--  Native controls take their colours from support:NativeTheme (see there); thumb contrasts with the track in both states  -->
	<Style TargetType="Switch">
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>
	<Style TargetType="Slider">
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>
	<Style TargetType="Stepper">
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>

	<Style TargetType="Entry">
		<Setter Property="FontFamily" Value="{DynamicResource FontRegular}" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>

	<Style TargetType="ActivityIndicator">
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>

	<Style TargetType="RefreshView">
		<Setter Property="support:NativeTheme.Follow" Value="True" />
	</Style>

</ResourceDictionary>
