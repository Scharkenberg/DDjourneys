<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style TargetType="Page" ApplyToDerivedTypes="True">
		<Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
	</Style>

	<Style TargetType="Shell" ApplyToDerivedTypes="True">
		<Setter Property="Shell.BackgroundColor" Value="{DynamicResource Bg}" />
		<Setter Property="Shell.ForegroundColor" Value="{DynamicResource Accent}" />
		<Setter Property="Shell.TitleColor" Value="{DynamicResource Ink}" />
		<Setter Property="Shell.NavBarHasShadow" Value="False" />
	</Style>

	<!-- Text. Classes: Headline, Title, Time, Caption, OnTime, Delay, Cancelled -->
	<Style TargetType="Label">
		<Setter Property="TextColor" Value="{DynamicResource Ink}" />
		<Setter Property="FontFamily" Value="OpenSansRegular" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
	</Style>
	<Style TargetType="Label" Class="Headline">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontHeadline}" />
	</Style>
	<Style TargetType="Label" Class="Title">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontTitle}" />
	</Style>
	<Style TargetType="Label" Class="Time">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontTime}" />
	</Style>
	<Style TargetType="Label" Class="Caption">
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
	</Style>
	<!-- Secondary detail under a name (city, region): smaller than Caption, same accessible colour -->
	<Style TargetType="Label" Class="Faint">
		<Setter Property="FontSize" Value="{StaticResource FontMicro}" />
		<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
	</Style>
	<Style TargetType="Label" Class="OnTime">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource OnTime}" />
	</Style>
	<Style TargetType="Label" Class="Delay">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource Delay}" />
	</Style>
	<Style TargetType="Label" Class="Cancelled">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource Cancelled}" />
	</Style>

	<!-- Surfaces. Classes: Card (16), Chip (pill). Tone and outline, no shadows. -->
	<Style TargetType="Border" Class="Card">
		<Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
		<Setter Property="Stroke" Value="{DynamicResource OutlineBrush}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="Padding" Value="{StaticResource PadCard}" />
	</Style>
	<Style TargetType="Border" Class="Chip">
		<Setter Property="BackgroundColor" Value="{DynamicResource Raised}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 100" />
		<!-- Generous horizontal padding: Android measures the semibold font a hair too narrow -->
		<Setter Property="Padding" Value="12,4" />
		<Setter Property="MinimumHeightRequest" Value="28" />
	</Style>
	<!-- Pill text must never wrap or truncate ("Walk 20 min" -> "Walk 20") -->
	<Style TargetType="Label" Class="ChipLabel">
		<Setter Property="LineBreakMode" Value="NoWrap" />
		<Setter Property="MaxLines" Value="1" />
		<Setter Property="HorizontalOptions" Value="Center" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="HorizontalTextAlignment" Value="Center" />
	</Style>

	<!-- Buttons. Default filled; class Tonal for secondary actions. -->
	<Style TargetType="Button">
		<Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
		<Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="BorderWidth" Value="0" />
		<Setter Property="BorderColor" Value="Transparent" />
		<Setter Property="MinimumHeightRequest" Value="48" />
		<Setter Property="Padding" Value="16,0" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="Scale" Value="0.97" />
						</VisualState.Setters>
					</VisualState>
					<!-- Explicit colours: opacity would wash the label out to unreadable -->
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{DynamicResource Raised}" />
							<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>
	<Style TargetType="Button" Class="IconButton">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{DynamicResource Accent}" />
		<Setter Property="FontSize" Value="22" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="MinimumHeightRequest" Value="44" />
		<Setter Property="MinimumWidthRequest" Value="44" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal" />
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Disabled">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="Transparent" />
							<Setter Property="TextColor" Value="{DynamicResource InkMuted}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>
	<Style TargetType="Button" Class="Tonal">
		<Setter Property="BackgroundColor" Value="{DynamicResource AccentSoft}" />
		<Setter Property="TextColor" Value="{DynamicResource Accent}" />
	</Style>


	<!-- Tappable chip: NOT a pill (interactive) -->
	<Style TargetType="Border" Class="ChipButton">
		<Setter Property="BackgroundColor" Value="{DynamicResource Raised}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 4" />
		<Setter Property="Padding" Value="12,8" />
	</Style>
	<!-- Row container: no border; hairline divider is a separate BoxView -->
	<Style TargetType="BoxView" Class="Divider">
		<Setter Property="HeightRequest" Value="1" />
		<Setter Property="Color" Value="{DynamicResource Outline}" />
	</Style>
	<Style TargetType="Label" Class="Section">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontCaption}" />
		<Setter Property="TextColor" Value="{DynamicResource Accent}" />
		<Setter Property="CharacterSpacing" Value="0.5" />
		<Setter Property="TextTransform" Value="Uppercase" />
		<Setter Property="Margin" Value="4,8,0,0" />
	</Style>
	<Style TargetType="Label" Class="Subtitle">
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontSubtitle}" />
	</Style>

	<!-- Native controls: themed, never wrapped in tight borders -->
	<Style TargetType="DatePicker">
		<Setter Property="TextColor" Value="{DynamicResource Ink}" />
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
	</Style>
	<Style TargetType="TimePicker">
		<Setter Property="TextColor" Value="{DynamicResource Ink}" />
		<Setter Property="FontFamily" Value="OpenSansSemibold" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
	</Style>
	<Style TargetType="Picker">
		<Setter Property="TextColor" Value="{DynamicResource Ink}" />
		<Setter Property="TitleColor" Value="{DynamicResource InkMuted}" />
		<Setter Property="FontFamily" Value="OpenSansRegular" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
	</Style>
	<!-- Thumb contrasts with the track in both states (a dark thumb on the accent track was hard to see) -->
	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="{DynamicResource Accent}" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="On">
						<VisualState.Setters>
							<Setter Property="ThumbColor" Value="{DynamicResource OnAccent}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Off">
						<VisualState.Setters>
							<Setter Property="ThumbColor" Value="{DynamicResource InkMuted}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>
	<Style TargetType="Slider">
		<Setter Property="MinimumTrackColor" Value="{DynamicResource Accent}" />
		<Setter Property="MaximumTrackColor" Value="{DynamicResource Outline}" />
		<Setter Property="ThumbColor" Value="{DynamicResource Accent}" />
	</Style>
	<Style TargetType="Stepper">
		<Setter Property="BackgroundColor" Value="{DynamicResource Raised}" />
	</Style>

	<Style TargetType="Entry">
		<Setter Property="TextColor" Value="{DynamicResource Ink}" />
		<Setter Property="PlaceholderColor" Value="{DynamicResource InkMuted}" />
		<Setter Property="FontFamily" Value="OpenSansRegular" />
		<Setter Property="FontSize" Value="{StaticResource FontBody}" />
	</Style>

	<Style TargetType="ActivityIndicator">
		<Setter Property="Color" Value="{DynamicResource Accent}" />
	</Style>

	<Style TargetType="RefreshView">
		<Setter Property="RefreshColor" Value="{DynamicResource Accent}" />
	</Style>

</ResourceDictionary>
